#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

SETUP_MODE="full"
for arg in "$@"; do
  case "$arg" in
    --launcher-only|--proxy-only)
      SETUP_MODE="launcher-only"
      ;;
    --local-only)
      SETUP_MODE="local-only"
      ;;
    -h|--help)
      cat <<'EOF'
Usage: ./scripts/setup [--launcher-only | --proxy-only | --local-only]

Modes:
  (default)        Full evaluation workbench: Python .venv (requirements.txt, 71 packages),
                   Node promptfoo (npm ci), bin/se-key-proxy, and bin/tinfoil-proxy.
  --launcher-only  Minimal Rung 3 attested-proxy launcher setup: stdlib Python >= 3.11,
  (--proxy-only)   bin/se-key-proxy, and bin/tinfoil-proxy. Zero Python or Node packages.
  --local-only     Rung 1 local MLX + Rung 3 attested-proxy setup: Python .venv
                   (requirements-local.txt, 35 packages), bin/se-key-proxy, and
                   bin/tinfoil-proxy. Skips Node/npm and multimodal/vision packages.
EOF
      exit 0
      ;;
    *)
      echo "ERROR: Unknown argument '$arg'. Run ./scripts/setup --help for usage." >&2
      exit 1
      ;;
  esac
done

export UV_CACHE_DIR="$PWD/.uv-cache"
export PYTHONPYCACHEPREFIX="$PWD/.pycache"

echo "Checking platform and base tools (mode: ${SETUP_MODE})..."
if [ "$(uname -s)" != "Darwin" ] || [ "$(uname -m)" != "arm64" ]; then
  echo "ERROR: free-inference setup requires Apple Silicon macOS (Darwin arm64); got $(uname -s) $(uname -m)" >&2
  exit 1
fi
mkdir -p .home/.cache .home/.promptfoo .home/huggingface

BASE_TOOLS=(python3 swiftc codesign shasum curl unzip lsof ps pgrep)
if [ "$SETUP_MODE" = "local-only" ]; then
  BASE_TOOLS+=(uv)
elif [ "$SETUP_MODE" = "full" ]; then
  BASE_TOOLS+=(uv node npm)
fi

for req_tool in "${BASE_TOOLS[@]}"; do
  command -v "$req_tool" >/dev/null || { echo "ERROR: $req_tool is required on PATH" >&2; exit 1; }
done
if ! command -v opencode >/dev/null 2>&1; then
  echo "Note: 'opencode' is not currently on PATH (install OpenCode v2.0+ before running ./scripts/opencode-local or ./scripts/opencode-attested)."
fi
python3 -c '
import sys
if sys.version_info < (3, 11):
    sys.stderr.write(f"ERROR: Python {sys.version.split()[0]} is unsupported; Python >= 3.11 is required\n")
    raise SystemExit(1)
'

if [ "$SETUP_MODE" = "full" ]; then
  node -e '
const [maj, min] = process.versions.node.split(".").map(Number);
const ok = (maj === 20 && min >= 20) || (maj >= 22 && (maj > 22 || min >= 22));
if (!ok) {
  console.error("ERROR: Node.js v" + process.versions.node + " is unsupported; promptfoo requires ^20.20.0 || >=22.22.0");
  process.exit(1);
}
'
fi

if [ "$SETUP_MODE" = "full" ] || [ "$SETUP_MODE" = "local-only" ]; then
  echo "Creating Python environment..."
  if [ ! -d .venv ]; then
    uv venv --python ">=3.11" .venv
  else
    echo "Using existing .venv"
  fi
  if [ "$SETUP_MODE" = "local-only" ]; then
    uv pip install --python .venv/bin/python -r requirements-local.txt
  else
    uv pip install --python .venv/bin/python -r requirements.txt
  fi
else
  echo "Skipping Python .venv creation (--launcher-only uses stdlib Python 3.11+)."
fi

if [ "$SETUP_MODE" = "full" ]; then
  echo "Installing Node dependencies..."
  npm ci
else
  echo "Skipping Node dependencies (--${SETUP_MODE} does not install promptfoo)."
fi

echo "Building and verifying Secure Enclave key proxy (bin/se-key-proxy and bin/se-key-proxy-test)..."
./scripts/se-key build --include-test-binary
se_rc=0
./scripts/se-key selftest || se_rc=$?
if [ "$se_rc" -eq 77 ]; then
  echo "Note: Secure Enclave selftest skipped (exit 77: Touch ID / biometrics unavailable on this Mac; Rung 1 local inference works without Touch ID)."
elif [ "$se_rc" -ne 0 ]; then
  echo "ERROR: Secure Enclave selftest failed with exit code $se_rc" >&2
  exit "$se_rc"
fi

TINFOIL_PROXY_VERSION="0.2.9"
TINFOIL_PROXY_SHA256="6b526fe32244bcccfcfde3c5d181618b4b06b48498e649cd944cc9b64acf994b"
mkdir -p bin

verify_tinfoil_proxy() {
  local bin_path="$1"
  local actual_sha
  actual_sha="$(shasum -a 256 "$bin_path" | awk '{print $1}')"
  if [ "$actual_sha" != "$TINFOIL_PROXY_SHA256" ]; then
    echo "ERROR: $bin_path SHA-256 mismatch (got $actual_sha, expected $TINFOIL_PROXY_SHA256)" >&2
    return 1
  fi
  if ! codesign -v --strict "$bin_path"; then
    echo "ERROR: $bin_path failed codesign -v --strict verification" >&2
    return 1
  fi
  local sign_info
  sign_info="$(codesign -dv --verbose=4 "$bin_path" 2>&1)"
  echo "$sign_info" | grep -q "TeamIdentifier=8KSH668LZT" || {
    echo "ERROR: $bin_path does not have expected TeamIdentifier=8KSH668LZT" >&2
    return 1
  }
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    gh attestation verify "$bin_path" --repo tinfoilsh/tinfoil-proxy
  elif [ "${FREE_INFERENCE_REQUIRE_GH_ATTESTATION:-0}" = "1" ]; then
    echo "ERROR: 'gh' CLI is missing or not authenticated, and FREE_INFERENCE_REQUIRE_GH_ATTESTATION=1 is set." >&2
    return 1
  else
    echo "WARNING: 'gh' CLI is missing or not authenticated; skipping Sigstore SLSA attestation check (verified pinned SHA-256 and Apple Developer ID TeamIdentifier=8KSH668LZT). Authenticate with 'gh auth login' to enable SLSA verification." >&2
  fi
}

if [ -x bin/tinfoil-proxy ] && verify_tinfoil_proxy "bin/tinfoil-proxy"; then
  echo "Verified existing bin/tinfoil-proxy (v${TINFOIL_PROXY_VERSION}, SHA-256 ${TINFOIL_PROXY_SHA256:0:16}...)."
else
  echo "Downloading and verifying tinfoil-proxy v${TINFOIL_PROXY_VERSION} (darwin-arm64)..."
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT
  curl -fsSL \
    "https://github.com/tinfoilsh/tinfoil-proxy/releases/download/v${TINFOIL_PROXY_VERSION}/tinfoil-proxy-darwin-arm64.zip" \
    -o "$tmp_dir/tinfoil-proxy.zip"
  unzip -q "$tmp_dir/tinfoil-proxy.zip" -d "$tmp_dir"
  chmod 0755 "$tmp_dir/tinfoil-proxy-darwin-arm64"
  verify_tinfoil_proxy "$tmp_dir/tinfoil-proxy-darwin-arm64"
  mv "$tmp_dir/tinfoil-proxy-darwin-arm64" "bin/tinfoil-proxy"
fi

echo
echo "Setup complete."
echo "Next steps:"
if [ "$SETUP_MODE" = "launcher-only" ]; then
  echo "  1. Seal Tinfoil API key in Secure Enclave:     ./scripts/se-key store free-inference.tinfoil"
  echo "  2. Rung 3 (attested enclave on 127.0.0.1:8081): ./scripts/opencode-attested"
else
  echo "  1. Rung 1 (local MLX on 127.0.0.1:8080):       ./scripts/opencode-local"
  echo "  2. Seal Tinfoil API key in Secure Enclave:     ./scripts/se-key store free-inference.tinfoil"
  echo "  3. Rung 3 (attested enclave on 127.0.0.1:8081): ./scripts/opencode-attested"
fi
