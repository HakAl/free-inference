def _extract_json_value(raw_text: str) -> Any:
    cleaned = raw_text.strip()
    if cleaned.startswith("```"):
        lines = cleaned.splitlines()
        if len(lines) >= 2 and lines[-1].strip().startswith("```"):
            cleaned = "\n".join(lines[1:-1]).strip()
    return json.loads(cleaned)


def _strip_code_fences(raw_text: str) -> str:
    cleaned = raw_text.strip()
    if cleaned.startswith("```"):
        lines = cleaned.splitlines()
        if len(lines) >= 2 and lines[-1].strip().startswith("```"):
            return "\n".join(lines[1:-1]).strip()
    return cleaned


def _ref_sliding_counter(cap: int, calls: list[int]) -> list[bool]:
    used = 0
    out: list[bool] = []
    for cost in calls:
        if cost <= 0 or used + cost > cap:
            out.append(False)
        else:
            used += cost
            out.append(True)
    return out


def _mutant_zero_allowed(cap: int, calls: list[int]) -> list[bool]:
    used = 0
    out: list[bool] = []
    for cost in calls:
        if cost < 0 or used + cost > cap:
            out.append(False)
        else:
            used += cost
            out.append(True)
    return out


def _mutant_strict_less_than_cap(cap: int, calls: list[int]) -> list[bool]:
    used = 0
    out: list[bool] = []
    for cost in calls:
        if cost <= 0 or used + cost >= cap:
            out.append(False)
        else:
            used += cost
            out.append(True)
    return out


def _mutant_stateless_no_accumulate(cap: int, calls: list[int]) -> list[bool]:
    out: list[bool] = []
    for cost in calls:
        if cost <= 0 or cost > cap:
            out.append(False)
        else:
            out.append(True)
    return out


def grade_sliding_counter_test_cases(out: dict[str, Any]) -> bool:
    """External behavioral + mutation-testing oracle for SlidingCounter(cap=3) test generation."""
    raw_output = out.get("output")
    if not isinstance(raw_output, str) or not raw_output.strip():
        return False
    try:
        cases = _extract_json_value(raw_output)
    except (ValueError, json.JSONDecodeError):
        return False
    if isinstance(cases, dict) and isinstance(cases.get("cases") or cases.get("test_cases"), list):
        cases = cases.get("cases") or cases.get("test_cases")
    if not isinstance(cases, list) or len(cases) < 3:
        return False

    seen_costs: set[int] = set()
    has_stateful_sequence = False
    normalized_scenarios: list[tuple[list[int], list[bool]]] = []

    for item in cases:
        if not isinstance(item, dict):
            return False
        calls = item.get("calls")
        expected = item.get("expected")
        if (
            not isinstance(calls, list)
            or not calls
            or not all(isinstance(c, int) and not isinstance(c, bool) for c in calls)
        ):
            return False
        if (
            not isinstance(expected, list)
            or len(expected) != len(calls)
            or not all(isinstance(b, bool) for b in expected)
        ):
            return False
        # Every scenario's expected vector must match the reference SlidingCounter(cap=3)
        if _ref_sliding_counter(3, calls) != expected:
            return False
        seen_costs.update(calls)
        if len(calls) >= 2:
            has_stateful_sequence = True
        normalized_scenarios.append((calls, expected))

    # Must exercise boundary values 0, 1, 3, and 4 plus stateful multi-call accumulation
    if not {0, 1, 3, 4}.issubset(seen_costs):
        return False
    if not has_stateful_sequence:
        return False

    # Generated suite must kill all three boundary/stateful mutants
    for mutant_fn in (
        _mutant_zero_allowed,
        _mutant_strict_less_than_cap,
        _mutant_stateless_no_accumulate,
    ):
        killed = any(
            mutant_fn(3, calls) != expected for calls, expected in normalized_scenarios
        )
        if not killed:
            return False

    return True


def _build_python_eval_seatbelt_profile(py_real: str) -> str:
    esc_py = py_real.replace("\\", "\\\\").replace('"', '\\"')
    py_path = Path(py_real)
    reallow = ""
    denied_roots = (
        "/Users",
        "/System/Volumes/Data/Users",
        "/Volumes",
        "/private/tmp",
        "/tmp",
        "/private/var/folders",
        "/var/folders",
        "/private/etc/ssh",
    )
    if any(py_real.startswith(r + "/") for r in denied_roots):
        env_root = str(py_path.parent.parent)
        esc_root = env_root.replace("\\", "\\\\").replace('"', '\\"')
        reallow = (
            f'\n(allow file-read* (subpath "{esc_root}"))'
            f'\n(allow file-read-data (subpath "{esc_root}"))'
        )
    deny_subpaths = "\n  ".join(f'(subpath "{r}")' for r in denied_roots)
    return (
        "(version 1)\n"
        "(allow default)\n"
        "(deny network*)\n"
        "(deny file-write*)\n"
        '(allow file-write* (literal "/dev/null"))\n'
        "(deny process-fork)\n"
        "(deny process-exec)\n"
        f'(allow process-exec (literal "{esc_py}"))\n'
        f"(deny file-read*\n  {deny_subpaths})\n"
        f"(deny file-read-data\n  {deny_subpaths})"
        f"{reallow}\n"
    )


_PARSE_WINDOW_HARNESS_PY = r"""
import json, sys

payload = json.loads(sys.stdin.read())
ns = {"__builtins__": __builtins__}
exec(compile(payload["code"], "<generated_parse_window>", "exec"), ns, ns)
fn = ns.get("parse_window")
if not callable(fn):
    print(json.dumps({"ok": False, "reason": "parse_window_not_callable"}))
    raise SystemExit(0)

valid_cases = [
    ("1s", 1),
    ("15s", 15),
    ("5m", 300),
    ("2h", 7200),
    ("  10s  ", 10),
]
for raw_in, expected_sec in valid_cases:
    got = fn(raw_in)
    if type(got) is not int or got != expected_sec:
        print(json.dumps({"ok": False, "reason": f"wrong_valid:{raw_in!r}->{got!r}"}))
        raise SystemExit(0)

invalid_cases = ["", "   ", "0s", "-5s", "-1m", "10d", "10", "s", "abc"]
for bad_in in invalid_cases:
    try:
        got = fn(bad_in)
    except ValueError:
        continue
    except Exception as exc:
        print(json.dumps({"ok": False, "reason": f"wrong_exc:{bad_in!r}->{type(exc).__name__}"}))
        raise SystemExit(0)
    print(json.dumps({"ok": False, "reason": f"accepted_invalid:{bad_in!r}->{got!r}"}))
    raise SystemExit(0)

print(json.dumps({"ok": True}))
"""


def grade_parse_window_implementation(out: dict[str, Any]) -> bool:
    """Sandboxed behavioral oracle executing generated parse_window against valid and invalid inputs."""
    raw_code = out.get("output")
    assumptions = out.get("assumptions")
    if not isinstance(raw_code, str) or not raw_code.strip():
        return False
    if not isinstance(assumptions, list) or len(assumptions) < 1:
        return False
    code = _strip_code_fences(raw_code)
    try:
        tree = ast.parse(code)
    except SyntaxError:
        return False
    if not any(isinstance(node, ast.FunctionDef) and node.name == "parse_window" for node in tree.body):
        return False

    py_real = str(_resolve_real_python_macho())
    if sys.platform == "darwin":
        sb_bin = Path("/usr/bin/sandbox-exec")
        if not sb_bin.is_file():
            return False
        cmd = [
            str(sb_bin),
            "-p",
            _build_python_eval_seatbelt_profile(py_real),
            py_real,
            "-I",
            "-B",
            "-c",
            _PARSE_WINDOW_HARNESS_PY,
        ]
    else:
        cmd = [py_real, "-I", "-B", "-c", _PARSE_WINDOW_HARNESS_PY]

    safe_cwd = "/var/empty" if Path("/var/empty").is_dir() else "/"
    try:
        proc = subprocess.run(
            cmd,
            input=json.dumps({"code": code}),
            capture_output=True,
            text=True,
            cwd=safe_cwd,
            env={},
            timeout=2.5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    if proc.returncode != 0:
        return False
    try:
        verdict = json.loads(proc.stdout.strip())
    except json.JSONDecodeError:
        return False
    return verdict.get("ok") is True


def _is_json_schema_descriptor(obj: dict[str, Any]) -> bool:
    return (
        obj.get("type") == "object"
        and isinstance(obj.get("properties"), dict)
    ) or "$schema" in obj


_CONSTANT_JSON_PROMPT_RE = re.compile(
    r"^\s*(?:return|output|respond\s+with|reply\s+with)\s+"
    r"(?:only\s+|exact\s+|the\s+exact\s+|valid\s+)?"
    r"json(?:\s+object)?(?:\s+exactly)?\s*:?\s*"
    r"(\{.+\})\s*(?:only\s*)?\.?\s*$",
    re.IGNORECASE | re.DOTALL,
)


def _is_scalar_json_value(val: Any) -> bool:
    return val is None or isinstance(val, (bool, int, float, str))


def _derive_prompt_json_reference(prompt_text: str) -> dict[str, Any] | None:
    """Derive a concrete flat scalar JSON object strictly from an anchored constant-output prompt.

    Only full-string positive imperative constant-output specifications with scalar field values
    (such as `Return JSON {"status": "ok", "count": 6}.`) produce an automatic reference object.
    Any prompt containing input examples, transformations, negations, multiple objects, nested
    arrays/objects, or unsupported surrounding prose returns None and is classified as ungraded.
    """
    m = _CONSTANT_JSON_PROMPT_RE.match(prompt_text)
    if m is None:
        return None
    raw_json = m.group(1).strip()
    decoder = json.JSONDecoder()
    try:
        parsed, end_idx = decoder.raw_decode(raw_json, 0)
    except json.JSONDecodeError:
        return None
    if end_idx != len(raw_json):
        return None
    if not isinstance(parsed, dict) or not parsed or _is_json_schema_descriptor(parsed):
        return None
    if not all(_is_scalar_json_value(v) for v in parsed.values()):
        return None
    return parsed


def _wrong_same_type_values(val: Any) -> list[Any]:
    if isinstance(val, bool):
        return [not val]
    if isinstance(val, int):
        # Include -1/+1 (catches <= / >= / off-by-one) and +10/17 (catches unanchored regexes).
        return [val - 1, val + 1, (val + 10) if val != 0 else 17]
    if isinstance(val, float):
        return [round(val - 1.0, 6), round(val + 1.0, 6), round(val + 10.5, 6)]
    if isinstance(val, str):
        same_len = ("x" * len(val) if val != "x" * len(val) else "y" * len(val)) if val else "z"
        return [f"{val}_WRONG_VALUE" if val else "WRONG_VALUE", same_len]
    return ["__not_null__", {}, []]


def _wrong_type_values(val: Any) -> list[Any]:
    if isinstance(val, bool):
        return ["true", 1] if val else ["false", 0, None]
    if isinstance(val, (int, float)):
        return [str(val), bool(val)]
    if isinstance(val, str):
        return [12345, None]
    return [0, False, "null"]


def _synthesize_prompt_reference_variants(prompt_text: str) -> tuple[list[str], list[str]] | None:
    """Derive formatting-varied valid JSON alternatives and discriminating wrong JSON candidates
    exclusively from prompt_text (never inspecting assertion_js).
    """
    ref_obj = _derive_prompt_json_reference(prompt_text)
    if ref_obj is None:
        return None

    passing_alts = [
        json.dumps(ref_obj, separators=(",", ":"), ensure_ascii=False),
        "  \n" + json.dumps(ref_obj, indent=2, ensure_ascii=False) + "\n",
    ]
    if len(ref_obj) >= 2:
        reversed_obj = dict(reversed(list(ref_obj.items())))
        passing_alts.append(json.dumps(reversed_obj, indent=2, ensure_ascii=False))
    passing_alts = list(dict.fromkeys(passing_alts))

    failing_candidates: list[str] = [
        "{}",
        '{"__unrelated_wrong_key__": -99999}',
    ]
    for key, val in ref_obj.items():
        for wrong_val in _wrong_same_type_values(val):
            mutated_val_obj = dict(ref_obj)
            mutated_val_obj[key] = wrong_val
            failing_candidates.append(json.dumps(mutated_val_obj, ensure_ascii=False))

        mutated_key_obj = {k: v for k, v in ref_obj.items() if k != key}
        mutated_key_obj[f"{key}_wrong"] = val
        failing_candidates.append(json.dumps(mutated_key_obj, ensure_ascii=False))

        for wrong_typed in _wrong_type_values(val):
            mutated_type_obj = dict(ref_obj)
            mutated_type_obj[key] = wrong_typed
            failing_candidates.append(json.dumps(mutated_type_obj, ensure_ascii=False))

    failing_alts = [f for f in dict.fromkeys(failing_candidates) if f not in passing_alts]
    return passing_alts, failing_alts


def _executor_payload_size_bytes(
    assertion_js: str,
    p_batch: list[str],
    f_batch: list[str],
) -> int:
    payload_obj = {
        "mode": "eval",
        "assertion": {"type": "javascript", "value": assertion_js},
        "passing_outputs": p_batch,
        "failing_outputs": f_batch,
    }
    return len(json.dumps(payload_obj, ensure_ascii=False).encode("utf-8"))


def _pack_assertion_batches(
    assertion_js: str,
    passing_alts: list[str],
    failing_alts: list[str],
) -> list[tuple[list[str], list[str]]] | None:
    max_side = int(check_eval_assertion.MAX_CANDIDATES_PER_SIDE)
    max_cand_bytes = int(check_eval_assertion.MAX_CANDIDATE_BYTES)
    max_payload_bytes = int(check_eval_assertion.MAX_STDIN_PAYLOAD_BYTES)

    if len(passing_alts) > 100 or len(failing_alts) > 200:
        return None
    if any(len(c.encode("utf-8")) > max_cand_bytes for c in (*passing_alts, *failing_alts)):
        return None

    batches: list[tuple[list[str], list[str]]] = []
    pi = 0
    fi = 0
    while pi < len(passing_alts) or fi < len(failing_alts):
        if pi < len(passing_alts):
            p_batch = [passing_alts[pi]]
            pi += 1
        else:
            p_batch = [passing_alts[0]]

        if fi < len(failing_alts):
            f_batch = [failing_alts[fi]]
            fi += 1
        else:
            f_batch = [failing_alts[0]]

        if _executor_payload_size_bytes(assertion_js, p_batch, f_batch) > max_payload_bytes:
            return None

        while pi < len(passing_alts) and len(p_batch) < max_side:
            cand_p = passing_alts[pi]
            if _executor_payload_size_bytes(assertion_js, [*p_batch, cand_p], f_batch) > max_payload_bytes:
                break
            p_batch.append(cand_p)
            pi += 1

        while fi < len(failing_alts) and len(f_batch) < max_side:
            cand_f = failing_alts[fi]
            if _executor_payload_size_bytes(assertion_js, p_batch, [*f_batch, cand_f]) > max_payload_bytes:
                break
            f_batch.append(cand_f)
            fi += 1

        batches.append((p_batch, f_batch))

    return batches


def evaluate_proposed_eval_prompts(out: dict[str, Any]) -> dict[str, Any]:
    """Evaluate proposed structured_output prompts against prompt-derived ground truth only.

    Prompts without an unambiguous prompt-derived JSON reference are classified as ungraded
    and never counted as automatic semantic passes.
    """
    prompts = out.get("prompts")
    if not isinstance(prompts, list) or not (1 <= len(prompts) <= 2) or out.get("coverage_note") == "":
        return {
            "passed": False,
            "graded_count": 0,
            "passed_count": 0,
            "failed_count": 1,
            "ungraded_count": 0,
        }

    graded_count = 0
    passed_count = 0
    failed_count = 0
    ungraded_count = 0

    for p in prompts:
        if not isinstance(p, dict):
            failed_count += 1
            continue
        prompt_text = p.get("prompt")
        assertion_js = p.get("assertion")
        if not isinstance(prompt_text, str) or not isinstance(assertion_js, str):
            failed_count += 1
            continue
        if len(assertion_js.encode("utf-8")) > int(check_eval_assertion.MAX_ASSERTION_VALUE_BYTES):
            failed_count += 1
            continue
        syn_ok, _ = check_eval_assertion.validate_assertion_syntax("javascript", assertion_js)
        if not syn_ok or "JSON.parse" not in assertion_js:
            failed_count += 1
            continue

        synthesized = _synthesize_prompt_reference_variants(prompt_text)
        if synthesized is None:
            ungraded_count += 1
            continue

        passing_alts, failing_alts = synthesized
        if len(passing_alts) < 2 or len(failing_alts) < 2:
            ungraded_count += 1
            continue

        batches = _pack_assertion_batches(assertion_js, passing_alts, failing_alts)
        if not batches:
            ungraded_count += 1
            continue

        graded_count += 1
        all_batches_ok = True
        for p_batch, f_batch in batches:
            eval_res = check_eval_assertion.run(
                assertion={"type": "javascript", "value": assertion_js},
                passing_outputs=p_batch,
                failing_outputs=f_batch,
            )
            if not eval_res["passed"]:
                all_batches_ok = False
                break
        if all_batches_ok:
            passed_count += 1
        else:
            failed_count += 1

    all_passed = graded_count >= 1 and failed_count == 0 and ungraded_count == 0
    return {
        "passed": all_passed,
        "graded_count": graded_count,
        "passed_count": passed_count,
        "failed_count": failed_count,
        "ungraded_count": ungraded_count,
    }


def grade_proposed_eval_prompts(out: dict[str, Any]) -> bool:
    """External behavioral oracle checking proposed assertions against prompt-derived references only."""
    return bool(evaluate_proposed_eval_prompts(out)["passed"])


