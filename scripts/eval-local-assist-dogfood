                and any(
                    ex["path"] == "pkg/retry.py"
                    and "MAX_BACKOFF_SECONDS = 32" in ex["excerpt"]
                    and "compute_delay" in ex["excerpt"]
                    for ex in out["excerpts"]
                )
                and all(ex["path"] != "pkg/unrelated.py" for ex in out["excerpts"])
            ),
        },
        {
            "id": "unseen_delegate_partial_context_assumptions",
            "split": "unseen",
            "tool": "delegate_task",
            "args": {
                "kind": "draft_code",
                "instruction": (
                    "Write a pure Python function parse_window(spec: str) -> int returning positive seconds "
                    "for integer suffixes 's', 'm', 'h' (stripping outer whitespace). "
                    "State any assumptions about uppercase suffixes or non-integer magnitudes."
                ),
                "constraints": [
                    "Stdlib only.",
                    "Raise ValueError on empty, zero, negative, or unknown/missing unit specs.",
                ],
            },
            "semantic_check": grade_parse_window_implementation,
        },
    ]


def _verify_oracle_discrimination_selftest() -> None:
    """Confirm behavioral graders accept valid outputs and reject plausible schema-valid wrong outputs."""
    # 1. SlidingCounter test-generation oracle
    good_sc = {
        "output": json.dumps(
            [
                {"calls": [0, -1], "expected": [False, False]},
                {"calls": [1, 2, 1], "expected": [True, True, False]},
                {"calls": [3, 1], "expected": [True, False]},
                {"calls": [4], "expected": [False]},
            ]
        )
    }
    assert grade_sliding_counter_test_cases(good_sc) is True
    # Wrong expected value on stateful second call (says True when 2+2 > 3)
    wrong_expected_sc = {
        "output": json.dumps(
            [
                {"calls": [0], "expected": [False]},
                {"calls": [1, 3], "expected": [True, True]},
                {"calls": [4], "expected": [False]},
            ]
        )
    }
    assert grade_sliding_counter_test_cases(wrong_expected_sc) is False
    # Unrelated 20+ char prose (previously passed len >= 20!)
    assert grade_sliding_counter_test_cases({"output": "Here are several great boundary test cases for you."}) is False
    # Missing boundary coverage (omits exact cap 3 -> fails to kill < vs <= mutant!)
    weak_sc = {
        "output": json.dumps(
            [
                {"calls": [0], "expected": [False]},
                {"calls": [1, 1], "expected": [True, True]},
                {"calls": [4], "expected": [False]},
            ]
        )
    }
    assert grade_sliding_counter_test_cases(weak_sc) is False

    # 2. parse_window behavioral oracle
    good_pw = {
        "output": (
            "def parse_window(spec: str) -> int:\n"
            "    s = spec.strip()\n"
            "    if len(s) < 2 or s[-1] not in ('s', 'm', 'h'):\n"
            "        raise ValueError('bad suffix')\n"
            "    val = int(s[:-1])\n"
            "    if val <= 0:\n"
            "        raise ValueError('non-positive')\n"
            "    mult = {'s': 1, 'm': 60, 'h': 3600}[s[-1]]\n"
            "    return val * mult\n"
        ),
        "assumptions": ["Lowercase unit suffixes only; integer magnitudes only."],
    }
    assert grade_parse_window_implementation(good_pw) is True
    # Always raises ValueError (previously passed substring check!)
    always_raises_pw = {
        "output": "def parse_window(spec: str) -> int:\n    raise ValueError('invalid')\n",
        "assumptions": ["Assumes nothing is valid."],
    }
    assert grade_parse_window_implementation(always_raises_pw) is False
    # Accepts negative values
    neg_bug_pw = {
        "output": (
            "def parse_window(spec: str) -> int:\n"
            "    s = spec.strip()\n"
            "    if len(s) < 2 or s[-1] not in ('s', 'm', 'h'): raise ValueError('u')\n"
            "    return int(s[:-1]) * {'s': 1, 'm': 60, 'h': 3600}[s[-1]]\n"
        ),
        "assumptions": ["Integer magnitudes."],
    }
    assert grade_parse_window_implementation(neg_bug_pw) is False

    # 3. propose_eval_prompts assertion discrimination oracle
    good_pep = {
        "prompts": [
            {
                "id": "p1",
                "prompt": 'Return JSON {"status": "ok", "count": 6}.',
                "expected_signal": "Exact JSON fields",
                "assertion": '(() => { const d = JSON.parse(output); return d.status === "ok" && d.count === 6; })()',
                "category": "structured_output",
            }
        ],
        "coverage_note": "Model returned 1 of 2 requested prompts.",
    }
    assert grade_proposed_eval_prompts(good_pep) is True
    # Tautological assertion (accepts wrong outputs!)
    tautology_pep = {
        "prompts": [
            {
                "id": "p2",
                "prompt": 'Return JSON {"status": "ok", "count": 6}.',
                "expected_signal": "Tautology",
                "assertion": "typeof JSON.parse(output) === 'object'",
                "category": "structured_output",
            }
        ],
        "coverage_note": "1 of 2",
    }
    assert grade_proposed_eval_prompts(tautology_pep) is False
    # Brittle whitespace-locked assertion (rejects pretty-printed valid JSON!)
    brittle_pep = {
        "prompts": [
            {
                "id": "p3",
                "prompt": 'Return JSON {"status": "ok", "count": 6}.',
                "expected_signal": "Brittle string match",
                "assertion": 'JSON.parse(output) && output === \'{"status":"ok","count":6}\'',
                "category": "structured_output",
            }
        ],
        "coverage_note": "1 of 2",
    }
    assert grade_proposed_eval_prompts(brittle_pep) is False
    # Contradictory expected value, key name, and value type vs prompt ground truth MUST fail (LDF-W3)!
    for bad_id, bad_assertion in (
        ("wrong_val", "JSON.parse(output).count === 7"),
        ("wrong_key", '(() => { const d = JSON.parse(output); return d.status === "ok" && d.total === 6; })()'),
        ("wrong_type", '(() => { const d = JSON.parse(output); return d.status === "ok" && typeof d.count === "string"; })()'),
        ("loose_coercion", '(() => { const d = JSON.parse(output); return d.status === "ok" && d.count == 6; })()'),
    ):
        assert (
            grade_proposed_eval_prompts(
                {
                    "prompts": [
                        {
                            "id": bad_id,
                            "prompt": 'Return JSON {"status": "ok", "count": 6}.',
                            "expected_signal": "Contradictory assertion",
                            "assertion": bad_assertion,
                            "category": "structured_output",
                        }
                    ],
                    "coverage_note": "1 of 2",
                }
            )
            is False
        )
    # Prompts without an unambiguous constant-output JSON specification (including input examples,
    # transformations, negations, or open-ended wording) are reported as ungraded, never passed!
    for ug_id, ug_prompt, ug_assert in (
        (
            "ungraded_open",
            "Summarize the server health report as a JSON object with fields status and count.",
            "JSON.parse(output).count === 7",
        ),
        (
            "ungraded_input_transform",
            'Given {"count": 6}, return JSON with count increased by one.',
            "JSON.parse(output).count === 6",
        ),
        (
            "ungraded_example",
            'For example, {"count": 6} is an integer count. Return JSON for an empty queue.',
            "JSON.parse(output).count === 6",
        ),
        (
            "ungraded_negation",
            'Do not return JSON {"count": 6}; return a different count.',
            "JSON.parse(output).count === 6",
        ),
    ):
        ungraded_pep = {
            "prompts": [
                {
                    "id": ug_id,
                    "prompt": ug_prompt,
                    "expected_signal": "Non-constant or ambiguous prompt",
                    "assertion": ug_assert,
                    "category": "structured_output",
                }
            ],
            "coverage_note": "1 of 2",
        }
        ungraded_detail = evaluate_proposed_eval_prompts(ungraded_pep)
        assert ungraded_detail["passed"] is False
        assert ungraded_detail["ungraded_count"] == 1
        assert grade_proposed_eval_prompts(ungraded_pep) is False


def validate_fixtures_offline() -> dict[str, Any]:
    fixtures = _build_fixtures()
    seen = [f for f in fixtures if f["split"] == "seen"]
    unseen = [f for f in fixtures if f["split"] == "unseen"]

    for fx in fixtures:
        assert isinstance(fx["id"], str) and fx["id"]
        assert fx["tool"] in {
            "compress_context",
            "extract_fields",
            "delegate_task",
            "propose_eval_prompts",
            "select_context",
        }
        assert callable(fx["semantic_check"])

    status_out = assist_status.run()
    assert status_out["server"]["name"] == "local-assist-server"
    with tempfile.TemporaryDirectory() as td:
        old_log = os.environ.get("LOCAL_ASSIST_LOG_DIR")
        os.environ["LOCAL_ASSIST_LOG_DIR"] = td
        try:
            chk = check_eval_assertion.run(
                assertion={"type": "javascript", "value": "JSON.parse(output).ok === true"},
                passing_outputs=['{"ok": true}'],
                failing_outputs=['{"ok": false}'],
            )
            assert chk["passed"] is True
            _verify_oracle_discrimination_selftest()
        finally:
            if old_log is None:
                os.environ.pop("LOCAL_ASSIST_LOG_DIR", None)
            else:
                os.environ["LOCAL_ASSIST_LOG_DIR"] = old_log

    return {
        "mode": "offline_validation",
        "fixtures_valid": True,
        "oracle_selftests_passed": True,
        "total_fixtures": len(fixtures),
        "seen_count": len(seen),
        "unseen_count": len(unseen),
        "fixture_ids": [f["id"] for f in fixtures],
    }


def _invoke_fixture(fx: dict[str, Any], ws_dir: Path) -> dict[str, Any]:
    for rel, content in fx.get("workspace_files", {}).items():
        target = ws_dir / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")

    tool_name = fx["tool"]
    args = fx["args"]
    if tool_name == "compress_context":
        return dict(compress_context.run(**args))
    if tool_name == "extract_fields":
        return dict(extract_fields.run(**args))
    if tool_name == "delegate_task":
        return dict(delegate_task.run(**args))
    if tool_name == "propose_eval_prompts":
        return dict(propose_eval_prompts.run(**args))
    if tool_name == "select_context":
        return dict(select_context.run(**args))
    raise ValueError(f"Unsupported fixture tool: {tool_name}")


def run_live_benchmark(repeats: int) -> dict[str, Any]:
    fixtures = _build_fixtures()
    per_fixture: list[dict[str, Any]] = []
    total_runs = 0
    total_schema_rejects = 0
    total_semantic_passes = 0
    total_ungraded_runs = 0

    with tempfile.TemporaryDirectory() as td:
        ws_dir = Path(td) / "ws"
        ws_dir.mkdir()
        old_ws = os.environ.get("LOCAL_ASSIST_WORKSPACE_ROOT")
        os.environ["LOCAL_ASSIST_WORKSPACE_ROOT"] = str(ws_dir)
        try:
            with caller_context(transport="cli", client_name="eval-local-assist-dogfood"):
                for fx in fixtures:
                    schema_rejects = 0
                    other_errors = 0
                    semantic_passes = 0
                    ungraded_runs = 0
                    latencies_ms: list[int] = []
                    check_fn: Callable[[dict[str, Any]], bool] = fx["semantic_check"]
                    for _ in range(repeats):
                        total_runs += 1
                        t0 = time.perf_counter()
                        try:
                            out = _invoke_fixture(fx, ws_dir)
                            latencies_ms.append(int(round((time.perf_counter() - t0) * 1000)))
                            if fx["tool"] == "propose_eval_prompts":
                                pep_detail = evaluate_proposed_eval_prompts(out)
                                if pep_detail["passed"]:
                                    semantic_passes += 1
                                    total_semantic_passes += 1
                                elif pep_detail["failed_count"] == 0 and pep_detail["ungraded_count"] > 0:
                                    ungraded_runs += 1
                                    total_ungraded_runs += 1
                            elif check_fn(out):
                                semantic_passes += 1
                                total_semantic_passes += 1
                        except LocalAssistError as exc:
                            if exc.code == "malformed_model_output":
                                schema_rejects += 1
                                total_schema_rejects += 1
                            else:
                                other_errors += 1
                    per_fixture.append(
                        {
                            "id": fx["id"],
                            "split": fx["split"],
                            "tool": fx["tool"],
                            "repeats": repeats,
                            "schema_rejections": schema_rejects,
                            "other_errors": other_errors,
                            "semantic_passes": semantic_passes,
                            "ungraded_runs": ungraded_runs,
                            "latencies_ms": latencies_ms,
                        }
                    )
        finally:
            if old_ws is None:
                os.environ.pop("LOCAL_ASSIST_WORKSPACE_ROOT", None)
            else:
                os.environ["LOCAL_ASSIST_WORKSPACE_ROOT"] = old_ws

    graded_denominator = max(1, total_runs - total_ungraded_runs)
    return {
        "mode": "live",
        "repeats": repeats,
        "total_runs": total_runs,
        "total_schema_rejections": total_schema_rejects,
        "total_semantic_passes": total_semantic_passes,
        "total_ungraded_runs": total_ungraded_runs,
        "schema_rejection_rate": round(total_schema_rejects / max(1, total_runs), 4),
        "semantic_pass_rate": round(total_semantic_passes / graded_denominator, 4),
        "fixtures": per_fixture,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Repeatable seen + unseen dogfood benchmark for local_assist tools. "
            "Runs offline fixture and behavioral-oracle self-tests unless --live --operator-approved is passed."
        )
    )
    parser.add_argument(
        "--validate-fixtures",
        action="store_true",
        help="Run offline fixture and behavioral-oracle validation without contacting 127.0.0.1:8080 (default when --live is omitted).",
    )
    parser.add_argument(
        "--live",
        action="store_true",
        help="Execute live Rung 1 benchmark runs against 127.0.0.1:8080 (requires --operator-approved).",
    )
    parser.add_argument(
        "--operator-approved",
        action="store_true",
        help="Confirm operator approval for live local inference execution.",
    )
    parser.add_argument(
        "--repeats",
        type=int,
        default=3,
        help="Number of live repeats per fixture when --live is set (1..10, default: 3).",
    )
    args = parser.parse_args(argv)
    if args.live and args.validate_fixtures:
        print("ERROR: Pass either --validate-fixtures or --live, not both.", file=sys.stderr)
        return 2
    if not args.live:
        summary = validate_fixtures_offline()
        print(json.dumps(summary, indent=2, ensure_ascii=False))
        return 0
    if not args.operator_approved:
        print(
            "Refusing --live without --operator-approved. Run with --validate-fixtures for offline checks, "
            "or pass --live --operator-approved after starting the Rung 1 model with operator approval.",
            file=sys.stderr,
        )
        return 2
    if args.repeats < 1 or args.repeats > 10:
        print("ERROR: --repeats must be in 1..10.", file=sys.stderr)
        return 2
    report = run_live_benchmark(args.repeats)
    print(json.dumps(report, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
