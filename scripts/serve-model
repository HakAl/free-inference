import os
import secrets
import select
import shlex
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path
from typing import Any
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
if __name__ == "__main__" and VENV_PYTHON.exists() and Path(sys.executable) != VENV_PYTHON:
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT))

from local_assist.registry import (
    BASE_SAFE_ENV_ALLOWLIST,
    LOCAL_HOSTS,
    LOCAL_RUNTIMES,
    RegistryError,
    build_base_url,
    get_process_lstart,
    legacy_pid_file,
    list_pid_records,
    load_model,
    pid_file_for_model,
    pid_is_alive,
    pid_is_zombie,
    pid_matches_record,
    read_pid_record_for_model,
    resolve_endpoint,
    session_token_file_for_model,
    validate_custom_command_localhost,
)
from local_assist.se_key import (
    SEKeyIntegrityError,
    ensure_envelope_available_or_migrate,
    verify_se_key_proxy_binary,
)
from local_assist.security_profile import (
    SecurityProfileError,
    validate_default_chat_params,
)


RUNS = ROOT / "runs"
DEFAULT_PORT = 8080
DEFAULT_MAX_TOKENS_CAP = 4096
INTERACTIVE_MAX_CHAT_REQUESTS = 1000
INTERACTIVE_MAX_TOKENS_CAP = 16384
INTERACTIVE_MAX_REQUEST_BYTES = 8388608
INTERACTIVE_TTL_SECONDS = 43200
CUSTOM_COMMAND_RUNTIMES = {"proxy", "mlx-vlm", "vllm-mlx", "omlx", "llama.cpp"}
SERVE_ENV_ALLOWLIST = BASE_SAFE_ENV_ALLOWLIST | frozenset({
    "COLORTERM",
    "HOME",
    "MLX_METAL_BUFFER_CACHE_LIMIT_KB",
})
TINFOIL_CHILD_ENV_ALLOWLIST = BASE_SAFE_ENV_ALLOWLIST | frozenset({
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
})
SE_KEY_PROXY_CHILD_ENV_ALLOWLIST = BASE_SAFE_ENV_ALLOWLIST | frozenset({
    "HOME",
})


def _pid_is_alive(pid: int) -> bool:
    return pid_is_alive(pid)


def _require_process_lstart(pid: int) -> str:
    lstart = get_process_lstart(pid)
    if not lstart:
        raise RuntimeError(f"Could not determine process start time (lstart) for pid={pid}")
    return lstart


def _classify_pid_state(pid: Any, expected_lstart: Any) -> str:
    if (
        not isinstance(pid, int)
        or isinstance(pid, bool)
        or pid <= 0
        or not _pid_is_alive(pid)
        or pid_is_zombie(pid)
    ):
        return "dead"
    if not isinstance(expected_lstart, str) or not expected_lstart.strip():
        return "unavailable"
    actual_lstart = get_process_lstart(pid)
    if not isinstance(actual_lstart, str) or not actual_lstart.strip():
        if not _pid_is_alive(pid) or pid_is_zombie(pid):
            return "dead"
        return "unavailable"
    if actual_lstart.strip() == expected_lstart.strip():
        return "matched"
    return "reused"


def _terminate_verified_pid(
    pid: int,
    expected_lstart: str | None,
    *,
    timeout_sec: float = 5.0,
) -> tuple[bool, str | None]:
    state = _classify_pid_state(pid, expected_lstart)
    if state in ("dead", "reused"):
        return True, None
    if state == "unavailable":
        return False, f"process identity (lstart) unavailable for pid={pid}"

    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True, None
    except OSError as exc:
        return False, f"failed to send SIGTERM to pid={pid}: {exc}"

    deadline = time.monotonic() + max(0.05, timeout_sec)
    while time.monotonic() < deadline:
        st = _classify_pid_state(pid, expected_lstart)
        if st in ("dead", "reused"):
            return True, None
        if st == "unavailable":
            return (
                False,
                f"process identity (lstart) became unavailable for pid={pid} before exit could be confirmed",
            )
        time.sleep(0.05)

    st = _classify_pid_state(pid, expected_lstart)
    if st in ("dead", "reused"):
        return True, None
    if st == "unavailable":
        return (
            False,
            f"process identity (lstart) became unavailable for pid={pid} before SIGKILL",
        )

    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True, None
    except OSError as exc:
        return False, f"failed to send SIGKILL to pid={pid}: {exc}"

    kill_deadline = time.monotonic() + 1.0
    while time.monotonic() < kill_deadline:
        st2 = _classify_pid_state(pid, expected_lstart)
        if st2 in ("dead", "reused"):
            return True, None
        if st2 == "unavailable":
            return (
                False,
                f"process identity (lstart) became unavailable for pid={pid} after SIGKILL",
            )
        time.sleep(0.05)

    return False, f"process pid={pid} did not exit after SIGTERM/SIGKILL"


def _wait_for_port_unbind(host: str, port: int, timeout_sec: float = 5.0) -> bool:
    deadline = time.monotonic() + max(0.05, timeout_sec)
    while time.monotonic() < deadline:
        if not _port_is_bound(host, port):
            return True
        time.sleep(0.05)
    return not _port_is_bound(host, port)


def _port_is_bound(host: str, port: int) -> bool:
    bind_host = "127.0.0.1" if host == "localhost" else host
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((bind_host, port)) == 0


def health(api_base_url: str, api_key: str) -> bool:
    req = Request(
        f"{api_base_url}/models",
        headers={
            "Accept": "application/json",
            "Authorization": f"Bearer {api_key}",
        },
        method="GET",
    )
    try:
        with urlopen(req, timeout=1) as resp:
            return 200 <= resp.status < 300
    except Exception:
        return False


def build_command(
    model: dict,
    *,
    runtime: str,
    host: str,
    port: int,
    chat_template_args_override: dict | None,
) -> tuple[list[str] | None, str | None]:
    repo = model["repo"]
    if host not in LOCAL_HOSTS:
        return None, f"Refusing to bind local server to non-localhost host '{host}'."

    bind_host = "127.0.0.1" if host == "localhost" else host
    if runtime == "mlx-lm":
        # `python -m mlx_lm.server` is deprecated in mlx_lm 0.29+; the supported
        # invocation is `python -m mlx_lm server` (no dot). MLX_METAL_BUFFER_
        # CACHE_LIMIT_KB is honored from the environment if the operator wants to
        # cap Metal's buffer cache as an experimental memory mitigation.
        cmd = [
            sys.executable,
            "-m",
            "mlx_lm",
            "server",
            "--model",
            repo,
            "--host",
            bind_host,
            "--port",
            str(port),
        ]
        chat_template_file = model.get("chat_template_file")
        if chat_template_file:
            template_path = (ROOT / chat_template_file).resolve()
            if not template_path.exists():
                return None, f"chat_template_file not found: {template_path}"
            cmd.extend(["--chat-template", template_path.read_text()])
        chat_template_args = (
            chat_template_args_override
            if chat_template_args_override is not None
            else model.get("chat_template_args")
        )
        if chat_template_args:
            cmd.extend(["--chat-template-args", json.dumps(chat_template_args)])
        return cmd, None

    if runtime in CUSTOM_COMMAND_RUNTIMES:
        raw_cmd = model.get("serve_command")
        if not raw_cmd or not isinstance(raw_cmd, str):
            return (
                None,
                f"runtime={runtime} requires a string serve_command in models.yaml",
            )
        rendered = raw_cmd.format(port=port, host=bind_host, repo=repo)
        cmd = shlex.split(rendered)
        validation_error = validate_custom_command_localhost(cmd, expected_port=port)
        if validation_error is not None:
            return None, validation_error
        return cmd, None

    return (
        None,
        f"scripts/serve-model supports runtime=mlx-lm or {sorted(CUSTOM_COMMAND_RUNTIMES)} with serve_command, got {runtime}",
    )


def build_serve_env(
    endpoint: Any,
    *,
    allow_hf_online: bool = False,
    base_env: dict[str, str] | None = None,
) -> dict[str, str]:
    src = base_env if base_env is not None else os.environ
    env: dict[str, str] = {
        k: v for k, v in src.items() if k in SERVE_ENV_ALLOWLIST and isinstance(v, str)
    }
    env["HF_HOME"] = str(ROOT / ".home" / "huggingface")
    env["HF_HUB_CACHE"] = str(ROOT / ".home" / "huggingface" / "hub")
    env["HF_HUB_DISABLE_TELEMETRY"] = "1"
    env["DO_NOT_TRACK"] = "1"
    is_local = getattr(endpoint, "trust_tier", None) == "local"
    if is_local and allow_hf_online:
        env["HF_HUB_ENABLE_HF_TRANSFER"] = src.get("HF_HUB_ENABLE_HF_TRANSFER", "1")
        for key in ("HF_TOKEN", "HF_HUB_OFFLINE", "TRANSFORMERS_OFFLINE"):
            val = src.get(key)
            if isinstance(val, str):
                env[key] = val
    else:
        env["HF_HUB_ENABLE_HF_TRANSFER"] = "0"
        if is_local:
            # Force offline mode for local models so cached models never phone home to
            # huggingface.co on server startup, even if HF_HUB_OFFLINE=0 is in the parent env.
            env["HF_HUB_OFFLINE"] = "1"
            env["TRANSFORMERS_OFFLINE"] = "1"
    return env


def build_tinfoil_child_env(
    base_env: dict[str, str] | None = None,
    *,
    isolated_home: Path | None = None,
) -> dict[str, str]:
    src = base_env if base_env is not None else os.environ
    env: dict[str, str] = {
        k: v for k, v in src.items() if k in TINFOIL_CHILD_ENV_ALLOWLIST and isinstance(v, str)
    }
    env["HOME"] = str(isolated_home if isolated_home is not None else (ROOT / ".home"))
    return env


def build_se_key_proxy_child_env(
    base_env: dict[str, str] | None = None,
) -> dict[str, str]:
    src = base_env if base_env is not None else os.environ
    return {
        k: v for k, v in src.items() if k in SE_KEY_PROXY_CHILD_ENV_ALLOWLIST and isinstance(v, str)
    }


def _write_exclusive_session_token(path: Path, token: str) -> None:
    path.unlink(missing_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(str(path), flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (token + "\n").encode("utf-8"))
    finally:
        os.close(fd)


def _terminate_proc(proc: subprocess.Popen[Any] | None) -> None:
    if proc is None:
        return
    try:
        if proc.poll() is None:
            os.kill(proc.pid, signal.SIGTERM)
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                os.kill(proc.pid, signal.SIGKILL)
    except OSError:
        pass


class _SignalInterruptedError(BaseException):
    def __init__(self, signum: int) -> None:
        super().__init__(f"Interrupted by signal {signum}")
        self.signum = signum


@contextlib.contextmanager
def _pid_lock(runs_dir: Path):
    runs_dir.mkdir(parents=True, exist_ok=True)
    pid_lock_path = runs_dir / ".pid.lock"
    with pid_lock_path.open("w") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def _after_initial_provisional_write_hook() -> None:
    return


def _write_pid_files(
    model_pid_file: Path,
    default_pid_file: Path,
    record: dict[str, Any],
) -> None:
    serialized = json.dumps(record, indent=2) + "\n"
    model_pid_file.write_text(serialized)
    if default_pid_file.exists():
        try:
            existing = json.loads(default_pid_file.read_text())
            if (
                isinstance(existing, dict)
                and existing.get("model_id") != record.get("model_id")
            ):
                existing_pid = existing.get("pid")
                if pid_is_alive(existing_pid):
                    expected_lstart = existing.get("pid_lstart")
                    if not isinstance(expected_lstart, str) or not expected_lstart.strip():
                        return
                    actual_lstart = get_process_lstart(existing_pid)
                    if actual_lstart is None or actual_lstart.strip() == expected_lstart.strip():
                        return
        except (OSError, json.JSONDecodeError):
            pass
    default_pid_file.write_text(serialized)


def _assert_provisional_record_active(
    model_pid_file: Path,
    startup_nonce: str,
) -> None:
    if not model_pid_file.exists():
        raise RuntimeError(
            "Startup aborted: provisional PID file was removed concurrently by stop-model"
        )
    try:
        current_disk_rec = json.loads(model_pid_file.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(
            f"Startup aborted: provisional PID record unreadable: {exc}"
        ) from exc
    if (
        not isinstance(current_disk_rec, dict)
        or current_disk_rec.get("startup_nonce") != startup_nonce
    ):
        raise RuntimeError(
            "Startup aborted: provisional PID record was modified concurrently"
        )


def _unlink_pid_files_if_matching(
    model_pid_file: Path,
    default_pid_file: Path,
    model_id: str,
    startup_nonce: str,
) -> None:
    for p in (model_pid_file, default_pid_file):
        try:
            if not p.exists():
                continue
            rec = json.loads(p.read_text())
            if isinstance(rec, dict) and (
                rec.get("startup_nonce") == startup_nonce
                or rec.get("model_id") == model_id
            ):
                p.unlink(missing_ok=True)
        except OSError:
            pass
        except json.JSONDecodeError:
            try:
                p.unlink(missing_ok=True)
            except OSError:
                pass


def _extract_default_chat_params(
    model: dict[str, Any],
    *,
    thinking: bool = False,
) -> dict[str, Any]:
    if thinking:
        return {}
    raw_provider = model.get("promptfoo_provider")
    raw_cfg = raw_provider.get("config") if isinstance(raw_provider, dict) else None
    raw_passthrough = raw_cfg.get("passthrough") if isinstance(raw_cfg, dict) else None
    if isinstance(raw_passthrough, dict) and raw_passthrough:
        return validate_default_chat_params(raw_passthrough)
    return {}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Start the local model or proxy server configured in models.yaml."
    )
    parser.add_argument("model_id", help="Model id from models.yaml.")
    parser.add_argument(
        "--port",
        type=int,
        default=None,
        help="Override the port derived from promptfoo_provider.apiBaseUrl.",
    )
    parser.add_argument(
        "--chat-template-args",
        dest="chat_template_args",
        default=None,
        help="JSON object passed to --chat-template-args (mlx-lm runtime).",
    )
    parser.add_argument(
        "--allow-hf-online",
        action="store_true",
        default=False,
        help="Allow Hugging Face Hub network access during local model server startup (default: forced offline).",
    )
    parser.add_argument(
        "--started-by",
        dest="started_by",
        default=None,
        help="Provenance tag recorded in the PID file (for example 'manual' or 'auto-serve').",
    )
    parser.add_argument(
        "--ttl-seconds",
        dest="ttl_seconds",
        type=int,
        default=3600,
        help="Session TTL in seconds for se-key-proxy before automatic shutdown (default: 3600).",
    )
    parser.add_argument(
        "--max-chat-requests",
        dest="max_chat_requests",
        type=int,
        default=50,
        help="Maximum POST /v1/chat/completions requests per se-key-proxy session (default: 50).",
    )
    parser.add_argument(
        "--max-tokens-cap",
        dest="max_tokens_cap",
        type=int,
        default=DEFAULT_MAX_TOKENS_CAP,
        help=f"Maximum max_tokens cap enforced by se-key-proxy per chat request (0 = no proxy cap, default: {DEFAULT_MAX_TOKENS_CAP}).",
    )
    parser.add_argument(
        "--max-request-bytes",
        dest="max_request_bytes",
        type=int,
        default=262144,
        help="Maximum HTTP request body bytes allowed by se-key-proxy (default: 262144).",
    )
    parser.add_argument(
        "--stream-timeout-seconds",
        dest="stream_timeout_seconds",
        type=int,
        default=300,
        help="Maximum total duration in seconds for a single proxied request/stream in se-key-proxy (default: 300).",
    )
    parser.add_argument(
        "--interactive",
        action="store_true",
        default=False,
        help=(
            "Use interactive coding session caps for se-key-proxy "
            f"(max_chat_requests={INTERACTIVE_MAX_CHAT_REQUESTS}, max_tokens_cap={INTERACTIVE_MAX_TOKENS_CAP}, "
            f"max_request_bytes={INTERACTIVE_MAX_REQUEST_BYTES}, ttl_seconds={INTERACTIVE_TTL_SECONDS})."
        ),
    )
    parser.add_argument(
        "--eval-caps",
        dest="eval_caps",
        action="store_true",
        default=False,
        help="Use evaluation suite session caps for se-key-proxy (max_chat_requests=50, max_tokens_cap=4096, max_request_bytes=262144, ttl_seconds=3600; default).",
    )
    parser.add_argument(
        "--thinking",
        action="store_true",
        default=False,
        help="Do not inject model passthrough thinking=false / include_reasoning=false defaults in se-key-proxy.",
    )
    parser.add_argument(
        "--refresh-session",
        "--restart",
        dest="refresh_session",
        action="store_true",
        default=False,
        help="Stop any active server/proxy session for this model on the target port and start a fresh session.",
    )
    args = parser.parse_args(argv[1:])

    if args.interactive and args.eval_caps:
        print("Cannot combine --interactive and --eval-caps.", file=sys.stderr)
        return 2

    raw_flags = set(argv[1:])
    has_explicit_flag = lambda flag: any(
        tok == flag or tok.startswith(f"{flag}=") for tok in raw_flags
    )
    if args.interactive:
        if not has_explicit_flag("--max-chat-requests"):
            args.max_chat_requests = INTERACTIVE_MAX_CHAT_REQUESTS
        if not has_explicit_flag("--max-tokens-cap"):
            args.max_tokens_cap = INTERACTIVE_MAX_TOKENS_CAP
        if not has_explicit_flag("--max-request-bytes"):
            args.max_request_bytes = INTERACTIVE_MAX_REQUEST_BYTES
        if not has_explicit_flag("--ttl-seconds"):
            args.ttl_seconds = INTERACTIVE_TTL_SECONDS

    chat_template_args_override = None
    if args.chat_template_args is not None:
        try:
            chat_template_args_override = json.loads(args.chat_template_args)
        except json.JSONDecodeError as exc:
            print(f"invalid --chat-template-args JSON: {exc}", file=sys.stderr)
            return 2

    try:
        model = load_model(args.model_id)
        existing_pid_record = read_pid_record_for_model(args.model_id, RUNS)
        endpoint = resolve_endpoint(
            model,
            pid_record=existing_pid_record,
            require_api_key=False,
        )
    except RegistryError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    if args.allow_hf_online and (
        endpoint.trust_tier != "local" or endpoint.runtime not in LOCAL_RUNTIMES
    ):
        print(
            f"--allow-hf-online is only supported for Rung 1 local models (runtime in {sorted(LOCAL_RUNTIMES)}), "
            f"got model '{endpoint.model_id}' (tier={endpoint.trust_tier}, runtime={endpoint.runtime}).",
            file=sys.stderr,
        )
        return 2

    host = endpoint.host
    if host not in LOCAL_HOSTS:
        print(
            f"Refusing to bind local server for {endpoint.model_id} to non-localhost host '{host}'.",
            file=sys.stderr,
        )
        return 1

    port = args.port if args.port is not None else (endpoint.port or DEFAULT_PORT)
    api_base_url = build_base_url(host, port)

    RUNS.mkdir(exist_ok=True)
    (ROOT / ".home" / "huggingface").mkdir(parents=True, exist_ok=True)

    uses_se_key_proxy = bool(endpoint.api_key_keychain_service)
    se_proxy_bin: Path | None = None
    upstream_port: int | None = None
    upstream_cmd: list[str] | None = None
    upstream_url: str | None = None
    cmd: list[str] | None = None
    default_chat_params: dict[str, Any] = {}

    if uses_se_key_proxy:
        try:
            default_chat_params = _extract_default_chat_params(
                model,
                thinking=bool(args.thinking),
            )
        except SecurityProfileError as exc:
            print(f"Invalid model passthrough config for {endpoint.model_id}: {exc}", file=sys.stderr)
            return 1
        try:
            se_proxy_bin = verify_se_key_proxy_binary()
        except SEKeyIntegrityError as exc:
            print(f"SEKeyIntegrityError: {exc}", file=sys.stderr)
            return 1

        raw_serve_cmd = model.get("serve_command")
        if isinstance(raw_serve_cmd, str) and raw_serve_cmd.strip():
            upstream_port = port + 1000
            if upstream_port > 65535:
                print(
                    f"Refusing to start '{endpoint.model_id}': upstream port {upstream_port} (port + 1000) exceeds 65535.",
                    file=sys.stderr,
                )
                return 1
            upstream_cmd, err = build_command(
                model,
                runtime=endpoint.runtime,
                host=host,
                port=upstream_port,
                chat_template_args_override=chat_template_args_override,
            )
            if err or upstream_cmd is None:
                print(err or "failed to build upstream command", file=sys.stderr)
                return 1
            upstream_url = f"http://127.0.0.1:{upstream_port}/v1"
        elif endpoint.upstream_base_url:
            upstream_url = endpoint.upstream_base_url
        else:
            print(
                f"Model {endpoint.model_id}: apiKeyKeychainService requires either serve_command or upstreamBaseUrl.",
                file=sys.stderr,
            )
            return 1
    else:
        cmd, err = build_command(
            model,
            runtime=endpoint.runtime,
            host=host,
            port=port,
            chat_template_args_override=chat_template_args_override,
        )
        if err or cmd is None:
            print(err or "failed to build command", file=sys.stderr)
            return 1

    started_by = (
        args.started_by
        or os.environ.get("LOCAL_ASSIST_STARTED_BY")
        or "manual"
    )
    lock_path = RUNS / ".serve.lock"
    with lock_path.open("w") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        same_model_record: dict[str, Any] | None = None
        legacy_port_record: dict[str, Any] | None = None
        orphaned_same_model_records: list[dict[str, Any]] = []
        for _, rec in list_pid_records(RUNS):
            rec_pid = rec.get("pid")
            rec_up_pid = rec.get("upstream_pid")
            rec_port = rec.get("port", DEFAULT_PORT)
            rec_up_port = rec.get("upstream_port")
            rec_model_id = rec.get("model_id")
            if rec_port != port and (upstream_port is None or rec_up_port != upstream_port):
                continue

            rec_lstart = rec.get("pid_lstart")
            rec_up_lstart = rec.get("upstream_pid_lstart")
            pid_state = _classify_pid_state(rec_pid, rec_lstart)
            has_up_pid = isinstance(rec_up_pid, int) and not isinstance(rec_up_pid, bool) and rec_up_pid > 0
            up_state = _classify_pid_state(rec_up_pid, rec_up_lstart) if has_up_pid else "dead"

            if pid_state == "unavailable" or up_state == "unavailable":
                legacy_port_record = rec
                continue

            if pid_state == "matched" and (not has_up_pid or up_state == "matched"):
                if not rec_model_id:
                    print(
                        f"Refusing to start '{endpoint.model_id}' on port {port}: "
                        f"active PID record on port {rec_port} (pid={rec_pid}, upstream_pid={rec_up_pid}) "
                        f"has a missing or empty model_id. Preserving existing PID record.",
                        file=sys.stderr,
                    )
                    return 1
                if rec_model_id != endpoint.model_id:
                    print(
                        f"Refusing to start '{endpoint.model_id}' on port {port}: "
                        f"another model ('{rec_model_id}', pid={rec_pid}) is already active on port {port}. "
                        f"Run ./scripts/stop-model {rec_model_id} first.",
                        file=sys.stderr,
                    )
                    return 3
                same_model_record = rec
            elif pid_state == "matched" or up_state == "matched":
                if not rec_model_id:
                    print(
                        f"Refusing to start '{endpoint.model_id}' on port {port}: "
                        f"partially active PID record on port {rec_port} (pid={rec_pid}, upstream_pid={rec_up_pid}) "
                        f"has a missing or empty model_id; refusing automatic cleanup. Preserving existing PID record.",
                        file=sys.stderr,
                    )
                    return 1
                if rec_model_id != endpoint.model_id:
                    print(
                        f"Refusing to start '{endpoint.model_id}' on port {port}: "
                        f"another model ('{rec_model_id}', pid={rec_pid}, upstream_pid={rec_up_pid}) "
                        f"still has an active process on port {rec_port}. "
                        f"Run ./scripts/stop-model {rec_model_id} first.",
                        file=sys.stderr,
                    )
                    return 3
                orphaned_same_model_records.append(rec)

        if legacy_port_record is not None:
            leg_model = str(legacy_port_record.get("model_id") or endpoint.model_id)
            print(
                f"Refusing to reuse or overwrite server on port {port} ({api_base_url}): "
                f"legacy PID record for '{leg_model}' (pid={legacy_port_record.get('pid')}, "
                f"upstream_pid={legacy_port_record.get('upstream_pid')}) lacks verified process start-time metadata (pid_lstart). "
                f"Inspect with './scripts/stop-model {leg_model}', then run './scripts/stop-model --force-legacy {leg_model}' (if it is your old server) "
                f"or './scripts/stop-model --discard-legacy {leg_model}' (if the PID was reused by another process).",
                file=sys.stderr,
            )
            return 1

        if same_model_record is not None and not args.refresh_session:
            print(
                f"Server for '{endpoint.model_id}' is already active (or starting) on port {port} "
                f"(pid={same_model_record.get('pid')}, {api_base_url})."
            )
            print(json.dumps(same_model_record, indent=2))
            return 0

        records_to_stop: list[dict[str, Any]] = []
        if same_model_record is not None and args.refresh_session:
            records_to_stop.append(same_model_record)
        records_to_stop.extend(orphaned_same_model_records)

        if records_to_stop:
            seen_stop_keys: set[tuple[Any, Any, Any]] = set()
            for srec in records_to_stop:
                skey = (srec.get("pid"), srec.get("upstream_pid"), srec.get("startup_nonce"))
                if skey in seen_stop_keys:
                    continue
                seen_stop_keys.add(skey)

                spid = srec.get("pid")
                if isinstance(spid, int) and not isinstance(spid, bool) and spid > 0:
                    ok_p, err_p = _terminate_verified_pid(spid, srec.get("pid_lstart"))
                    if not ok_p:
                        print(
                            f"Refusing to start '{endpoint.model_id}': could not safely terminate previous "
                            f"server/proxy process pid={spid} ({err_p}). Preserving existing PID record.",
                            file=sys.stderr,
                        )
                        return 1

                sup_pid = srec.get("upstream_pid")
                if isinstance(sup_pid, int) and not isinstance(sup_pid, bool) and sup_pid > 0:
                    ok_u, err_u = _terminate_verified_pid(sup_pid, srec.get("upstream_pid_lstart"))
                    if not ok_u:
                        print(
                            f"Refusing to start '{endpoint.model_id}': could not safely terminate previous "
                            f"upstream process pid={sup_pid} ({err_u}). Preserving existing PID record.",
                            file=sys.stderr,
                        )
                        return 1

            if not _wait_for_port_unbind("127.0.0.1", port, timeout_sec=5.0):
                print(
                    f"Refusing to start '{endpoint.model_id}': port {port} remained bound on 127.0.0.1 after stopping previous session.",
                    file=sys.stderr,
                )
                return 1
            if upstream_port is not None and not _wait_for_port_unbind("127.0.0.1", upstream_port, timeout_sec=5.0):
                print(
                    f"Refusing to start '{endpoint.model_id}': upstream port {upstream_port} remained bound on 127.0.0.1 after stopping previous session.",
                    file=sys.stderr,
                )
                return 1

            with _pid_lock(RUNS):
                for srec in records_to_stop:
                    _unlink_pid_files_if_matching(
                        pid_file_for_model(endpoint.model_id, RUNS),
                        legacy_pid_file(RUNS),
                        endpoint.model_id,
                        str(srec.get("startup_nonce") or ""),
                    )
                session_token_file_for_model(endpoint.model_id, RUNS).unlink(missing_ok=True)

        if health(api_base_url, endpoint.api_key):
            print(
                f"Refusing to reuse server on port {port} ({api_base_url}): "
                f"no matching active PID record found for '{endpoint.model_id}'. "
                f"Stop the unmanaged process on port {port} first.",
                file=sys.stderr,
            )
            return 1

        log = RUNS / "serve.log"
        serve_env = build_serve_env(endpoint, allow_hf_online=args.allow_hf_online)
        model_pid_file = pid_file_for_model(endpoint.model_id, RUNS)
        default_pid_file = legacy_pid_file(RUNS)
        startup_nonce = secrets.token_hex(16)
        started_at_str = time.strftime("%Y-%m-%dT%H:%M:%S%z")

        prev_sigint = signal.getsignal(signal.SIGINT)
        prev_sigterm = signal.getsignal(signal.SIGTERM)
        prev_sighup = signal.getsignal(signal.SIGHUP)

        def _handle_term_signal(signum: int, _frame: Any) -> None:
            raise _SignalInterruptedError(signum)

        signal.signal(signal.SIGTERM, _handle_term_signal)
        signal.signal(signal.SIGHUP, _handle_term_signal)

        try:
            if uses_se_key_proxy:
                assert se_proxy_bin is not None and upstream_url is not None
                if _port_is_bound("127.0.0.1", port):
                    print(
                        f"Refusing to start '{endpoint.model_id}': port {port} is already bound on 127.0.0.1.",
                        file=sys.stderr,
                    )
                    return 1
                if upstream_port is not None and _port_is_bound("127.0.0.1", upstream_port):
                    print(
                        f"Refusing to start '{endpoint.model_id}': upstream port {upstream_port} is already bound on 127.0.0.1.",
                        file=sys.stderr,
                    )
                    return 1

                if not os.environ.get("FREE_INFERENCE_SE_PROXY_BIN"):
                    svc_name = str(endpoint.api_key_keychain_service)
                    ok_env, env_msg, env_payload = ensure_envelope_available_or_migrate(
                        svc_name,
                        se_proxy_bin=se_proxy_bin,
                    )
                    if not ok_env:
                        lstate = (
                            str(env_payload.get("lifecycle_state") or "none")
                            if isinstance(env_payload, dict)
                            else "none"
                        )
                        if lstate != "none" or "migration failed" in env_msg.lower():
                            print(env_msg, file=sys.stderr)
                            return 1

                token_path = session_token_file_for_model(endpoint.model_id, RUNS)
                session_token = f"se-session-{secrets.token_hex(32)}"

                upstream_proc: subprocess.Popen[Any] | None = None
                se_proc: subprocess.Popen[Any] | None = None
                tok_r = -1
                tok_w = -1
                ready_r = -1
                ready_w = -1
                provisional_record: dict[str, Any] = {
                    "model_id": endpoint.model_id,
                    "repo": endpoint.served_model_id,
                    "runtime": endpoint.runtime,
                    "api_base_url": api_base_url,
                    "port": port,
                    "pid": None,
                    "pid_lstart": None,
                    "upstream_pid": None,
                    "upstream_pid_lstart": None,
                    "upstream_port": upstream_port,
                    "upstream_url": upstream_url,
                    "session_token_file": str(token_path),
                    "max_chat_requests": args.max_chat_requests,
                    "max_tokens_cap": args.max_tokens_cap,
                    "max_request_bytes": args.max_request_bytes,
                    "ttl_seconds": args.ttl_seconds,
                    "stream_timeout_seconds": args.stream_timeout_seconds,
                    "thinking_enabled": bool(args.thinking),
                    "default_chat_params": default_chat_params,
                    "command": [],
                    "upstream_command": upstream_cmd,
                    "log": str(log),
                    "started_at": started_at_str,
                    "started_by": started_by,
                    "status": "starting",
                    "startup_nonce": startup_nonce,
                }
                try:
                    with _pid_lock(RUNS):
                        _write_pid_files(model_pid_file, default_pid_file, provisional_record)
                        _write_exclusive_session_token(token_path, session_token)
                    _after_initial_provisional_write_hook()
                    tok_r, tok_w = os.pipe()
                    ready_r, ready_w = os.pipe()

                    if upstream_cmd is not None:
                        with _pid_lock(RUNS):
                            _assert_provisional_record_active(model_pid_file, startup_nonce)
                            print("Starting upstream proxy:", " ".join(shlex.quote(part) for part in upstream_cmd))
                            isolated_upstream_home = ROOT / ".home"
                            isolated_upstream_home.mkdir(parents=True, exist_ok=True)
                            upstream_env = build_tinfoil_child_env(isolated_home=isolated_upstream_home)
                            with log.open("a") as log_fh:
                                upstream_proc = subprocess.Popen(
                                    upstream_cmd,
                                    cwd=ROOT,
                                    stdout=log_fh,
                                    stderr=subprocess.STDOUT,
                                    env=upstream_env,
                                    start_new_session=True,
                                )
                            provisional_record["upstream_pid"] = upstream_proc.pid
                            provisional_record["upstream_pid_lstart"] = _require_process_lstart(upstream_proc.pid)
                            _write_pid_files(model_pid_file, default_pid_file, provisional_record)

                        assert upstream_port is not None
                        up_deadline = time.monotonic() + 15.0
                        while time.monotonic() < up_deadline:
                            if upstream_proc.poll() is not None:
                                raise RuntimeError(
                                    f"Upstream proxy process exited immediately with code {upstream_proc.returncode}"
                                )
                            if _port_is_bound("127.0.0.1", upstream_port):
                                break
                            time.sleep(0.05)
                        else:
                            raise RuntimeError(
                                f"Upstream proxy process (pid={upstream_proc.pid}) did not bind 127.0.0.1:{upstream_port} within 15s"
                            )

                    os.write(tok_w, (session_token + "\n").encode("utf-8"))
                    os.close(tok_w)
                    tok_w = -1

                    se_cmd = [
                        str(se_proxy_bin),
                        "proxy",
                        "--service",
                        str(endpoint.api_key_keychain_service),
                        "--listen-host",
                        "127.0.0.1",
                        "--listen-port",
                        str(port),
                        "--upstream-url",
                        upstream_url,
                        "--allowed-model",
                        endpoint.served_model_id,
                        "--session-token-fd",
                        str(tok_r),
                        "--ready-fd",
                        str(ready_w),
                        "--session-token-file",
                        str(token_path),
                        "--max-chat-requests",
                        str(args.max_chat_requests),
                        "--max-tokens-cap",
                        str(args.max_tokens_cap),
                        "--max-request-bytes",
                        str(args.max_request_bytes),
                        "--ttl-seconds",
                        str(args.ttl_seconds),
                        "--stream-timeout-seconds",
                        str(args.stream_timeout_seconds),
                    ]
                    if default_chat_params:
                        se_cmd.extend(
                            [
                                "--default-chat-params-json",
                                json.dumps(default_chat_params, separators=(",", ":")),
                            ]
                        )
                    if upstream_proc is not None:
                        se_cmd.extend(["--upstream-pid", str(upstream_proc.pid)])

                    with _pid_lock(RUNS):
                        _assert_provisional_record_active(model_pid_file, startup_nonce)
                        provisional_record["command"] = se_cmd
                        print("Starting se-key-proxy (Touch ID required):", " ".join(shlex.quote(part) for part in se_cmd[:8]), "...")
                        se_child_env = build_se_key_proxy_child_env()
                        with log.open("a") as log_fh:
                            se_proc = subprocess.Popen(
                                se_cmd,
                                cwd=ROOT,
                                stdout=log_fh,
                                stderr=subprocess.STDOUT,
                                env=se_child_env,
                                pass_fds=(tok_r, ready_w),
                                start_new_session=True,
                            )
                        provisional_record["pid"] = se_proc.pid
                        provisional_record["pid_lstart"] = _require_process_lstart(se_proc.pid)
                        _write_pid_files(model_pid_file, default_pid_file, provisional_record)

                    os.close(tok_r)
                    tok_r = -1
                    os.close(ready_w)
                    ready_w = -1

                    ready_buf = b""
                    deadline = time.monotonic() + 60.0
                    while time.monotonic() < deadline:
                        rem = max(0.1, deadline - time.monotonic())
                        rlist, _, _ = select.select([ready_r], [], [], min(1.0, rem))
                        if rlist:
                            chunk = os.read(ready_r, 1024)
                            if not chunk:
                                break
                            ready_buf += chunk
                            if b"\n" in ready_buf:
                                break
                        if se_proc.poll() is not None:
                            break
                    os.close(ready_r)
                    ready_r = -1

                    ready_line = ready_buf.decode("utf-8", errors="replace").strip()
                    if not ready_line:
                        raise RuntimeError(
                            "se-key-proxy failed to unlock or bind (Touch ID cancelled or Keychain item missing)."
                        )
                    ready_obj = json.loads(ready_line)
                    if not isinstance(ready_obj, dict) or ready_obj.get("status") != "ready":
                        raise RuntimeError(f"se-key-proxy reported unexpected ready payload: {ready_line}")

                    if se_proc.poll() is not None:
                        raise RuntimeError(f"se-key-proxy exited prematurely with code {se_proc.returncode}")
                    if upstream_proc is not None and upstream_proc.poll() is not None:
                        raise RuntimeError(
                            f"Upstream proxy process exited prematurely with code {upstream_proc.returncode}"
                        )

                    with _pid_lock(RUNS):
                        _assert_provisional_record_active(model_pid_file, startup_nonce)
                        ready_record = dict(provisional_record)
                        ready_record["status"] = "ready"
                        _write_pid_files(model_pid_file, default_pid_file, ready_record)
                except BaseException as exc:
                    signal.signal(signal.SIGINT, signal.SIG_IGN)
                    signal.signal(signal.SIGTERM, signal.SIG_IGN)
                    signal.signal(signal.SIGHUP, signal.SIG_IGN)
                    for fd in (tok_r, tok_w, ready_r, ready_w):
                        if fd >= 0:
                            try:
                                os.close(fd)
                            except OSError:
                                pass
                    _terminate_proc(se_proc)
                    _terminate_proc(upstream_proc)
                    with _pid_lock(RUNS):
                        token_path.unlink(missing_ok=True)
                        _unlink_pid_files_if_matching(model_pid_file, default_pid_file, endpoint.model_id, startup_nonce)
                    if isinstance(exc, KeyboardInterrupt):
                        print(f"Interrupted while starting proxy for '{endpoint.model_id}'.", file=sys.stderr)
                        return 130
                    if isinstance(exc, _SignalInterruptedError):
                        print(f"Interrupted by signal {exc.signum} while starting proxy for '{endpoint.model_id}'.", file=sys.stderr)
                        return 128 + exc.signum
                    if isinstance(exc, SystemExit):
                        raise
                    print(f"Failed to start proxy for '{endpoint.model_id}': {exc}", file=sys.stderr)
                    return 1

                print(f"PID {se_proc.pid} (upstream_pid={provisional_record['upstream_pid']}); log {log}")
                print(f"PID file {default_pid_file} (and {model_pid_file})")
                return 0

            assert cmd is not None
            proc: subprocess.Popen[Any] | None = None
            provisional_local: dict[str, Any] = {
                "model_id": endpoint.model_id,
                "repo": endpoint.served_model_id,
                "runtime": endpoint.runtime,
                "api_base_url": api_base_url,
                "port": port,
                "pid": None,
                "pid_lstart": None,
                "command": cmd,
                "log": str(log),
                "started_at": started_at_str,
                "started_by": started_by,
                "hf_offline": serve_env.get("HF_HUB_OFFLINE") == "1",
                "status": "starting",
                "startup_nonce": startup_nonce,
            }
            try:
                with _pid_lock(RUNS):
                    _write_pid_files(model_pid_file, default_pid_file, provisional_local)
                _after_initial_provisional_write_hook()
                with _pid_lock(RUNS):
                    _assert_provisional_record_active(model_pid_file, startup_nonce)
                    print("Starting:", " ".join(shlex.quote(part) for part in cmd))
                    with log.open("a") as log_fh:
                        proc = subprocess.Popen(
                            cmd,
                            cwd=ROOT,
                            stdout=log_fh,
                            stderr=subprocess.STDOUT,
                            env=serve_env,
                            start_new_session=True,
                        )
                    ready_local = dict(provisional_local)
                    ready_local["pid"] = proc.pid
                    ready_local["pid_lstart"] = _require_process_lstart(proc.pid)
                    ready_local["status"] = "ready"
                    _write_pid_files(model_pid_file, default_pid_file, ready_local)
            except BaseException as exc:
                signal.signal(signal.SIGINT, signal.SIG_IGN)
                signal.signal(signal.SIGTERM, signal.SIG_IGN)
                signal.signal(signal.SIGHUP, signal.SIG_IGN)
                _terminate_proc(proc)
                with _pid_lock(RUNS):
                    _unlink_pid_files_if_matching(model_pid_file, default_pid_file, endpoint.model_id, startup_nonce)
                if isinstance(exc, KeyboardInterrupt):
                    print(f"Interrupted while starting '{endpoint.model_id}'.", file=sys.stderr)
                    return 130
                if isinstance(exc, _SignalInterruptedError):
                    print(f"Interrupted by signal {exc.signum} while starting '{endpoint.model_id}'.", file=sys.stderr)
                    return 128 + exc.signum
                if isinstance(exc, SystemExit):
                    raise
                print(f"Failed to start '{endpoint.model_id}': {exc}", file=sys.stderr)
                return 1

            print(f"PID {proc.pid}; log {log}")
            print(f"PID file {default_pid_file} (and {model_pid_file})")
            return 0
        finally:
            signal.signal(signal.SIGINT, prev_sigint)
            signal.signal(signal.SIGTERM, prev_sigterm)
            signal.signal(signal.SIGHUP, prev_sighup)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
