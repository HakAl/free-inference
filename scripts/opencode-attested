def _consume_handoff_token() -> tuple[bool, str | None, str | None]:
    oversize_flag = os.environ.pop("_FREE_INFERENCE_TOKEN_OVERSIZE", None)
    raw_fd = os.environ.pop("_FREE_INFERENCE_TOKEN_FD", None)
    os.environ.pop("OPENCODE_PASSWORD", None)
    os.environ.pop("OPENCODE_SERVER_PASSWORD", None)
    if oversize_flag == "1":
        os.environ.pop("LOCAL_ASSIST_SESSION_TOKEN", None)
        if raw_fd is not None:
            try:
                os.close(int(raw_fd))
            except (OSError, ValueError):
                pass
        return False, None, "Refusing LOCAL_ASSIST_SESSION_TOKEN exceeding 512 bytes."
    if raw_fd is not None:
        os.environ.pop("LOCAL_ASSIST_SESSION_TOKEN", None)
        try:
            fd = int(raw_fd)
        except ValueError:
            return False, None, "Invalid _FREE_INFERENCE_TOKEN_FD descriptor."
        if fd < 3:
            return False, None, "Refusing _FREE_INFERENCE_TOKEN_FD below fd 3."
        try:
            os.set_inheritable(fd, False)
            data = os.read(fd, 4096)
        except OSError as exc:
            return False, None, f"Failed to read _FREE_INFERENCE_TOKEN_FD: {exc}"
        finally:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            tok = data.decode("utf-8").strip()
        except UnicodeDecodeError:
            return False, None, "Invalid UTF-8 in _FREE_INFERENCE_TOKEN_FD."
        if not tok or len(data) > 512:
            return False, None, "Empty or oversized token in _FREE_INFERENCE_TOKEN_FD."
        return True, tok, None

    if "LOCAL_ASSIST_SESSION_TOKEN" in os.environ:
        inproc_tok = os.environ.pop("LOCAL_ASSIST_SESSION_TOKEN", "").strip()
        if inproc_tok and len(inproc_tok.encode("utf-8")) > 512:
            return False, None, "Refusing LOCAL_ASSIST_SESSION_TOKEN exceeding 512 bytes."
        return True, (inproc_tok or None), None

    return True, None, None


def _resolve_local_assist_base_url() -> tuple[str, int]:
    raw_override = os.environ.get(LOCAL_ASSIST_BASE_URL_ENV_VAR, "").strip()
    if not raw_override:
        return RUNG1_LOCAL_ASSIST_BASE_URL, 8080
    parsed = urlparse(raw_override)
    if (
        parsed.scheme != "http"
        or parsed.hostname not in ("127.0.0.1", "localhost", "::1")
        or parsed.port is None
        or not (1 <= int(parsed.port) <= 65535)
        or parsed.username is not None
        or parsed.password is not None
    ):
        raise LocalAssistError(
            "trust_tier_blocked",
            f"{LOCAL_ASSIST_BASE_URL_ENV_VAR} must be an explicit loopback http URL with port "
            f"(127.0.0.1, localhost, or ::1), got {raw_override!r}.",
        )
    return raw_override, int(parsed.port)


def _resolve_isolated_home() -> Path:
    raw = os.environ.get(ISOLATED_HOME_ENV_VAR, "").strip()
    if raw:
        return Path(raw).expanduser().resolve()
    return DEFAULT_ISOLATED_HOME


def _check_owned_directory_for_envelope(path: Path, *, require_mode_0700: bool) -> bool:
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        return False
    if hasattr(os, "geteuid") and st.st_uid != os.geteuid():
        return False
    if require_mode_0700:
        if (st.st_mode & 0o077) != 0:
            return False
    elif (st.st_mode & 0o022) != 0:
        return False
    return True


def _resolve_production_envelope_dir(envelope_dir: Path | None) -> Path | None:
    if envelope_dir is not None:
        return (
            envelope_dir
            if _check_owned_directory_for_envelope(envelope_dir, require_mode_0700=True)
            else None
        )
    # Intentionally ignore FREE_INFERENCE_SE_ENVELOPE_DIR: production bin/se-key-proxy
    # compiles that override out outside #if SE_KEY_TESTING and resolves envelopes
    # exclusively from getpwuid(geteuid()).pw_dir/.config/free-inference/se-envelopes.
    if pwd is None or not hasattr(os, "geteuid"):
        return None
    try:
        home_raw = pwd.getpwuid(os.geteuid()).pw_dir
    except (KeyError, OSError):
        return None
    if not isinstance(home_raw, str) or not home_raw.startswith("/"):
        return None
    segments = [seg for seg in home_raw.split("/") if seg]
    if not segments or ".." in segments or "." in segments:
        return None
    home_dir = Path("/" + "/".join(segments))
    dot_config = home_dir / ".config"
    free_inf_dir = dot_config / "free-inference"
    env_dir = free_inf_dir / "se-envelopes"
    if not _check_owned_directory_for_envelope(home_dir, require_mode_0700=False):
        return None
    if not _check_owned_directory_for_envelope(dot_config, require_mode_0700=False):
        return None
    if not _check_owned_directory_for_envelope(free_inf_dir, require_mode_0700=True):
        return None
    if not _check_owned_directory_for_envelope(env_dir, require_mode_0700=True):
        return None
    return env_dir


def _entry_has_sealed_envelope(entry: dict[str, Any], env_dir: Path | None) -> bool:
    if env_dir is None:
        return False
    pf = entry.get("promptfoo_provider")
    if not isinstance(pf, dict):
        return False
    service = str(pf.get("apiKeyKeychainService") or "").strip()
    if not service:
        return False
    stem = hashlib.sha256(f"{service}\0{DEFAULT_ENVELOPE_ACCOUNT}".encode("utf-8")).hexdigest()
    env_file = env_dir / f"{stem}.json"
    try:
        st = os.lstat(env_file)
    except OSError:
        return False
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        return False
    if hasattr(os, "geteuid") and st.st_uid != os.geteuid():
        return False
    if (st.st_mode & 0o077) != 0 or st.st_size <= 0:
        return False
    state_file = env_dir / f"{stem}.state.json"
    try:
        st_state = os.lstat(state_file)
    except FileNotFoundError:
        return True
    except OSError:
        return False
    if stat.S_ISLNK(st_state.st_mode) or not stat.S_ISREG(st_state.st_mode):
        return False
    if hasattr(os, "geteuid") and st_state.st_uid != os.geteuid():
        return False
    if (st_state.st_mode & 0o077) != 0:
        return False
    try:
        state_obj = json.loads(state_file.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(state_obj, dict) or state_obj.get("lifecycle_state") == "deleted":
        return False
    return True


def _entry_has_installed_proxy_binary(entry: dict[str, Any], eff_root: Path) -> bool:
    raw_cmd = entry.get("serve_command")
    if not isinstance(raw_cmd, str) or not raw_cmd.strip():
        return False
    try:
        tokens = shlex.split(raw_cmd)
    except ValueError:
        return False
    if not tokens:
        return False
    bin_token = tokens[0]
    if "/" in bin_token:
        cand = Path(bin_token)
        if not cand.is_absolute():
            cand = eff_root / cand
        try:
            st = os.stat(cand)
        except OSError:
            return False
        return stat.S_ISREG(st.st_mode) and os.access(cand, os.X_OK)
    return bool(shutil.which(bin_token))


def _entry_has_verified_ready_session(model_id: str, eff_runs: Path) -> bool:
    rec = read_pid_record_for_model(model_id, runs_dir=eff_runs)
    if not isinstance(rec, dict):
        return False
    if str(rec.get("model_id") or "") != model_id:
        return False
    if rec.get("status") == "starting":
        return False
    if classify_pid_identity(rec.get("pid"), rec.get("pid_lstart")) != "matched":
        return False
    if rec.get("upstream_pid") is not None:
        if classify_pid_identity(rec.get("upstream_pid"), rec.get("upstream_pid_lstart")) != "matched":
            return False
    return True


@contextlib.contextmanager
def _scoped_admission_env(*, allow_uncleared_model: bool):
    prev_tee = os.environ.get("LOCAL_ASSIST_ALLOW_ATTESTED_TEE")
    prev_uncleared = os.environ.get("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE")
    os.environ["LOCAL_ASSIST_ALLOW_ATTESTED_TEE"] = "1"
    if allow_uncleared_model:
        os.environ["LOCAL_ASSIST_ALLOW_UNCLEARED_TEE"] = "1"
    else:
        os.environ.pop("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE", None)
    try:
        yield
    finally:
        if prev_tee is None:
            os.environ.pop("LOCAL_ASSIST_ALLOW_ATTESTED_TEE", None)
        else:
            os.environ["LOCAL_ASSIST_ALLOW_ATTESTED_TEE"] = prev_tee
        if prev_uncleared is None:
            os.environ.pop("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE", None)
        else:
            os.environ["LOCAL_ASSIST_ALLOW_UNCLEARED_TEE"] = prev_uncleared


def resolve_default_attested_model_id(
    models_list: list[dict[str, Any]] | None = None,
    *,
    env: Mapping[str, str] | None = None,
    root_dir: Path | None = None,
    runs_dir: Path | None = None,
    envelope_dir: Path | None = None,
    prefer_host_state: bool | None = None,
) -> str:
    models = models_list if models_list is not None else load_models()
    cleared_entries: list[tuple[str, dict[str, Any], int]] = []
    candidate_ids: list[str] = []
    pinned_entries: list[tuple[str, int]] = []

    for entry in models:
        routing = entry.get("routing")
        raw_dpa = routing.get("default_private_attested", False) if isinstance(routing, dict) else False
        if not isinstance(raw_dpa, bool):
            raise RegistryError(
                f"Model {entry.get('id')}: routing.default_private_attested must be a boolean, got {raw_dpa!r}."
            )
        rt = entry.get("remote_trust")
        if not isinstance(rt, dict):
            if raw_dpa is True:
                raise LocalAssistError(
                    "routing_gate_blocked",
                    f"Model '{entry.get('id')}' sets routing.default_private_attested=true outside Rung 2/3.",
                    details={"model_id": entry.get("id")},
                )
            continue
        raw_tier = rt.get("tier")
        tier = LEGACY_TIER_ALIASES.get(str(raw_tier), raw_tier) if isinstance(raw_tier, str) else raw_tier
        if tier not in ATTESTED_ENCLAVE_TIERS:
            if raw_dpa is True:
                raise LocalAssistError(
                    "routing_gate_blocked",
                    f"Model '{entry.get('id')}' sets routing.default_private_attested=true outside Rung 2/3.",
                    details={"model_id": entry.get("id")},
                )
            continue
        mid = str(entry.get("id") or "").strip()
        if not mid:
            continue
        rung = DATA_CONTROL_RUNGS.index(str(tier)) + 1
        if entry.get("status") == "archived" or is_model_effectively_deprecated(
            bool(entry.get("deprecated") is True),
            entry.get("deprecation_date"),
        ):
            if raw_dpa is True:
                raise LocalAssistError(
                    "routing_gate_blocked",
                    f"Model '{mid}' sets routing.default_private_attested=true while archived or deprecated.",
                    details={"model_id": mid},
                )
            continue
        pa = routing.get("private_attested") if isinstance(routing, dict) else "blocked"
        if pa == "cleared":
            cleared_entries.append((mid, entry, rung))
            if raw_dpa is True:
                pinned_entries.append((mid, rung))
        else:
            if raw_dpa is True:
                raise LocalAssistError(
                    "routing_gate_blocked",
                    f"Model '{mid}' sets routing.default_private_attested=true while routing.private_attested={pa!r}.",
                    details={"model_id": mid, "private_attested": pa},
                )
            candidate_ids.append(mid)

    if len(pinned_entries) > 1:
        dup_ids = [mid for mid, _ in pinned_entries]
        raise LocalAssistError(
            "routing_gate_blocked",
            f"Multiple Rung 2/3 models set routing.default_private_attested=true ({dup_ids}); "
            "at most one cleared model may be pinned as the catalog default.",
            details={"pinned_models": dup_ids},
        )

    if not cleared_entries:
        raise LocalAssistError(
            "routing_gate_blocked",
            "No Rung 2/3 model in models.yaml is currently cleared for private-attested routing "
            "(routing.private_attested='cleared' requires passing automated sanity, v1 10/10, "
            f"tools 4/4, and opencode-smoke). Registered Rung 2/3 candidates: {candidate_ids}. "
            "To run an uncleared candidate explicitly, pass: "
            "./scripts/opencode-attested --model <model-id> --allow-uncleared-model",
            details={"candidate_models": candidate_ids},
        )

    eff_env = os.environ if env is None else env
    raw_env_model = eff_env.get(DEFAULT_ATTESTED_MODEL_ENV_VAR)
    if raw_env_model is not None and str(raw_env_model).strip():
        requested_id = str(raw_env_model).strip()
        cleared_ids = [mid for mid, _, _ in cleared_entries]
        if requested_id not in cleared_ids:
            raise LocalAssistError(
                "routing_gate_blocked",
                f"{DEFAULT_ATTESTED_MODEL_ENV_VAR}={requested_id!r} is not an active, non-deprecated "
                f"Rung 2/3 model cleared for private-attested routing (cleared models: {cleared_ids}).",
                details={
                    "requested_model": requested_id,
                    "cleared_models": cleared_ids,
                },
            )
        return requested_id

    best_rung = min(rung for _, _, rung in cleared_entries)
    if len(pinned_entries) == 1:
        pinned_id, pinned_rung = pinned_entries[0]
        if pinned_rung != best_rung:
            best_ids = [mid for mid, _, r in cleared_entries if r == best_rung]
            raise LocalAssistError(
                "routing_gate_blocked",
                f"Model '{pinned_id}' (Rung {pinned_rung}) sets routing.default_private_attested=true, "
                f"but higher-control Rung {best_rung} cleared model(s) exist ({best_ids}). "
                f"Update routing.default_private_attested in models.yaml or pass --model / {DEFAULT_ATTESTED_MODEL_ENV_VAR} explicitly.",
                details={
                    "pinned_model": pinned_id,
                    "pinned_rung": pinned_rung,
                    "best_rung": best_rung,
                    "best_rung_models": best_ids,
                },
            )
        return pinned_id

    pool: list[tuple[str, dict[str, Any], int]] = [
        item for item in cleared_entries if item[2] == best_rung
    ]
    if len(pool) == 1:
        return pool[0][0]

    use_host_state = (models_list is None) if prefer_host_state is None else bool(prefer_host_state)
    if use_host_state and len(pool) > 1:
        eff_root = root_dir if root_dir is not None else ROOT
        eff_runs = (
            runs_dir
            if runs_dir is not None
            else (eff_root / "runs" if root_dir is not None else DEFAULT_RUNS_DIR)
        )

        live_subset = [item for item in pool if _entry_has_verified_ready_session(item[0], eff_runs)]
        if live_subset:
            pool = live_subset

        if len(pool) > 1:
            bin_subset = [item for item in pool if _entry_has_installed_proxy_binary(item[1], eff_root)]
            if bin_subset:
                pool = bin_subset

        if len(pool) > 1:
            eff_env_dir = _resolve_production_envelope_dir(envelope_dir)
            env_subset = [item for item in pool if _entry_has_sealed_envelope(item[1], eff_env_dir)]
            if env_subset:
                pool = env_subset

    return pool[-1][0]


def validate_private_attested_endpoint(
    endpoint: EndpointConfig,
    *,
    allow_uncleared_model: bool = False,
    allow_deprecated_model: bool = False,
    err_stream: Any = None,
) -> None:
    if endpoint.trust_tier == "local":
        raise LocalAssistError(
            "trust_tier_blocked",
            f"scripts/opencode-attested is strictly for Rung 2/3 attested enclave proxies, "
            f"got '{endpoint.model_id}' with trust_tier='local'. "
            "Use ./scripts/opencode-local for Rung 1 local models.",
            details={
                "model_id": endpoint.model_id,
                "trust_tier": endpoint.trust_tier,
            },
        )
    if (
        endpoint.trust_tier not in ATTESTED_ENCLAVE_TIERS
        or endpoint.runtime != "proxy"
        or not endpoint.is_local_host
        or not endpoint.attestation_method
        or not endpoint.api_key_keychain_service
    ):
        raise LocalAssistError(
            "trust_tier_blocked",
            f"scripts/opencode-attested requires a Rung 2/3 attested enclave proxy bound to localhost "
            f"with apiKeyKeychainService, got '{endpoint.model_id}' "
            f"(trust_tier='{endpoint.trust_tier}', runtime='{endpoint.runtime}').",
            details={
                "model_id": endpoint.model_id,
                "trust_tier": endpoint.trust_tier,
                "runtime": endpoint.runtime,
            },
        )
    check_endpoint_lifecycle_status(
        endpoint,
        allow_deprecated_model=allow_deprecated_model,
        err_stream=err_stream,
    )
    if not bool(endpoint.capabilities.get("tool_calling")):
        raise LocalAssistError(
            "capability_missing",
            f"Model '{endpoint.model_id}' does not declare capabilities.tool_calling=true in models.yaml.",
            details={
                "model_id": endpoint.model_id,
                "capabilities": endpoint.capabilities,
            },
        )

    with _scoped_admission_env(allow_uncleared_model=allow_uncleared_model):
        check_private_coding_admission(endpoint)

    if endpoint.routing_private_attested != "cleared":
        out = err_stream if err_stream is not None else sys.stderr
        print(
            f"WARNING: Running private-attested with uncleared candidate model '{endpoint.model_id}' "
            f"(routing.private_attested={endpoint.routing_private_attested!r}).",
            file=out,
        )


def default_context_limit_for_endpoint(endpoint: EndpointConfig) -> int:
    if endpoint.context_window is not None and endpoint.context_window > 0:
        return int(endpoint.context_window)
    return DEFAULT_CONTEXT_LIMIT


def compute_worst_case_session_usd(
    endpoint: EndpointConfig,
    *,
    max_chat_requests: int = DEFAULT_MAX_CHAT_REQUESTS,
    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
    max_tokens_cap: int = DEFAULT_MAX_TOKENS_CAP,
) -> dict[str, Any]:
    if max_chat_requests <= 0 or max_request_bytes <= 0 or max_tokens_cap <= 0:
        raise ValueError(
            "max_chat_requests, max_request_bytes, and max_tokens_cap must be positive integers"
        )
    pricing = endpoint.pricing_per_m_tokens
    if (
        not isinstance(pricing, dict)
        or "input" not in pricing
        or "output" not in pricing
    ):
        raise LocalAssistError(
            "spend_gate_blocked",
            f"Model '{endpoint.model_id}' is missing remote_trust.pricing_per_m_tokens.input/output "
            "in models.yaml; cannot compute worst-case session spend ceiling.",
            details={"model_id": endpoint.model_id},
        )
    input_price = float(pricing["input"])
    output_price = float(pricing["output"])
    worst_input_tokens_per_req = int(
        math.ceil(max_request_bytes / WORST_CASE_BYTES_PER_TOKEN)
    )
    worst_input_usd = (
        max_chat_requests * worst_input_tokens_per_req * input_price
    ) / 1_000_000.0
    worst_output_usd = (
        max_chat_requests * max_tokens_cap * output_price
    ) / 1_000_000.0
    worst_total_usd = worst_input_usd + worst_output_usd
    return {
        "model_id": endpoint.model_id,
        "max_chat_requests": int(max_chat_requests),
        "max_request_bytes": int(max_request_bytes),
        "max_tokens_cap": int(max_tokens_cap),
        "worst_input_tokens_per_req": worst_input_tokens_per_req,
        "input_price_per_m": input_price,
        "output_price_per_m": output_price,
        "worst_input_usd": round(worst_input_usd, 6),
        "worst_output_usd": round(worst_output_usd, 6),
        "worst_total_usd": round(worst_total_usd, 6),
    }


def _positive_finite_float(raw: str) -> float:
    try:
        val = float(raw)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(
            f"must be a finite positive number, got {raw!r}"
        ) from exc
    if not math.isfinite(val) or val <= 0:
        raise argparse.ArgumentTypeError(
            f"must be a finite positive number, got {raw!r}"
        )
    return val


def check_session_spend_ceiling(
    endpoint: EndpointConfig,
    *,
    max_chat_requests: int = DEFAULT_MAX_CHAT_REQUESTS,
    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
    max_tokens_cap: int = DEFAULT_MAX_TOKENS_CAP,
    max_session_usd: float | None = DEFAULT_MAX_SESSION_USD,
    attached: bool = False,
) -> dict[str, Any]:
    if max_session_usd is not None:
        if (
            isinstance(max_session_usd, bool)
            or not isinstance(max_session_usd, (int, float))
            or not math.isfinite(float(max_session_usd))
            or float(max_session_usd) <= 0
        ):
            raise LocalAssistError(
                "spend_ceiling_invalid",
                f"Refusing to launch '{endpoint.model_id}': --max-session-usd must be a finite "
                f"positive USD ceiling, got {max_session_usd!r}.",
                details={"model_id": endpoint.model_id, "max_session_usd": max_session_usd},
            )
    est = compute_worst_case_session_usd(
        endpoint,
        max_chat_requests=max_chat_requests,
        max_request_bytes=max_request_bytes,
        max_tokens_cap=max_tokens_cap,
    )
    if not math.isfinite(float(est["worst_total_usd"])):
        raise LocalAssistError(
            "spend_ceiling_invalid",
            f"Refusing to launch '{endpoint.model_id}': computed worst-case session cost is non-finite "
            f"({est['worst_total_usd']!r}).",
            details={**est, "max_session_usd": max_session_usd, "attached": attached},
        )
    if max_session_usd is not None and est["worst_total_usd"] > float(max_session_usd):
        if attached:
            raise LocalAssistError(
                "spend_ceiling_exceeded",
                f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
                f"the running session's caps (max_chat_requests={max_chat_requests}, "
                f"max_request_bytes={max_request_bytes}, max_tokens_cap={max_tokens_cap}) "
                f"have a worst-case cost of ${est['worst_total_usd']:.2f}, which exceeds "
                f"--max-session-usd ${max_session_usd:.2f}. Run './scripts/stop-model {endpoint.model_id}' "
                "and relaunch so opencode-attested starts a proxy with bounded caps, or pass a "
                "higher --max-session-usd explicitly.",
                details={**est, "max_session_usd": max_session_usd, "attached": True},
            )
        raise LocalAssistError(
            "spend_ceiling_exceeded",
            f"Refusing to launch '{endpoint.model_id}': worst-case session cost from caps "
            f"(max_chat_requests={max_chat_requests}, max_request_bytes={max_request_bytes} "
            f"[~{est['worst_input_tokens_per_req']} input tokens/req], max_tokens_cap={max_tokens_cap} "
            f"at ${est['input_price_per_m']:.2f}/${est['output_price_per_m']:.2f} per 1M tokens) "
            f"is ${est['worst_total_usd']:.2f}, which exceeds --max-session-usd ${max_session_usd:.2f}. "
            "Pass lower --max-chat-requests / --max-request-bytes / --max-tokens-cap, or raise "
            "--max-session-usd explicitly.",
            details={**est, "max_session_usd": max_session_usd, "attached": False},
        )
    return est


def _extract_attached_session_caps(
    endpoint: EndpointConfig,
    active_rec: dict[str, Any] | None,
    *,
    runs_dir: Path | None = None,
) -> tuple[int, int, int, int]:
    if not isinstance(active_rec, dict):
        raise LocalAssistError(
            "spend_ceiling_exceeded",
            f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
            "no PID record with bounded spend caps was found.",
            details={"model_id": endpoint.model_id, "attached": True},
        )
    raw_reqs = active_rec.get("max_chat_requests")
    raw_bytes = active_rec.get("max_request_bytes")
    raw_tokens = active_rec.get("max_tokens_cap")
    raw_ttl = active_rec.get("ttl_seconds")
    # A renewal changes the live window without rewriting the launch record.
    from local_assist.session import status_for_record
    live = (status_for_record(active_rec, _effective_runs_dir(runs_dir))
            if active_rec.get('model_id') and active_rec.get('repo') else {'state': 'UNKNOWN'})
    if live['state'] == 'ON':
        raw_ttl = live['window_seconds']
    if (
        not isinstance(raw_reqs, int)
        or isinstance(raw_reqs, bool)
        or raw_reqs <= 0
        or not isinstance(raw_bytes, int)
        or isinstance(raw_bytes, bool)
        or raw_bytes <= 0
        or not isinstance(raw_tokens, int)
        or isinstance(raw_tokens, bool)
        or raw_tokens <= 0
        or not isinstance(raw_ttl, int)
        or isinstance(raw_ttl, bool)
        or raw_ttl <= 0
    ):
        raise LocalAssistError(
            "spend_ceiling_exceeded",
            f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
            f"the running session has unbounded or missing spend caps in its PID record "
            f"(max_chat_requests={raw_reqs!r}, max_request_bytes={raw_bytes!r}, "
            f"max_tokens_cap={raw_tokens!r}, ttl_seconds={raw_ttl!r}; max_tokens_cap=0 means unclamped output tokens "
            f"in se-key-proxy). Run './scripts/stop-model {endpoint.model_id}' and relaunch "
            "so opencode-attested starts a proxy with bounded caps.",
            details={
                "model_id": endpoint.model_id,
                "attached": True,
                "max_chat_requests": raw_reqs,
                "max_request_bytes": raw_bytes,
                "max_tokens_cap": raw_tokens,
                "ttl_seconds": raw_ttl,
            },
        )
    return int(raw_reqs), int(raw_bytes), int(raw_tokens), int(raw_ttl)


def format_session_banner(
    endpoint: EndpointConfig,
    session_meta: dict[str, Any],
    *,
    max_session_usd: float | None,
) -> str:
    mode_str = "attached to active proxy" if session_meta.get("attached") else "started proxy"
    ceiling_str = (
        f"enforced --max-session-usd ${max_session_usd:.2f}"
        if max_session_usd is not None
        else "no pre-flight --max-session-usd cap set"
    )
    ttl_val = session_meta["ttl_seconds"]
    ttl_str = str(ttl_val)
    started_at = session_meta.get("started_at")
    live_status = session_meta.get('live_status')
    if isinstance(live_status, dict) and live_status.get('state') == 'ON':
        ttl_str = f"{live_status['window_seconds']} ({live_status['remaining_seconds']}s remaining)"
        live_cap_micro = live_status.get("max_actual_micro_usd")
        if type(live_cap_micro) is int and live_cap_micro >= 1:
            from local_assist.session import format_micro_usd_decimal
            ceiling_str += f"; enforced live --max-actual-usd ${format_micro_usd_decimal(live_cap_micro)}"
    elif session_meta.get("attached") and isinstance(started_at, str) and started_at.strip():
        try:
            started_dt = datetime.strptime(started_at.strip(), "%Y-%m-%dT%H:%M:%S%z")
            now_dt = datetime.now(started_dt.tzinfo)
            elapsed = max(0, int(now_dt.timestamp() - started_dt.timestamp()))
            rem_sec = max(0, int(ttl_val) - elapsed)
            rem_h = rem_sec // 3600
            rem_m = (rem_sec % 3600) // 60
            ttl_str = f"{ttl_val} (~{rem_h}h {rem_m}m remaining)"
        except Exception:
            ttl_str = str(ttl_val)
    lines = [
        f"[private-attested] Model: {endpoint.model_id} (served_model_id={endpoint.served_model_id}, {mode_str} at {endpoint.api_base_url})",
        f"[private-attested] Data-control rung: Rung {endpoint.data_control_rung} ({endpoint.trust_tier}, attestation={endpoint.attestation_method}, usage_policy={endpoint.usage_policy})",
        f"[private-attested] Data-control notice: workspace files read by the agent, approved bash outputs, conversation history, and local_assist MCP tool outputs (auto-allowed via 'local_assist*: allow' without an interactive prompt) returned to the planner are sent to the attested enclave under Rung {endpoint.data_control_rung} and {endpoint.usage_policy}.",
        f"[private-attested] Session caps: max_chat_requests={session_meta['max_chat_requests']} (includes small_model title requests), max_tokens_cap={session_meta['max_tokens_cap']}, max_request_bytes={session_meta['max_request_bytes']}, ttl_seconds={ttl_str}",
        f"[private-attested] Pricing: ${session_meta['input_price_per_m']:.2f}/1M input, ${session_meta['output_price_per_m']:.2f}/1M output ({ceiling_str})",
    ]
    from local_assist.session import format_status
    live = session_meta.get('live_status') or {'state': 'UNKNOWN', 'model_id': endpoint.model_id}
    lines.append('[private-attested] Session: ' + format_status(live))
    if session_meta.get("low_caps_warning"):
        lines.append(
            f"[private-attested] WARNING: Attached session has eval-sized caps "
            f"(max_chat_requests={session_meta['max_chat_requests']}, "
            f"max_tokens_cap={session_meta['max_tokens_cap']}, "
            f"max_request_bytes={session_meta['max_request_bytes']}). "
            f"For interactive coding, run: ./scripts/opencode-attested --model {endpoint.model_id} --refresh-session"
        )
    lines.append(
        f"[private-attested] Session controls: ./scripts/session status|renew|stop --model {endpoint.model_id}"
    )
    return "\n".join(lines)


def render_private_attested_config(
    endpoint: EndpointConfig,
    template_text: str | None = None,
    *,
    context_limit: int | None = None,
    output_limit: int = DEFAULT_OUTPUT_LIMIT,
    max_tokens_cap: int | None = None,
    max_request_bytes: int | None = None,
    edit_permission: str = "ask",
    bash_permission: str = "ask",
    allow_subagents: bool = False,
    plugins: Sequence[str] = (),
    local_assist_base_url: str = RUNG1_LOCAL_ASSIST_BASE_URL,
    lab_python: Path | None = None,
    lab_root: Path | None = None,
    workspace_dir: Path | None = None,
    api_base_url_override: str | None = None,
    api_key_override: str | None = None,
) -> str:
    if edit_permission not in ("ask", "allow", "deny"):
        raise ValueError(f"Invalid edit_permission: {edit_permission}")
    if bash_permission not in ("ask", "allow", "deny"):
        raise ValueError(f"Invalid bash_permission: {bash_permission}")
    effective_context_limit = (
        context_limit
        if context_limit is not None
        else default_context_limit_for_endpoint(endpoint)
    )
    effective_output_limit = output_limit
    if max_tokens_cap is not None and max_tokens_cap > 0:
        effective_output_limit = min(effective_output_limit, int(max_tokens_cap))
    if max_request_bytes is not None and max_request_bytes > 0:
        effective_context_limit = min(effective_context_limit, max(1, int(max_request_bytes) // 6))
    if effective_context_limit <= 0 or effective_output_limit <= 0:
        raise ValueError("context_limit and output_limit must be positive integers")

    tmpl = template_text if template_text is not None else TEMPLATE_CONFIG.read_text()
    api_key_val = (
        api_key_override
        if api_key_override is not None
        else f"{{env:{SESSION_TOKEN_ENV_VAR}}}"
    )
    effective_base_url = api_base_url_override or endpoint.api_base_url
    effective_python = lab_python or (
        VENV_PYTHON if VENV_PYTHON.exists() else Path(sys.executable)
    )
    effective_root = lab_root or ROOT
    effective_workspace = (workspace_dir or Path.cwd()).resolve()
    trust_label = f"Rung {endpoint.data_control_rung} {endpoint.trust_tier}"
    subagent_enabled_str = "true" if allow_subagents else "false"
    subagent_perm_str = "allow" if allow_subagents else "deny"
    plugins_json_str = json.dumps([str(p) for p in plugins])

    rendered = (
        tmpl.replace("__PLUGINS_JSON__", plugins_json_str)
        .replace("__API_BASE_URL__", _json_escape(effective_base_url))
        .replace("__API_KEY_VALUE__", _json_escape(api_key_val))
        .replace("__SERVED_MODEL_ID__", _json_escape(endpoint.served_model_id))
        .replace("__MODEL_ID__", _json_escape(endpoint.model_id))
        .replace("__TRUST_TIER__", _json_escape(trust_label))
        .replace("__CONTEXT_LIMIT__", str(int(effective_context_limit)))
        .replace("__OUTPUT_LIMIT__", str(int(effective_output_limit)))
        .replace("__EDIT_PERMISSION__", _json_escape(edit_permission))
        .replace("__BASH_PERMISSION__", _json_escape(bash_permission))
        .replace("__SUBAGENT_ENABLED__", subagent_enabled_str)
        .replace("__SUBAGENT_PERMISSION__", _json_escape(subagent_perm_str))
        .replace("__LOCAL_ASSIST_BASE_URL__", _json_escape(local_assist_base_url))
        .replace("__LAB_PYTHON__", _json_escape(effective_python))
        .replace("__LAB_ROOT__", _json_escape(effective_root))
        .replace("__WORKSPACE_DIR__", _json_escape(effective_workspace))
    )
    json.loads(rendered)
    return rendered


def build_private_attested_env(
    workspace_dir: Path,
    isolated_home: Path,
    opencode_config_path: Path,
    endpoint: EndpointConfig,
    *,
    local_assist_base_url: str = RUNG1_LOCAL_ASSIST_BASE_URL,
    preserve_host_home: bool = False,
    base_env: dict[str, str] | None = None,
) -> dict[str, str]:
    if not endpoint.api_key or not endpoint.api_key.startswith("se-session-"):
        raise LocalAssistError(
            "session_token_missing",
            f"Model '{endpoint.model_id}' does not have an active se-session-* token; "
            f"run './scripts/serve-model {endpoint.model_id}' first.",
            details={"model_id": endpoint.model_id},
        )
    env = build_isolated_opencode_env(
        workspace_dir,
        isolated_home,
        opencode_config_path,
        local_assist_base_url=local_assist_base_url,
        preserve_host_home=preserve_host_home,
        base_env=base_env,
    )
    # Never export session tokens, control passwords, or TEE admission flags to child environments.
    for secret_key in (
        SESSION_TOKEN_ENV_VAR,
        "OPENCODE_PASSWORD",
        "OPENCODE_SERVER_PASSWORD",
        "_FREE_INFERENCE_TOKEN_FD",
        "_FREE_INFERENCE_TOKEN_OVERSIZE",
        "LOCAL_ASSIST_ALLOW_ATTESTED_TEE",
        "LOCAL_ASSIST_ALLOW_UNCLEARED_TEE",
    ):
        env.pop(secret_key, None)
    return env


def ensure_model_served(
    endpoint: EndpointConfig,
    *,
    no_serve: bool = False,
    refresh_session: bool = False,
    wait_seconds: float = DEFAULT_WAIT_SECONDS,
    max_chat_requests: int = DEFAULT_MAX_CHAT_REQUESTS,
    max_tokens_cap: int = DEFAULT_MAX_TOKENS_CAP,
    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
    ttl_seconds: int = DEFAULT_TTL_SECONDS,
    stream_timeout_seconds: int = DEFAULT_STREAM_TIMEOUT_SECONDS,
    max_session_usd: float | None = DEFAULT_MAX_SESSION_USD,
    max_actual_micro_usd: int | None = None,
    inherit_attached_session_caps: bool = False,
    explicit_port: int | None = None,
    explicit_cap_flags: Any = (),
    thinking: bool = False,
    explicit_thinking: bool = False,
    handoff_token: str | None = None,
    runs_dir: Path | None = None,
    publish_pointer: bool | None = None,
    run_cmd: Any = None,
) -> tuple[bool, str | None, dict[str, Any] | None]:
    use_default_runner = run_cmd is None
    actual_run_cmd = subprocess.run if use_default_runner else run_cmd
    if refresh_session and no_serve:
        return (
            False,
            "Refusing --refresh-session (--restart) with --no-serve: refreshing a session requires starting a server/proxy.",
            None,
        )

    # Validate requested caps against spend ceiling before touching any server or Touch ID
    try:
        cli_est = check_session_spend_ceiling(
            endpoint,
            max_chat_requests=max_chat_requests,
            max_request_bytes=max_request_bytes,
            max_tokens_cap=max_tokens_cap,
            max_session_usd=max_session_usd,
            attached=False,
        )
    except LocalAssistError as exc:
        return False, str(exc), None

    verify_script = str(ROOT / "scripts" / "verify-served-model")
    serve_script = str(ROOT / "scripts" / "serve-model")
    stop_script = str(ROOT / "scripts" / "stop-model")

    try:
        eff_runs_dir = _effective_runs_dir(runs_dir)
    except RegistryError as exc:
        return False, str(exc), None
    st_boot = get_active_bootstrap_state()
    in_custody = (st_boot is not None and st_boot.custody_mode) or is_custody_tree(ROOT)
    pinned_stat: tuple[int, int] | None = None
    if use_default_runner and not in_custody:
        if st_boot is not None and st_boot.cli_runs_dir is not None:
            ex_init, ex_err = inspect_existing_runs_dir(
                eff_runs_dir,
                expected_stat=st_boot.cli_runs_stat,
                label="--runs-dir",
            )
            if ex_err is not None or ex_init is None or ex_init.stat_id is None:
                return False, ex_err or "Invalid --runs-dir.", None
            eff_runs_dir = ex_init.path
            pinned_stat = ex_init.stat_id
        else:
            v_init, v_err = validate_creatable_runs_dir(
                eff_runs_dir,
                label="FREE_INFERENCE_RUNS_DIR",
            )
            if v_err is not None or v_init is None:
                return False, v_err or "Invalid session store directory.", None
            eff_runs_dir = v_init.path
            pinned_stat = v_init.stat_id
    should_publish_pointer = (
        (not in_custody and bool(publish_pointer))
        if publish_pointer is not None
        else (
            not in_custody
            and (st_boot is None or st_boot.cli_runs_dir is None)
            and runs_dir is None
            and (
                True
                if (st_boot is not None and st_boot.worker_or_reap_cli)
                else not bool(os.environ.get("FREE_INFERENCE_RUNS_DIR", "").strip())
            )
        )
    )

    def _is_python_entrypoint(script_path: str) -> bool:
        try:
            with open(script_path, "rb") as fh:
                head = fh.readline(128)
            return head.startswith(b"#!") and b"python" in head
        except OSError:
            return True

    def _invoke_verify(verify_cmd_args: list[str]) -> Any:
        eff_verify_args = verify_cmd_args
        if use_default_runner:
            extra_v: list[str] = []
            if st_boot is not None and st_boot.launcher_site_packages is not None:
                extra_v.extend(["--launcher-site-packages", str(st_boot.launcher_site_packages)])
            if not in_custody:
                extra_v.extend(["--runs-dir", str(eff_runs_dir)])
                if pinned_stat is None:
                    extra_v.append("--allow-absent-runs-dir")
            if _is_python_entrypoint(verify_cmd_args[0]):
                eff_verify_args = [sys.executable, "-B", verify_cmd_args[0], *extra_v, *verify_cmd_args[1:]]
            else:
                eff_verify_args = [verify_cmd_args[0], *extra_v, *verify_cmd_args[1:]]
            verify_env = dict(os.environ)
            if not in_custody and pinned_stat is not None:
                verify_env[PINNED_RUNS_STAT_ENV_VAR] = format_pinned_runs_stat(pinned_stat)
            else:
                verify_env.pop(PINNED_RUNS_STAT_ENV_VAR, None)
            if handoff_token:
                rfd, wfd = os.pipe()
                try:
                    os.write(wfd, handoff_token.encode("utf-8"))
                finally:
                    os.close(wfd)
                try:
                    verify_env.pop(SESSION_TOKEN_ENV_VAR, None)
                    verify_env.pop("OPENCODE_PASSWORD", None)
                    verify_env.pop("OPENCODE_SERVER_PASSWORD", None)
                    verify_env.pop("_FREE_INFERENCE_TOKEN_OVERSIZE", None)
                    verify_env["_FREE_INFERENCE_TOKEN_FD"] = str(rfd)
                    return actual_run_cmd(
                        eff_verify_args,
                        cwd=str(ROOT),
                        env=verify_env,
                        pass_fds=(rfd,),
                        capture_output=True,
                        text=True,
                        check=False,
                    )
                finally:
                    try:
                        os.close(rfd)
                    except OSError:
                        pass
            return actual_run_cmd(
                eff_verify_args,
                cwd=str(ROOT),
                env=verify_env,
                capture_output=True,
                text=True,
                check=False,
            )
        return actual_run_cmd(
            eff_verify_args,
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            check=False,
        )

    pre_refresh_rec = read_pid_record_for_model(endpoint.model_id, eff_runs_dir)
    rec_port_val = (pre_refresh_rec or {}).get("port")
    if explicit_port is not None:
        target_port: int | None = explicit_port
    elif isinstance(rec_port_val, int) and not isinstance(rec_port_val, bool):
        target_port = int(rec_port_val)
    else:
        target_port = endpoint.port
    effective_refresh = bool(refresh_session)
    serve_reqs = max_chat_requests
    serve_tokens = max_tokens_cap
    serve_bytes = max_request_bytes
    serve_ttl = min(ttl_seconds, MAX_WINDOW_SECONDS)
    has_explicit_ttl = ("ttl_seconds" in (explicit_cap_flags or ())) or (
        ttl_seconds != DEFAULT_TTL_SECONDS
    )
    attach_ttl_ceiling = (
        min(ttl_seconds, MAX_WINDOW_SECONDS) if has_explicit_ttl else MAX_WINDOW_SECONDS
    )

    initial_verify_cmd = [verify_script, endpoint.model_id]
    if target_port is not None:
        initial_verify_cmd.extend(["--port", str(target_port)])
    initial = _invoke_verify(initial_verify_cmd)
    if initial.returncode == 0 and not refresh_session:
        active_rec = read_pid_record_for_model(endpoint.model_id, eff_runs_dir)
        try:
            rec_max_reqs, rec_max_bytes, rec_max_tokens, rec_ttl = (
                _extract_attached_session_caps(
                    endpoint,
                    active_rec,
                    runs_dir=eff_runs_dir,
                )
            )
            if rec_max_bytes < MIN_ATTACHED_REQUEST_BYTES:
                raise LocalAssistError(
                    "spend_ceiling_exceeded",
                    f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
                    f"max_request_bytes={rec_max_bytes} is below the {MIN_ATTACHED_REQUEST_BYTES}-byte minimum "
                    f"required for OpenCode tool schemas and conversation state. "
                    f"Run './scripts/stop-model {endpoint.model_id}' and relaunch.",
                    details={
                        "model_id": endpoint.model_id,
                        "attached": True,
                        "max_request_bytes": rec_max_bytes,
                    },
                )
            exp_caps = explicit_cap_flags or ()
            check_reqs = (not inherit_attached_session_caps) or ("max_chat_requests" in exp_caps)
            check_toks = (not inherit_attached_session_caps) or ("max_tokens_cap" in exp_caps)
            check_bytes = (not inherit_attached_session_caps) or ("max_request_bytes" in exp_caps)
            if (
                (check_reqs and rec_max_reqs > max_chat_requests)
                or (check_toks and rec_max_tokens > max_tokens_cap)
                or (check_bytes and rec_max_bytes > max_request_bytes)
                or rec_ttl > attach_ttl_ceiling
            ):
                raise LocalAssistError(
                    "spend_ceiling_exceeded",
                    f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
                    f"the running session's caps (max_chat_requests={rec_max_reqs}, "
                    f"max_tokens_cap={rec_max_tokens}, max_request_bytes={rec_max_bytes}, "
                    f"ttl_seconds={rec_ttl}) exceed the launcher's ceiling "
                    f"(max_chat_requests={max_chat_requests}, max_tokens_cap={max_tokens_cap}, "
                    f"max_request_bytes={max_request_bytes}, ttl_seconds={attach_ttl_ceiling}). "
                    f"Run './scripts/stop-model {endpoint.model_id}' and relaunch.",
                    details={
                        "model_id": endpoint.model_id,
                        "attached": True,
                        "max_chat_requests": rec_max_reqs,
                        "max_tokens_cap": rec_max_tokens,
                        "max_request_bytes": rec_max_bytes,
                        "ttl_seconds": rec_ttl,
                    },
                )
            attached_est = check_session_spend_ceiling(
                endpoint,
                max_chat_requests=rec_max_reqs,
                max_request_bytes=rec_max_bytes,
                max_tokens_cap=rec_max_tokens,
                max_session_usd=max_session_usd,
                attached=True,
            )
        except LocalAssistError as exc:
            return False, str(exc), None

        has_low_caps = (
            rec_max_reqs < MIN_INTERACTIVE_CHAT_REQUESTS
            or rec_max_tokens < MIN_INTERACTIVE_TOKENS_CAP
            or rec_max_bytes < MIN_INTERACTIVE_REQUEST_BYTES
        )
        has_explicit_cap_arg = (
            bool(explicit_cap_flags)
            or max_chat_requests != DEFAULT_MAX_CHAT_REQUESTS
            or max_tokens_cap != DEFAULT_MAX_TOKENS_CAP
            or max_request_bytes != DEFAULT_MAX_REQUEST_BYTES
            or ttl_seconds != DEFAULT_TTL_SECONDS
        )
        cap_auto_upgrade_needed = (not has_explicit_cap_arg) and has_low_caps
        rec_thinking = bool((active_rec or {}).get("thinking_enabled", False))
        thinking_auto_upgrade_needed = bool(explicit_thinking) and (
            rec_thinking != bool(thinking)
        )
        active_port = int((active_rec or {}).get("port") or endpoint.port)

        if (cap_auto_upgrade_needed or thinking_auto_upgrade_needed) and not no_serve:
            target_port = active_port
            effective_refresh = True
            if cap_auto_upgrade_needed:
                serve_reqs = max_chat_requests
                serve_tokens = max_tokens_cap
                serve_bytes = max_request_bytes
                serve_ttl = ttl_seconds
                print(
                    f"[private-attested] Active session for '{endpoint.model_id}' on port {active_port} "
                    f"has eval caps (max_chat_requests={rec_max_reqs}, max_tokens_cap={rec_max_tokens}, "
                    f"max_request_bytes={rec_max_bytes}); refreshing with interactive caps "
                    f"({serve_reqs} reqs, {serve_tokens} tokens, {serve_bytes} bytes)...",
                    file=sys.stderr,
                )
            else:
                serve_reqs = rec_max_reqs
                serve_tokens = rec_max_tokens
                serve_bytes = rec_max_bytes
                serve_ttl = rec_ttl
                print(
                    f"[private-attested] Refreshing session for '{endpoint.model_id}' on port {active_port} "
                    f"to set thinking={bool(thinking)}...",
                    file=sys.stderr,
                )
        else:
            attach_extra: dict[str, Any] = {}
            if max_actual_micro_usd is not None:
                from local_assist.session import status_for_record, verify_live_spend_cap
                if not isinstance(active_rec, dict) or not isinstance(active_rec.get("pid"), int) or isinstance(active_rec.get("pid"), bool):
                    return (
                        False,
                        f"Refusing to attach to '{endpoint.model_id}' with --max-actual-usd: active session PID record is missing or malformed.",
                        None,
                    )
                live_attach = status_for_record(active_rec, eff_runs_dir)
                cap_err = verify_live_spend_cap(
                    live_attach,
                    max_actual_micro_usd,
                    model_id=endpoint.model_id,
                )
                if cap_err is not None:
                    return False, cap_err, None
                attach_extra = {
                    "verified_pid": int(active_rec["pid"]),
                    "verified_session_id": str(live_attach["session_id"]),
                    "live_status": live_attach,
                }
            return (
                True,
                None,
                {
                    **attached_est,
                    "attached": True,
                    "ttl_seconds": rec_ttl,
                    "started_at": (active_rec or {}).get("started_at"),
                    "low_caps_warning": bool(has_low_caps),
                    "thinking_enabled": rec_thinking,
                    "allocated_port": active_port,
                    **attach_extra,
                },
            )

    initial_err = (initial.stderr or initial.stdout or "").strip()
    if initial.returncode == EXIT_MODEL_MISMATCH:
        check_port = target_port if target_port is not None else endpoint.port
        owned_by_other, owner_mid = is_port_owned_by_different_active_model(
            endpoint.model_id,
            check_port,
            runs_dir=eff_runs_dir,
        )
        if owned_by_other and not no_serve and explicit_port is None:
            try:
                target_port = allocate_side_by_side_port(
                    check_port,
                    uses_upstream_port=True,
                    runs_dir=eff_runs_dir,
                )
            except LocalAssistError as exc:
                return False, str(exc), None
            print(
                f"[private-attested] Port {check_port} is active for '{owner_mid}'; "
                f"allocating side-by-side port {target_port} (upstream {target_port + 1000}) for '{endpoint.model_id}'.",
                file=sys.stderr,
            )
        elif (
            refresh_session
            and not no_serve
            and not owned_by_other
            and pre_refresh_rec is not None
        ):
            pass
        else:
            return (
                False,
                f"Refusing to launch private-attested: another model is already serving at "
                f"{endpoint.api_base_url} ({initial_err}). Stop the active model first "
                "with ./scripts/stop-model <active-model-id>.",
                None,
            )

    if refresh_session and (
        initial.returncode == 0
        or pre_refresh_rec is not None
        or read_pid_record_for_model(endpoint.model_id, eff_runs_dir) is not None
    ):
        stop_cmd = [stop_script, endpoint.model_id]
        stop_extra_kw: dict[str, Any] = {}
        if not in_custody:
            if use_default_runner:
                if (st_boot is not None and st_boot.cli_runs_dir is not None) or pinned_stat is not None:
                    ex_stop, stop_v_err = inspect_existing_runs_dir(
                        eff_runs_dir,
                        expected_stat=pinned_stat,
                        label="--runs-dir",
                    )
                else:
                    ex_stop, stop_v_err = ensure_creatable_runs_dir(
                        eff_runs_dir,
                        label="--runs-dir",
                    )
                if stop_v_err is not None or ex_stop is None or ex_stop.stat_id is None:
                    return (
                        False,
                        stop_v_err or "Cannot validate session store directory.",
                        None,
                    )
                eff_runs_dir = ex_stop.path
                pinned_stat = ex_stop.stat_id
                stop_env = dict(os.environ)
                stop_env[PINNED_RUNS_STAT_ENV_VAR] = format_pinned_runs_stat(pinned_stat)
                stop_extra_kw["env"] = stop_env
            stop_cmd.extend(["--runs-dir", str(eff_runs_dir)])
        stop_res = actual_run_cmd(
            stop_cmd,
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            check=False,
            **stop_extra_kw,
        )
        if stop_res.returncode != 0:
            stop_err = (stop_res.stderr or stop_res.stdout or "").strip()
            return (
                False,
                f"Failed to stop active session for '{endpoint.model_id}' during --refresh-session: {stop_err}",
                None,
            )

    if no_serve:
        return (
            False,
            f"Model '{endpoint.model_id}' is not currently served at {endpoint.api_base_url} "
            f"and --no-serve was set ({initial_err}).",
            None,
        )

    serve_cmd = [
        serve_script,
        endpoint.model_id,
        "--max-chat-requests",
        str(serve_reqs),
        "--max-tokens-cap",
        str(serve_tokens),
        "--max-request-bytes",
        str(serve_bytes),
        "--ttl-seconds",
        str(serve_ttl),
        "--stream-timeout-seconds",
        str(stream_timeout_seconds),
    ]
    if target_port is not None:
        serve_cmd.extend(["--port", str(target_port)])
    if max_actual_micro_usd is not None:
        from local_assist.session import format_micro_usd_decimal
        serve_cmd.extend([
            "--max-actual-usd",
            format_micro_usd_decimal(max_actual_micro_usd),
        ])
    if thinking:
        serve_cmd.append("--thinking")
    if effective_refresh:
        serve_cmd.append("--refresh-session")
    serve_extra_kw: dict[str, Any] = {}
    if not in_custody:
        if use_default_runner:
            if st_boot is not None and st_boot.cli_runs_dir is not None:
                srv_res, srv_v_err = inspect_existing_runs_dir(
                    eff_runs_dir,
                    expected_stat=pinned_stat,
                    label="--runs-dir",
                )
            else:
                srv_res, srv_v_err = ensure_creatable_runs_dir(
                    eff_runs_dir,
                    expected_stat=pinned_stat,
                    label="--runs-dir",
                )
            if srv_v_err is not None or srv_res is None or srv_res.stat_id is None:
                return False, srv_v_err or "Cannot prepare session store directory.", None
            eff_runs_dir = srv_res.path
            pinned_stat = srv_res.stat_id
            serve_env = dict(os.environ)
            serve_env[PINNED_RUNS_STAT_ENV_VAR] = format_pinned_runs_stat(pinned_stat)
            serve_extra_kw["env"] = serve_env
        serve_cmd.extend(["--runs-dir", str(eff_runs_dir)])
        if should_publish_pointer:
            serve_cmd.append("--publish-active-runs")
    serve_res = actual_run_cmd(
        serve_cmd,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        check=False,
        **serve_extra_kw,
    )
    if serve_res.returncode != 0:
        serve_err = (serve_res.stderr or serve_res.stdout or "").strip()
        return False, f"Failed to start model '{endpoint.model_id}': {serve_err}", None
    for warn_line in (serve_res.stderr or "").splitlines():
        if warn_line.lstrip().startswith("WARNING:"):
            print(warn_line, file=sys.stderr)

    wait_verify_cmd = [verify_script, endpoint.model_id, "--wait", str(wait_seconds)]
    if target_port is not None:
        wait_verify_cmd.extend(["--port", str(target_port)])
    wait_res = _invoke_verify(wait_verify_cmd)
    if wait_res.returncode == 0:
        active_rec = read_pid_record_for_model(endpoint.model_id, eff_runs_dir)
        if active_rec is not None:
            try:
                rec_max_reqs, rec_max_bytes, rec_max_tokens, rec_ttl = (
                    _extract_attached_session_caps(
                        endpoint,
                        active_rec,
                        runs_dir=eff_runs_dir,
                    )
                )
            except LocalAssistError as exc:
                return False, str(exc), None
        else:
            rec_max_reqs = serve_reqs
            rec_max_bytes = serve_bytes
            rec_max_tokens = serve_tokens
            rec_ttl = serve_ttl
        try:
            started_est = check_session_spend_ceiling(
                endpoint,
                max_chat_requests=rec_max_reqs,
                max_request_bytes=rec_max_bytes,
                max_tokens_cap=rec_max_tokens,
                max_session_usd=max_session_usd,
                attached=True,
            )
        except LocalAssistError as exc:
            return False, str(exc), None
        resolved_port = int(
            (active_rec or {}).get("port")
            or (target_port if target_port is not None else endpoint.port)
        )
        cold_extra: dict[str, Any] = {}
        if max_actual_micro_usd is not None:
            from local_assist.session import status_for_record, verify_live_spend_cap
            if not isinstance(active_rec, dict) or not isinstance(active_rec.get("pid"), int) or isinstance(active_rec.get("pid"), bool):
                return (
                    False,
                    f"Refusing to launch '{endpoint.model_id}' with --max-actual-usd: started session PID record is missing or malformed.",
                    None,
                )
            live_started = status_for_record(active_rec, eff_runs_dir)
            cap_err = verify_live_spend_cap(
                live_started,
                max_actual_micro_usd,
                model_id=endpoint.model_id,
            )
            if cap_err is not None:
                return False, cap_err, None
            cold_extra = {
                "verified_pid": int(active_rec["pid"]),
                "verified_session_id": str(live_started["session_id"]),
                "live_status": live_started,
            }
        return (
            True,
            None,
            {
                **started_est,
                "attached": False,
                "ttl_seconds": rec_ttl,
                "thinking_enabled": bool(thinking),
                "allocated_port": resolved_port,
                **cold_extra,
            },
        )

    wait_err = (wait_res.stderr or wait_res.stdout or "").strip()
    if wait_res.returncode == EXIT_MODEL_MISMATCH:
        return (
            False,
            f"Refusing to launch private-attested: model mismatch at {endpoint.api_base_url} "
            f"after startup ({wait_err}).",
            None,
        )
    return (
        False,
        f"Model '{endpoint.model_id}' did not become ready within {wait_seconds}s: {wait_err}",
        None,
    )


def parse_args(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(
        allow_abbrev=False,
        description=(
            "Launch opencode against a Rung 2/3 private-attested enclave proxy "
            "(attesting proxy + se-key-proxy) with isolated state, project-config "
            "lockdown, session spend ceiling, and Rung 1 local_assist MCP."
        ),
        epilog=(
            "Data-control notice: Running opencode-attested sends workspace files read by "
            "the agent, approved bash outputs, conversation history, and local_assist MCP "
            "tool outputs returned to the planner to the attested enclave under the model's "
            "remote_trust.tier (for example enclave_runtime_attested) and usage_policy "
            "(provider_terms_apply). Always place '--' before opencode subcommands or flags "
            "(for example: opencode-attested --model <model-id> "
            "--allow-uncleared-model -- run 'prompt')."
        ),
    )
    parser.add_argument(
        "--model",
        default=None,
        help=(
            "Rung 2/3 model id from models.yaml. If omitted, honors "
            f"{DEFAULT_ATTESTED_MODEL_ENV_VAR}, then routing.default_private_attested=true "
            "at the highest cleared data-control rung, then active session / installed proxy / "
            "sealed envelope narrowing within that rung, then LIFO catalog order (or refuses "
            "when no model is cleared)."
        ),
    )
    parser.add_argument(
        "--allow-uncleared-model",
        action="store_true",
        default=False,
        help="Allow launching a Rung 2/3 candidate whose routing.private_attested is not 'cleared'.",
    )
    parser.add_argument(
        "--context-limit",
        type=int,
        default=None,
        help=(
            f"Context window limit in opencode config (default: model.context_window from models.yaml, "
            f"or {DEFAULT_CONTEXT_LIMIT} if unset; clamped when attaching to a tighter proxy session)."
        ),
    )
    parser.add_argument(
        "--max-chat-requests",
        type=int,
        default=None,
        help=f"se-key-proxy chat request cap per session, including title-agent requests (default: {DEFAULT_MAX_CHAT_REQUESTS}).",
    )
    parser.add_argument(
        "--max-tokens-cap",
        type=int,
        default=None,
        help=f"se-key-proxy max_tokens cap per request (default: {DEFAULT_MAX_TOKENS_CAP}).",
    )
    parser.add_argument(
        "--max-request-bytes",
        type=int,
        default=None,
        help=f"se-key-proxy max HTTP request body bytes (default: {DEFAULT_MAX_REQUEST_BYTES}).",
    )
    parser.add_argument(
        "--ttl-seconds",
        type=int,
        default=None,
        help=f"se-key-proxy session TTL in seconds (default: {DEFAULT_TTL_SECONDS}).",
    )
    parser.add_argument(
        "--stream-timeout-seconds",
        type=int,
        default=DEFAULT_STREAM_TIMEOUT_SECONDS,
        help=f"se-key-proxy stream timeout in seconds (default: {DEFAULT_STREAM_TIMEOUT_SECONDS}).",
    )
    parser.add_argument(
        "--max-session-usd",
        type=float,
        default=DEFAULT_MAX_SESSION_USD,
        help="Optional maximum worst-case session spend in USD permitted before launch (when omitted, prints pricing and caps without blocking interactive launch).",
    )
    from local_assist.session import parse_usd_to_micro_usd
    def _parse_max_actual_usd_arg(raw: str) -> int:
        try:
            return parse_usd_to_micro_usd(raw)
        except ValueError as exc:
            raise argparse.ArgumentTypeError(str(exc)) from exc
    parser.add_argument(
        "--max-actual-usd",
        dest="max_actual_micro_usd",
        type=_parse_max_actual_usd_arg,
        default=None,
        help="Optional live post-accounting USD spend cap enforced in se-key-proxy (decimal in 0.000001..100000; does not relax --max-session-usd).",
    )
    parser.add_argument(
        "--inherit-session-caps",
        action="store_true",
        default=False,
        help="Inherit finite request, token, byte, and window bounds from the attached se-key-proxy session in unattended worker mode without --max-session-usd.",
    )
    parser.add_argument(
        "--thinking",
        action="store_true",
        default=False,
        help="Allow model reasoning/thinking chains (<think>) instead of injecting model passthrough thinking=false defaults.",
    )
    add_common_launcher_arguments(
        parser,
        default_output_limit=DEFAULT_OUTPUT_LIMIT,
        default_wait_seconds=DEFAULT_WAIT_SECONDS,
        wait_help=f"Seconds to wait for proxy readiness when starting (default: {DEFAULT_WAIT_SECONDS}).",
        no_serve_help="Do not automatically start the proxy session if it is not already running.",
        print_config_help="Verify/start the proxy, write the isolated opencode.json, print redacted metadata and JSON, and exit.",
        unattended_help="Enforce the default unattended_worker security profile (Seatbelt OS sandbox + default-deny permissions + loopback token relay).",
    )
    args, opencode_args = split_launcher_argv(parser, argv)
    our_argv = (
        argv[1 : argv.index("--", 1)]
        if "--" in argv[1:]
        else argv[1:]
    )
    cap_flag_map = {
        "--max-chat-requests": "max_chat_requests",
        "--max-tokens-cap": "max_tokens_cap",
        "--max-request-bytes": "max_request_bytes",
        "--ttl-seconds": "ttl_seconds",
    }
    explicit_caps: set[str] = set()
    for flag_tok, dest_name in cap_flag_map.items():
        if any(tok == flag_tok or tok.startswith(f"{flag_tok}=") for tok in our_argv):
            explicit_caps.add(dest_name)
    args.explicit_cap_flags = frozenset(explicit_caps)
    args.explicit_thinking = any(tok == "--thinking" for tok in our_argv)
    return args, opencode_args


_write_launcher_exit_diagnostic = write_launcher_exit_diagnostic


def _emit_session_blocked_exit(
    args: argparse.Namespace,
    reason: str,
    message: str,
) -> int:
    print(message, file=sys.stderr)
    raw_exit_file = getattr(args, "launcher_exit_file", None)
    if raw_exit_file is not None:
        raw_tok = getattr(args, "run_token", None) or ""
        if not _write_launcher_exit_diagnostic(
            raw_exit_file,
            run_token=raw_tok,
            reason=reason,
        ):
            print(
                f"Failed to write atomic 0600 launcher diagnostic to '{raw_exit_file}'; failing closed with exit 1.",
                file=sys.stderr,
            )
            return 1
    return EXIT_SESSION_BLOCKED


def _precheck_worker_attached_session(
    *,
    args: argparse.Namespace,
    model_id: str,
    endpoint_port: int | None,
    inherit_caps: bool,
    handoff_token: str | None,
    runs_dir: Path | None = None,
) -> int | None:
    """Return None to continue, EXIT_SESSION_BLOCKED (4) on verified session failure, or 1 on unverified error."""
    from local_assist.session import status_for_record

    session_runs = _effective_runs_dir(runs_dir)
    if endpoint_port is not None:
        owned_by_other, _ = is_port_owned_by_different_active_model(
            model_id,
            int(endpoint_port),
            runs_dir=session_runs,
        )
        if owned_by_other:
            return None

    rec = read_pid_record_for_model(model_id, session_runs)
    if rec is None:
        if handoff_token and not inherit_caps:
            return None
        return _emit_session_blocked_exit(
            args,
            "opencode_session_unavailable",
            f"No active attested session record found for '{model_id}'.",
        )

    raw_pid = rec.get("pid")
    has_pid = isinstance(raw_pid, int) and not isinstance(raw_pid, bool) and raw_pid > 0
    pid_state = classify_pid_identity(raw_pid, rec.get("pid_lstart")) if has_pid else "none"
    up_pid = rec.get("upstream_pid")
    has_up = isinstance(up_pid, int) and not isinstance(up_pid, bool) and up_pid > 0
    up_state = classify_pid_identity(up_pid, rec.get("upstream_pid_lstart")) if has_up else "none"

    if rec.get("status") == "starting":
        if (has_pid and pid_state in ("dead", "reused")) or (
            has_up and up_state in ("dead", "reused")
        ):
            return _emit_session_blocked_exit(
                args,
                "opencode_session_unavailable",
                f"Attested session process for '{model_id}' exited before becoming ready.",
            )
        print(
            f"Attested session for '{model_id}' is still starting (status='starting'); refusing unattended attach.",
            file=sys.stderr,
        )
        return 1

    if not has_pid:
        print(f"Malformed session record for '{model_id}': missing pid.", file=sys.stderr)
        return 1
    if pid_state in ("dead", "reused") or (has_up and up_state in ("dead", "reused")):
        return _emit_session_blocked_exit(
            args,
            "opencode_session_unavailable",
            f"Attested session process for '{model_id}' is no longer running.",
        )
    if pid_state != "matched" or (has_up and up_state != "matched"):
        print(
            f"Attested session process identity for '{model_id}' is unverifiable; refusing attach.",
            file=sys.stderr,
        )
        return 1

    live_info = status_for_record(rec, session_runs)
    state = live_info.get("state")
    if state == "OFF" or (state == "ON" and int(live_info.get("remaining_seconds", 0)) <= 0):
        return _emit_session_blocked_exit(
            args,
            "opencode_session_unavailable",
            f"Attested session authorization window for '{model_id}' is OFF or expired.",
        )
    if state == "ON" and int(live_info.get("requests_remaining", 0)) <= 0:
        return _emit_session_blocked_exit(
            args,
            "opencode_session_caps_exhausted",
            f"Attested session chat request budget for '{model_id}' is exhausted (0 remaining).",
        )
    if inherit_caps and state != "ON" and not handoff_token:
        print(
            f"Attested session control state for '{model_id}' is '{state}' (verified ON lease required when inherit_attached_session_caps=true); refusing attach.",
            file=sys.stderr,
        )
        return 1
    return None


def main(argv: list[str]) -> int:
    prep_ok, prepared_identity, prep_err = prepare_early_worker_manifest_from_argv(argv)
    if not prep_ok:
        _consume_handoff_token()
        print(prep_err or "Failed to prepare worker manifest.", file=sys.stderr)
        return 1

    ownership_transferred = {"v": False}
    prev_boot = get_active_bootstrap_state()
    inproc_runs_set = False
    try:
        if prev_boot is not None and prev_boot.bootstrap_error is not None:
            _consume_handoff_token()
            print(prev_boot.bootstrap_error, file=sys.stderr)
            return 1

        tok_ok, handoff_token, tok_err = _consume_handoff_token()
        if not tok_ok:
            print(tok_err or "Failed to consume handoff token.", file=sys.stderr)
            return 1

        caller_cwd = Path.cwd()
        try:
            args, opencode_args = parse_args(argv)
        except SystemExit as exc:
            code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
            return normalize_non_session_exit_code(code)

        if getattr(args, "reap_worker", None):
            return normalize_non_session_exit_code(
                reap_worker_from_manifest(
                    args.reap_worker,
                    reap_timeout_sec=float(getattr(args, "reap_timeout", 10.0)),
                )
            )

        if getattr(args, "runs_dir", None) is not None:
            runs_err = apply_inprocess_runs_dir_arg(args)
            if runs_err is not None:
                print(runs_err, file=sys.stderr)
                return 1
            inproc_runs_set = True

        return _main_inner_attested(
            args,
            opencode_args,
            caller_cwd,
            handoff_token,
            prepared_identity=prepared_identity,
            ownership_callback=lambda: ownership_transferred.__setitem__("v", True),
        )
    finally:
        if inproc_runs_set:
            set_cli_runs_dir_override(
                prev_boot.cli_runs_dir if prev_boot is not None else None,
                runs_stat=prev_boot.cli_runs_stat if prev_boot is not None else None,
            )
        if not ownership_transferred["v"]:
            cleanup_prepared_worker_identity(prepared_identity)


def _main_inner_attested(
    args: argparse.Namespace,
    opencode_args: list[str],
    caller_cwd: Path,
    handoff_token: str | None,
    *,
    prepared_identity: PreparedWorkerIdentity | None = None,
    ownership_callback: Any = None,
) -> int:
    try:
        active_profile = _resolve_active_security_profile(args)
    except SecurityProfileError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    flag_err = validate_common_worker_flags(args, active_profile)
    if flag_err:
        print(flag_err, file=sys.stderr)
        return 1

    effective_allow_uncleared = (
        active_profile.allow_uncleared_model
        if active_profile is not None
        else args.allow_uncleared_model
    )
    inherit_caps = bool(
        getattr(args, "inherit_session_caps", False)
        or (active_profile is not None and active_profile.spend_inherit_attached_session_caps)
    )
    effective_max_session_usd = (
        args.max_session_usd
        if args.max_session_usd is not None
        else (active_profile.spend_max_session_usd if active_profile is not None else None)
    )
    has_valid_usd_ceiling = (
        effective_max_session_usd is not None
        and not isinstance(effective_max_session_usd, bool)
        and isinstance(effective_max_session_usd, (int, float))
        and math.isfinite(float(effective_max_session_usd))
        and float(effective_max_session_usd) > 0
    )
    if active_profile is not None and not has_valid_usd_ceiling and not inherit_caps:
        print(
            "Unattended worker mode on private-attested requires an explicit spend ceiling (finite positive USD) "
            "or spend.inherit_attached_session_caps: true: pass --max-session-usd <usd>, set spend.max_session_usd, "
            "or set spend.inherit_attached_session_caps: true in the security profile.",
            file=sys.stderr,
        )
        return 1

    eff_max_reqs = (
        args.max_chat_requests
        if args.max_chat_requests is not None
        else DEFAULT_MAX_CHAT_REQUESTS
    )
    eff_max_tokens = (
        args.max_tokens_cap
        if args.max_tokens_cap is not None
        else DEFAULT_MAX_TOKENS_CAP
    )
    eff_max_bytes = (
        args.max_request_bytes
        if args.max_request_bytes is not None
        else DEFAULT_MAX_REQUEST_BYTES
    )
    eff_ttl = (
        args.ttl_seconds
        if args.ttl_seconds is not None
        else DEFAULT_TTL_SECONDS
    )

    if (
        eff_max_reqs <= 0
        or eff_max_tokens <= 0
        or eff_max_bytes <= 0
        or eff_ttl <= 0
        or args.stream_timeout_seconds <= 0
        or args.output_limit <= 0
        or args.wait < 0
        or (args.context_limit is not None and args.context_limit <= 0)
        or (
            effective_max_session_usd is not None
            and (
                isinstance(effective_max_session_usd, bool)
                or not isinstance(effective_max_session_usd, (int, float))
                or not math.isfinite(float(effective_max_session_usd))
                or float(effective_max_session_usd) <= 0
            )
        )
    ):
        print(
            "All cap/limit flags (--max-chat-requests, --max-tokens-cap, --max-request-bytes, "
            "--ttl-seconds, --stream-timeout-seconds, --output-limit, --context-limit, --max-session-usd) must be finite values > 0 and --wait >= 0.",
            file=sys.stderr,
        )
        return 1
    if eff_ttl > MAX_WINDOW_SECONDS:
        print(
            f"--ttl-seconds must not exceed {MAX_WINDOW_SECONDS} seconds (24h).",
            file=sys.stderr,
        )
        return 1

    requested_max_actual_micro_usd = getattr(args, "max_actual_micro_usd", None)
    if requested_max_actual_micro_usd is not None and handoff_token:
        print(
            "Refusing to combine --max-actual-usd with an explicit session handoff token: "
            "live spend cap verification requires direct control-socket lease binding.",
            file=sys.stderr,
        )
        return 1

    effective_no_serve = True if active_profile is not None else args.no_serve

    prechecked_isolated_home: Path | None = None
    if active_profile is None:
        prechecked_isolated_home = _resolve_isolated_home()
        legacy_err = check_uncontained_legacy_home(prechecked_isolated_home)
        if legacy_err is not None:
            print(legacy_err, file=sys.stderr)
            return 1

    st_main = get_active_bootstrap_state()
    in_custody_main = (st_main is not None and st_main.custody_mode) or is_custody_tree(ROOT)
    launcher_should_publish_pointer = (
        not in_custody_main
        and (st_main is None or st_main.cli_runs_dir is None)
        and getattr(args, "runs_dir", None) is None
        and (
            True
            if (st_main is not None and st_main.worker_or_reap_cli)
            else not bool(os.environ.get("FREE_INFERENCE_RUNS_DIR", "").strip())
        )
    )
    try:
        session_runs, ptr_info = resolve_effective_runs_dir_details()
        if ptr_info is not None and ptr_info.status == "refused":
            err_msg = ptr_info.message or "Active session pointer was refused."
            rem_msg = ptr_info.remediation or ""
            print(f"{err_msg} {rem_msg}".strip() if rem_msg else err_msg, file=sys.stderr)
            return 1
        if not in_custody_main and getattr(args, "runs_dir", None) is None:
            v_sr, sr_err = validate_creatable_runs_dir(
                session_runs,
                label="FREE_INFERENCE_RUNS_DIR",
            )
            if sr_err is not None or v_sr is None:
                print(sr_err or "Invalid session store directory.", file=sys.stderr)
                return 1
            session_runs = v_sr.path
        local_assist_base_url, local_assist_port = _resolve_local_assist_base_url()
        model_id = args.model or resolve_default_attested_model_id(runs_dir=session_runs)
        model = load_model(model_id)
        initial_pid_record = read_pid_record_for_model(model_id, session_runs)
        if args.port is not None and isinstance(initial_pid_record, dict):
            init_active, init_unavail = pid_record_is_live_or_starting(initial_pid_record)
            existing_port = initial_pid_record.get("port")
            if (
                (init_active or init_unavail)
                and isinstance(existing_port, int)
                and existing_port != args.port
                and (effective_no_serve or not bool(getattr(args, "refresh_session", False)))
            ):
                print(
                    f"Refusing to launch '{model_id}' on --port {args.port}: '{model_id}' is already active on port {existing_port}. "
                    f"Omit --port (or pass --port {existing_port}) to attach, or pass --refresh-session to move it to port {args.port}.",
                    file=sys.stderr,
                )
                return 1
        endpoint_pre = resolve_endpoint(
            model,
            pid_record=initial_pid_record,
            require_api_key=False,
            port_override=args.port,
            session_token_override=handoff_token,
        )
        validate_private_attested_endpoint(
            endpoint_pre,
            allow_uncleared_model=effective_allow_uncleared,
            allow_deprecated_model=bool(getattr(args, "allow_deprecated_model", False)),
        )
    except (RegistryError, LocalAssistError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1

    opencode_bin, oc_bin_err = resolve_opencode_binary(args)
    if oc_bin_err is not None:
        print(oc_bin_err, file=sys.stderr)
        return 1
    if not args.print_config and not opencode_bin:
        print("opencode binary not found on PATH", file=sys.stderr)
        return 1

    sandbox_exec_bin = Path(
        os.environ.get("FREE_INFERENCE_SANDBOX_EXEC_BIN", "/usr/bin/sandbox-exec")
    )
    worker_ok, validated_worker_args, worker_err = validate_worker_binary_and_args(
        args,
        active_profile,
        opencode_bin,
        opencode_args,
        sandbox_exec_bin,
    )
    if not worker_ok:
        print(worker_err or "Worker preflight validation failed", file=sys.stderr)
        return 1

    if active_profile is not None or getattr(args, "launcher_exit_file", None) is not None:
        pre_rc = _precheck_worker_attached_session(
            args=args,
            model_id=model_id,
            endpoint_port=endpoint_pre.port,
            inherit_caps=inherit_caps,
            handoff_token=handoff_token,
            runs_dir=session_runs,
        )
        if pre_rc is not None:
            return pre_rc

    ok, err_msg, session_meta = ensure_model_served(
        endpoint_pre,
        no_serve=effective_no_serve,
        refresh_session=bool(getattr(args, "refresh_session", False)),
        wait_seconds=args.wait,
        max_chat_requests=eff_max_reqs,
        max_tokens_cap=eff_max_tokens,
        max_request_bytes=eff_max_bytes,
        ttl_seconds=eff_ttl,
        stream_timeout_seconds=args.stream_timeout_seconds,
        max_session_usd=effective_max_session_usd,
        max_actual_micro_usd=requested_max_actual_micro_usd,
        inherit_attached_session_caps=inherit_caps,
        explicit_port=args.port,
        explicit_cap_flags=getattr(args, "explicit_cap_flags", ()),
        thinking=bool(getattr(args, "thinking", False)),
        explicit_thinking=bool(getattr(args, "explicit_thinking", False)),
        handoff_token=handoff_token,
        runs_dir=session_runs,
        publish_pointer=launcher_should_publish_pointer,
    )
    if not ok or session_meta is None:
        print(err_msg or "Failed to verify served model", file=sys.stderr)
        if err_msg and "another model is already serving" in err_msg:
            return EXIT_MODEL_MISMATCH
        return 1

    from local_assist.session import (
        SessionLeaseSupplier,
        control_node_present,
        control_path,
        enrich_status,
        status_for_record,
    )
    lease_supplier = None
    active_pid_record = read_pid_record_for_model(model_id, session_runs)
    post_port_override = (
        (session_meta.get("allocated_port") or args.port)
        if active_pid_record is None
        else None
    )
    if requested_max_actual_micro_usd is not None:
        verified_pid = session_meta.get("verified_pid")
        verified_session_id = session_meta.get("verified_session_id")
        if (
            not isinstance(active_pid_record, dict)
            or type(verified_pid) is not int
            or type(active_pid_record.get("pid")) is not int
            or active_pid_record.get("pid") != verified_pid
            or not isinstance(verified_session_id, str)
            or not verified_session_id
        ):
            print(
                f"Active session identity for '{model_id}' changed or is unverifiable under --max-actual-usd; refusing launch.",
                file=sys.stderr,
            )
            return 1
        try:
            endpoint_unauth = resolve_endpoint(
                model,
                pid_record=active_pid_record,
                require_api_key=False,
                port_override=post_port_override,
                session_token_override=None,
            )
            validate_private_attested_endpoint(
                endpoint_unauth,
                allow_uncleared_model=effective_allow_uncleared,
                allow_deprecated_model=bool(getattr(args, "allow_deprecated_model", False)),
            )
        except (RegistryError, LocalAssistError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
        lease_supplier = SessionLeaseSupplier(
            active_pid_record,
            session_runs,
            expected_session_id=verified_session_id,
            required_max_actual_micro_usd=requested_max_actual_micro_usd,
        )
        try:
            initial_lease = lease_supplier()
        except Exception:
            print(
                "Cannot verify the active session lease and live --max-actual-usd cap; refusing launch.",
                file=sys.stderr,
            )
            return 1
        lease_token = initial_lease.get("token")
        if not isinstance(lease_token, str) or not lease_token:
            print(
                "Verified session lease did not yield a valid session token; refusing launch.",
                file=sys.stderr,
            )
            return 1
        session_meta["live_status"] = enrich_status(
            {k: v for k, v in initial_lease.items() if k != "token"},
            model_id=endpoint_unauth.model_id,
        )
        try:
            endpoint = resolve_endpoint(
                model,
                pid_record=active_pid_record,
                require_api_key=True,
                port_override=post_port_override,
                session_token_override=lease_token,
            )
            validate_private_attested_endpoint(
                endpoint,
                allow_uncleared_model=effective_allow_uncleared,
                allow_deprecated_model=bool(getattr(args, "allow_deprecated_model", False)),
            )
        except (RegistryError, LocalAssistError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
    else:
        try:
            endpoint = resolve_endpoint(
                model,
                pid_record=active_pid_record,
                require_api_key=True,
                port_override=post_port_override,
                session_token_override=handoff_token,
            )
            validate_private_attested_endpoint(
                endpoint,
                allow_uncleared_model=effective_allow_uncleared,
                allow_deprecated_model=bool(getattr(args, "allow_deprecated_model", False)),
            )
        except (RegistryError, LocalAssistError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
        if isinstance(active_pid_record, dict):
            session_meta['live_status'] = status_for_record(active_pid_record, session_runs)
            if handoff_token:
                pass  # Explicit credential overrides remain authoritative; never replace from disk.
            elif session_meta['live_status']['state'] == 'ON':
                lease_supplier = SessionLeaseSupplier(active_pid_record, session_runs)
                try:
                    lease_supplier()
                except Exception:
                    print('Cannot verify the active session lease; refusing launch.', file=sys.stderr)
                    return 1
            elif control_node_present(control_path(session_runs, endpoint.model_id)):
                print('Session control is present but unverifiable; refusing launch.', file=sys.stderr)
                return 1
            else:
                print('Live session control is unavailable; using the legacy fixed launch window.', file=sys.stderr)
    print(
        format_session_banner(
            endpoint,
            session_meta,
            max_session_usd=effective_max_session_usd,
        ),
        file=sys.stderr,
    )

    sess_tokens_cap = int(session_meta["max_tokens_cap"])
    sess_bytes_cap = int(session_meta["max_request_bytes"])
    if args.context_limit is not None and sess_bytes_cap > 0 and args.context_limit > max(1, sess_bytes_cap // 6):
        print(
            f"[private-attested] Notice: clamping requested --context-limit {args.context_limit} "
            f"to {max(1, sess_bytes_cap // 6)} tokens to fit session max_request_bytes={sess_bytes_cap}.",
            file=sys.stderr,
        )
    if args.output_limit > sess_tokens_cap > 0:
        print(
            f"[private-attested] Notice: clamping requested --output-limit {args.output_limit} "
            f"to {sess_tokens_cap} tokens to fit session max_tokens_cap={sess_tokens_cap}.",
            file=sys.stderr,
        )

    upstream_port_val = (
        int(active_pid_record["upstream_port"])
        if isinstance(active_pid_record, dict)
        and isinstance(active_pid_record.get("upstream_port"), int)
        else ((endpoint.port + 1000) if endpoint.port is not None else 9181)
    )

    session_default_chat_params: dict[str, Any] | None = None
    if isinstance(active_pid_record, dict) and isinstance(
        active_pid_record.get("default_chat_params"), dict
    ):
        session_default_chat_params = dict(active_pid_record["default_chat_params"])
    elif not bool(getattr(args, "thinking", False)):
        raw_prov = model.get("promptfoo_provider")
        raw_cfg = raw_prov.get("config") if isinstance(raw_prov, dict) else None
        raw_pt = raw_cfg.get("passthrough") if isinstance(raw_cfg, dict) else None
        if isinstance(raw_pt, dict) and raw_pt:
            session_default_chat_params = dict(raw_pt)

    if active_profile is not None:
        worker_ttl = min(
            session_meta["ttl_seconds"],
            session_meta.get("live_status", {}).get(
                "remaining_seconds", session_meta["ttl_seconds"]
            ),
        )
        if "ttl_seconds" in args.explicit_cap_flags:
            worker_ttl = min(worker_ttl, eff_ttl)

        relay_max_reqs = int(session_meta["max_chat_requests"])
        live_st = session_meta.get("live_status")
        if (
            inherit_caps
            and isinstance(live_st, dict)
            and live_st.get("state") == "ON"
            and isinstance(live_st.get("requests_remaining"), int)
            and int(live_st["requests_remaining"]) > 0
        ):
            relay_max_reqs = min(relay_max_reqs, int(live_st["requests_remaining"]))
        if "max_chat_requests" in args.explicit_cap_flags:
            relay_max_reqs = min(relay_max_reqs, eff_max_reqs)

        def _build_att_base_cfg(relay: _WorkerTokenRelay | None) -> dict[str, Any]:
            assert relay is not None
            base_config_text = render_private_attested_config(
                endpoint,
                context_limit=args.context_limit,
                output_limit=args.output_limit,
                max_tokens_cap=sess_tokens_cap,
                max_request_bytes=sess_bytes_cap,
                edit_permission="allow",
                allow_subagents=bool(active_profile.allow_subagents),
                local_assist_base_url=local_assist_base_url,
                workspace_dir=caller_cwd,
                api_base_url_override=relay.api_base_url,
            )
            base_cfg = json.loads(base_config_text)
            base_cfg["provider"]["private-attested"]["options"]["baseURL"] = relay.api_base_url
            base_cfg["provider"]["private-attested"]["options"]["apiKey"] = relay.relay_token
            return base_cfg

        observed_relays: list[Any] = []

        def _make_worker_relay() -> _WorkerTokenRelay:
            r = _WorkerTokenRelay(
                upstream_base_url=endpoint.api_base_url,
                upstream_session_token=endpoint.api_key,
                max_chat_requests=relay_max_reqs,
                max_request_bytes=sess_bytes_cap,
                max_tokens_cap=sess_tokens_cap,
                ttl_seconds=float(worker_ttl),
                upstream_timeout_seconds=float(args.stream_timeout_seconds),
                default_chat_params=session_default_chat_params,
                lease_provider=lease_supplier,
            )
            observed_relays.append(r)
            return r

        rc_worker = execute_worker_profile_session(
            active_profile=active_profile,
            args=args,
            caller_cwd=caller_cwd,
            opencode_bin=opencode_bin,
            sandbox_exec_bin=sandbox_exec_bin,
            validated_worker_args=validated_worker_args,
            build_base_config_fn=_build_att_base_cfg,
            build_print_config_payload_fn=lambda worker_id, cfg_path, sb_path, iso_home, compiled_cfg, relay: {
                "model_id": endpoint.model_id,
                "served_model_id": endpoint.served_model_id,
                "trust_tier": endpoint.trust_tier,
                "data_control_rung": endpoint.data_control_rung,
                "usage_policy": endpoint.usage_policy,
                "api_base_url": endpoint.api_base_url,
                "worker_relay_base_url": relay.api_base_url if relay is not None else "",
                "session_token": "<redacted-se-session-token>",
                "session_caps": session_meta,
                "worker_id": worker_id,
                "opencode_config_path": str(cfg_path),
                "seatbelt_profile_path": str(sb_path),
                "isolated_home": str(iso_home),
                "config": compiled_cfg,
            },
            relay_factory=_make_worker_relay,
            upstream_port=upstream_port_val,
            endpoint_port=endpoint.port,
            local_assist_port=local_assist_port,
            use_token_relay=True,
            allocate_worker_home_fn=allocate_worker_home,
            prepared_identity=prepared_identity,
            ownership_callback=ownership_callback,
        )
        if rc_worker != 0 and rc_worker < 128 and not getattr(args, "print_config", False):
            relay_cap_hit = any(
                bool(
                    getattr(r, "local_request_cap_exhausted", False)
                    or getattr(r, "upstream_session_cap_exhausted", False)
                )
                for r in observed_relays
            )
            post_exhausted = False
            if not relay_cap_hit and isinstance(active_pid_record, dict):
                post_live = status_for_record(active_pid_record, session_runs)
                if (
                    post_live.get("state") == "ON"
                    and int(post_live.get("requests_remaining", 1)) <= 0
                ):
                    post_exhausted = True
            if relay_cap_hit or post_exhausted:
                return _emit_session_blocked_exit(
                    args,
                    "opencode_session_caps_exhausted",
                    f"Attested session chat request budget for '{endpoint.model_id}' was exhausted during execution.",
                )
        return normalize_non_session_exit_code(rc_worker)

    isolated_home = (
        prechecked_isolated_home
        if prechecked_isolated_home is not None
        else _resolve_isolated_home()
    )
    edit_permission = "allow" if args.allow_edit else "ask"
    bash_permission = "allow" if bool(getattr(args, "allow_bash", False)) else "ask"
    config_text = render_private_attested_config(
        endpoint,
        context_limit=args.context_limit,
        output_limit=args.output_limit,
        max_tokens_cap=sess_tokens_cap,
        max_request_bytes=sess_bytes_cap,
        edit_permission=edit_permission,
        bash_permission=bash_permission,
        allow_subagents=bool(getattr(args, "allow_subagents", False)),
        local_assist_base_url=local_assist_base_url,
        workspace_dir=caller_cwd,
    )

    token_sha = hashlib.sha256((endpoint.api_key or "").encode("utf-8")).hexdigest()
    current_sync = {
        "model_id": endpoint.model_id,
        "startup_nonce": (active_pid_record or {}).get("startup_nonce"),
        "token_sha256": token_sha,
    }
    return normalize_non_session_exit_code(
        publish_and_run_opencode(
            opencode_bin=opencode_bin,
            opencode_args=opencode_args,
            caller_cwd=caller_cwd,
            isolated_home=isolated_home,
            endpoint=endpoint,
            config_text=config_text,
            build_env_fn=lambda cfg_path: build_private_attested_env(
                caller_cwd,
                isolated_home,
                cfg_path,
                endpoint,
                local_assist_base_url=local_assist_base_url,
                preserve_host_home=args.preserve_host_home,
            ),
            current_sync=current_sync,
            print_config=bool(args.print_config),
            build_print_config_payload_fn=lambda cfg_path, parsed_cfg: {
                "model_id": endpoint.model_id,
                "served_model_id": endpoint.served_model_id,
                "trust_tier": endpoint.trust_tier,
                "data_control_rung": endpoint.data_control_rung,
                "usage_policy": endpoint.usage_policy,
                "api_base_url": endpoint.api_base_url,
                "session_token": "<redacted-se-session-token>",
                "session_caps": session_meta,
                "opencode_config_path": str(cfg_path),
                "isolated_home": str(isolated_home),
                "config": parsed_cfg,
            },
            relay_factory=lambda svc_pw: SessionAuthRelay(
                upstream_base_url=endpoint.api_base_url,
                upstream_session_token=endpoint.api_key,
                token_prefix="oc-relay",
                extra_canary_secrets=[svc_pw],
                max_chat_requests=int(session_meta["max_chat_requests"]),
                max_request_bytes=sess_bytes_cap,
                max_tokens_cap=sess_tokens_cap,
                ttl_seconds=float(session_meta.get("ttl_seconds") or eff_ttl),
                upstream_timeout_seconds=float(args.stream_timeout_seconds),
                default_chat_params=session_default_chat_params,
                lease_provider=lease_supplier,
                follow_session_window=lease_supplier is not None,
            ),
            endpoint_port=endpoint.port,
            upstream_port=upstream_port_val,
            local_assist_port=local_assist_port,
            use_token_relay=True,
            allowed_shell_localhost_ports=tuple(getattr(args, "allow_shell_localhost_port", None) or ()),
            allow_ssh_remote=bool(getattr(args, "allow_ssh_remote", False)),
            allow_self_edit=bool(getattr(args, "allow_self_edit", False)),
            sandbox_exec_bin=sandbox_exec_bin,
        )
    )


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
