DEFAULT_CONTEXT_LIMIT = 131072
DEFAULT_OUTPUT_LIMIT = 16384
DEFAULT_WAIT_SECONDS = 60.0
DEFAULT_MAX_CHAT_REQUESTS = 1000
DEFAULT_MAX_TOKENS_CAP = 16384
DEFAULT_MAX_REQUEST_BYTES = 8388608
DEFAULT_TTL_SECONDS = 43200
DEFAULT_STREAM_TIMEOUT_SECONDS = 300
DEFAULT_MAX_SESSION_USD: float | None = None
MIN_ATTACHED_REQUEST_BYTES = 65536
MIN_INTERACTIVE_CHAT_REQUESTS = 200
MIN_INTERACTIVE_TOKENS_CAP = 8192
MIN_INTERACTIVE_REQUEST_BYTES = 2097152
WORST_CASE_BYTES_PER_TOKEN = 3.0
RUNG1_LOCAL_ASSIST_BASE_URL = "http://127.0.0.1:8080/v1"

TEMPLATE_CONFIG = ROOT / "config" / "opencode-private-attested.json.tmpl"
DEFAULT_ISOLATED_HOME = ROOT / ".home" / "opencode-private-attested"


@contextlib.contextmanager
def _scoped_admission_env(*, allow_uncleared_model: bool):
    prev_tee = os.environ.get("LOCAL_ASSIST_ALLOW_ATTESTED_TEE")
    prev_uncleared = os.environ.get("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE")
    os.environ["LOCAL_ASSIST_ALLOW_ATTESTED_TEE"] = "1"
    if allow_uncleared_model:
        os.environ["LOCAL_ASSIST_ALLOW_UNCLEARED_TEE"] = "1"
    else:
        os.environ.pop("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE", None)
    try:
        yield
    finally:
        if prev_tee is None:
            os.environ.pop("LOCAL_ASSIST_ALLOW_ATTESTED_TEE", None)
        else:
            os.environ["LOCAL_ASSIST_ALLOW_ATTESTED_TEE"] = prev_tee
        if prev_uncleared is None:
            os.environ.pop("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE", None)
        else:
            os.environ["LOCAL_ASSIST_ALLOW_UNCLEARED_TEE"] = prev_uncleared


def resolve_default_attested_model_id(
    models_list: list[dict[str, Any]] | None = None,
) -> str:
    models = models_list if models_list is not None else load_models()
    cleared_ids: list[str] = []
    candidate_ids: list[str] = []
    for entry in models:
        rt = entry.get("remote_trust")
        if not isinstance(rt, dict):
            continue
        raw_tier = rt.get("tier")
        tier = LEGACY_TIER_ALIASES.get(str(raw_tier), raw_tier) if isinstance(raw_tier, str) else raw_tier
        if tier not in ATTESTED_ENCLAVE_TIERS:
            continue
        mid = str(entry.get("id") or "").strip()
        if not mid:
            continue
        if entry.get("status") == "archived" or is_model_effectively_deprecated(
            bool(entry.get("deprecated") is True),
            entry.get("deprecation_date"),
        ):
            continue
        routing = entry.get("routing")
        pa = routing.get("private_attested") if isinstance(routing, dict) else "blocked"
        if pa == "cleared":
            cleared_ids.append(mid)
        else:
            candidate_ids.append(mid)

    if len(cleared_ids) == 1:
        return cleared_ids[0]
    if len(cleared_ids) > 1:
        raise LocalAssistError(
            "routing_gate_blocked",
            f"Multiple Rung 2/3 models have routing.private_attested='cleared' ({cleared_ids}); "
            "pass --model <id> explicitly.",
            details={"cleared_models": cleared_ids},
        )
    raise LocalAssistError(
        "routing_gate_blocked",
        "No Rung 2/3 model in models.yaml is currently cleared for private-attested routing "
        "(routing.private_attested='cleared' requires passing automated sanity, v1 10/10, "
        f"tools 4/4, and opencode-smoke). Registered Rung 2/3 candidates: {candidate_ids}. "
        "To run an uncleared candidate explicitly, pass: "
        "./scripts/opencode-attested --model <model-id> --allow-uncleared-model",
        details={"candidate_models": candidate_ids},
    )


def validate_private_attested_endpoint(
    endpoint: EndpointConfig,
    *,
    allow_uncleared_model: bool = False,
    allow_deprecated_model: bool = False,
    err_stream: Any = None,
) -> None:
    if endpoint.trust_tier == "local":
        raise LocalAssistError(
            "trust_tier_blocked",
            f"scripts/opencode-attested is strictly for Rung 2/3 attested enclave proxies, "
            f"got '{endpoint.model_id}' with trust_tier='local'. "
            "Use ./scripts/opencode-local for Rung 1 local models.",
            details={
                "model_id": endpoint.model_id,
                "trust_tier": endpoint.trust_tier,
            },
        )
    if (
        endpoint.trust_tier not in ATTESTED_ENCLAVE_TIERS
        or endpoint.runtime != "proxy"
        or not endpoint.is_local_host
        or not endpoint.attestation_method
        or not endpoint.api_key_keychain_service
    ):
        raise LocalAssistError(
            "trust_tier_blocked",
            f"scripts/opencode-attested requires a Rung 2/3 attested enclave proxy bound to localhost "
            f"with apiKeyKeychainService, got '{endpoint.model_id}' "
            f"(trust_tier='{endpoint.trust_tier}', runtime='{endpoint.runtime}').",
            details={
                "model_id": endpoint.model_id,
                "trust_tier": endpoint.trust_tier,
                "runtime": endpoint.runtime,
            },
        )
    check_endpoint_lifecycle_status(
        endpoint,
        allow_deprecated_model=allow_deprecated_model,
        err_stream=err_stream,
    )
    if not bool(endpoint.capabilities.get("tool_calling")):
        raise LocalAssistError(
            "capability_missing",
            f"Model '{endpoint.model_id}' does not declare capabilities.tool_calling=true in models.yaml.",
            details={
                "model_id": endpoint.model_id,
                "capabilities": endpoint.capabilities,
            },
        )

    with _scoped_admission_env(allow_uncleared_model=allow_uncleared_model):
        check_private_coding_admission(endpoint)

    if endpoint.routing_private_attested != "cleared":
        out = err_stream if err_stream is not None else sys.stderr
        print(
            f"WARNING: Running private-attested with uncleared candidate model '{endpoint.model_id}' "
            f"(routing.private_attested={endpoint.routing_private_attested!r}).",
            file=out,
        )


def default_context_limit_for_endpoint(endpoint: EndpointConfig) -> int:
    if endpoint.context_window is not None and endpoint.context_window > 0:
        return int(endpoint.context_window)
    return DEFAULT_CONTEXT_LIMIT


def compute_worst_case_session_usd(
    endpoint: EndpointConfig,
    *,
    max_chat_requests: int = DEFAULT_MAX_CHAT_REQUESTS,
    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
    max_tokens_cap: int = DEFAULT_MAX_TOKENS_CAP,
) -> dict[str, Any]:
    if max_chat_requests <= 0 or max_request_bytes <= 0 or max_tokens_cap <= 0:
        raise ValueError(
            "max_chat_requests, max_request_bytes, and max_tokens_cap must be positive integers"
        )
    pricing = endpoint.pricing_per_m_tokens
    if (
        not isinstance(pricing, dict)
        or "input" not in pricing
        or "output" not in pricing
    ):
        raise LocalAssistError(
            "spend_gate_blocked",
            f"Model '{endpoint.model_id}' is missing remote_trust.pricing_per_m_tokens.input/output "
            "in models.yaml; cannot compute worst-case session spend ceiling.",
            details={"model_id": endpoint.model_id},
        )
    input_price = float(pricing["input"])
    output_price = float(pricing["output"])
    worst_input_tokens_per_req = int(
        math.ceil(max_request_bytes / WORST_CASE_BYTES_PER_TOKEN)
    )
    worst_input_usd = (
        max_chat_requests * worst_input_tokens_per_req * input_price
    ) / 1_000_000.0
    worst_output_usd = (
        max_chat_requests * max_tokens_cap * output_price
    ) / 1_000_000.0
    worst_total_usd = worst_input_usd + worst_output_usd
    return {
        "model_id": endpoint.model_id,
        "max_chat_requests": int(max_chat_requests),
        "max_request_bytes": int(max_request_bytes),
        "max_tokens_cap": int(max_tokens_cap),
        "worst_input_tokens_per_req": worst_input_tokens_per_req,
        "input_price_per_m": input_price,
        "output_price_per_m": output_price,
        "worst_input_usd": round(worst_input_usd, 6),
        "worst_output_usd": round(worst_output_usd, 6),
        "worst_total_usd": round(worst_total_usd, 6),
    }


def _positive_finite_float(raw: str) -> float:
    try:
        val = float(raw)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(
            f"must be a finite positive number, got {raw!r}"
        ) from exc
    if not math.isfinite(val) or val <= 0:
        raise argparse.ArgumentTypeError(
            f"must be a finite positive number, got {raw!r}"
        )
    return val


def check_session_spend_ceiling(
    endpoint: EndpointConfig,
    *,
    max_chat_requests: int = DEFAULT_MAX_CHAT_REQUESTS,
    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
    max_tokens_cap: int = DEFAULT_MAX_TOKENS_CAP,
    max_session_usd: float | None = DEFAULT_MAX_SESSION_USD,
    attached: bool = False,
) -> dict[str, Any]:
    if max_session_usd is not None:
        if (
            isinstance(max_session_usd, bool)
            or not isinstance(max_session_usd, (int, float))
            or not math.isfinite(float(max_session_usd))
            or float(max_session_usd) <= 0
        ):
            raise LocalAssistError(
                "spend_ceiling_invalid",
                f"Refusing to launch '{endpoint.model_id}': --max-session-usd must be a finite "
                f"positive USD ceiling, got {max_session_usd!r}.",
                details={"model_id": endpoint.model_id, "max_session_usd": max_session_usd},
            )
    est = compute_worst_case_session_usd(
        endpoint,
        max_chat_requests=max_chat_requests,
        max_request_bytes=max_request_bytes,
        max_tokens_cap=max_tokens_cap,
    )
    if not math.isfinite(float(est["worst_total_usd"])):
        raise LocalAssistError(
            "spend_ceiling_invalid",
            f"Refusing to launch '{endpoint.model_id}': computed worst-case session cost is non-finite "
            f"({est['worst_total_usd']!r}).",
            details={**est, "max_session_usd": max_session_usd, "attached": attached},
        )
    if max_session_usd is not None and est["worst_total_usd"] > float(max_session_usd):
        if attached:
            raise LocalAssistError(
                "spend_ceiling_exceeded",
                f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
                f"the running session's caps (max_chat_requests={max_chat_requests}, "
                f"max_request_bytes={max_request_bytes}, max_tokens_cap={max_tokens_cap}) "
                f"have a worst-case cost of ${est['worst_total_usd']:.2f}, which exceeds "
                f"--max-session-usd ${max_session_usd:.2f}. Run './scripts/stop-model {endpoint.model_id}' "
                "and relaunch so opencode-attested starts a proxy with bounded caps, or pass a "
                "higher --max-session-usd explicitly.",
                details={**est, "max_session_usd": max_session_usd, "attached": True},
            )
        raise LocalAssistError(
            "spend_ceiling_exceeded",
            f"Refusing to launch '{endpoint.model_id}': worst-case session cost from caps "
            f"(max_chat_requests={max_chat_requests}, max_request_bytes={max_request_bytes} "
            f"[~{est['worst_input_tokens_per_req']} input tokens/req], max_tokens_cap={max_tokens_cap} "
            f"at ${est['input_price_per_m']:.2f}/${est['output_price_per_m']:.2f} per 1M tokens) "
            f"is ${est['worst_total_usd']:.2f}, which exceeds --max-session-usd ${max_session_usd:.2f}. "
            "Pass lower --max-chat-requests / --max-request-bytes / --max-tokens-cap, or raise "
            "--max-session-usd explicitly.",
            details={**est, "max_session_usd": max_session_usd, "attached": False},
        )
    return est


def _extract_attached_session_caps(
    endpoint: EndpointConfig,
    active_rec: dict[str, Any] | None,
) -> tuple[int, int, int, int]:
    if not isinstance(active_rec, dict):
        raise LocalAssistError(
            "spend_ceiling_exceeded",
            f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
            "no PID record with bounded spend caps was found.",
            details={"model_id": endpoint.model_id, "attached": True},
        )
    raw_reqs = active_rec.get("max_chat_requests")
    raw_bytes = active_rec.get("max_request_bytes")
    raw_tokens = active_rec.get("max_tokens_cap")
    raw_ttl = active_rec.get("ttl_seconds")
    if (
        not isinstance(raw_reqs, int)
        or isinstance(raw_reqs, bool)
        or raw_reqs <= 0
        or not isinstance(raw_bytes, int)
        or isinstance(raw_bytes, bool)
        or raw_bytes <= 0
        or not isinstance(raw_tokens, int)
        or isinstance(raw_tokens, bool)
        or raw_tokens <= 0
        or not isinstance(raw_ttl, int)
        or isinstance(raw_ttl, bool)
        or raw_ttl <= 0
    ):
        raise LocalAssistError(
            "spend_ceiling_exceeded",
            f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
            f"the running session has unbounded or missing spend caps in its PID record "
            f"(max_chat_requests={raw_reqs!r}, max_request_bytes={raw_bytes!r}, "
            f"max_tokens_cap={raw_tokens!r}, ttl_seconds={raw_ttl!r}; max_tokens_cap=0 means unclamped output tokens "
            f"in se-key-proxy). Run './scripts/stop-model {endpoint.model_id}' and relaunch "
            "so opencode-attested starts a proxy with bounded caps.",
            details={
                "model_id": endpoint.model_id,
                "attached": True,
                "max_chat_requests": raw_reqs,
                "max_request_bytes": raw_bytes,
                "max_tokens_cap": raw_tokens,
                "ttl_seconds": raw_ttl,
            },
        )
    return int(raw_reqs), int(raw_bytes), int(raw_tokens), int(raw_ttl)


def format_session_banner(
    endpoint: EndpointConfig,
    session_meta: dict[str, Any],
    *,
    max_session_usd: float | None,
) -> str:
    mode_str = "attached to active proxy" if session_meta.get("attached") else "started proxy"
    ceiling_str = (
        f"enforced --max-session-usd ${max_session_usd:.2f}"
        if max_session_usd is not None
        else "no pre-flight --max-session-usd cap set"
    )
    ttl_val = session_meta["ttl_seconds"]
    ttl_str = str(ttl_val)
    started_at = session_meta.get("started_at")
    if session_meta.get("attached") and isinstance(started_at, str) and started_at.strip():
        try:
            started_dt = datetime.strptime(started_at.strip(), "%Y-%m-%dT%H:%M:%S%z")
            now_dt = datetime.now(started_dt.tzinfo)
            elapsed = max(0, int(now_dt.timestamp() - started_dt.timestamp()))
            rem_sec = max(0, int(ttl_val) - elapsed)
            rem_h = rem_sec // 3600
            rem_m = (rem_sec % 3600) // 60
            ttl_str = f"{ttl_val} (~{rem_h}h {rem_m}m remaining)"
        except Exception:
            ttl_str = str(ttl_val)
    lines = [
        f"[private-attested] Model: {endpoint.model_id} (served_model_id={endpoint.served_model_id}, {mode_str} at {endpoint.api_base_url})",
        f"[private-attested] Data-control rung: Rung {endpoint.data_control_rung} ({endpoint.trust_tier}, attestation={endpoint.attestation_method}, usage_policy={endpoint.usage_policy})",
        f"[private-attested] Data-control notice: workspace files read by the agent, approved bash outputs, conversation history, and local_assist MCP tool outputs (auto-allowed via 'local_assist*: allow' without an interactive prompt) returned to the planner are sent to the attested enclave under Rung {endpoint.data_control_rung} and {endpoint.usage_policy}.",
        f"[private-attested] Session caps: max_chat_requests={session_meta['max_chat_requests']} (includes small_model title requests), max_tokens_cap={session_meta['max_tokens_cap']}, max_request_bytes={session_meta['max_request_bytes']}, ttl_seconds={ttl_str}",
        f"[private-attested] Pricing: ${session_meta['input_price_per_m']:.2f}/1M input, ${session_meta['output_price_per_m']:.2f}/1M output ({ceiling_str})",
    ]
    if session_meta.get("low_caps_warning"):
        lines.append(
            f"[private-attested] WARNING: Attached session has eval-sized caps "
            f"(max_chat_requests={session_meta['max_chat_requests']}, "
            f"max_tokens_cap={session_meta['max_tokens_cap']}, "
            f"max_request_bytes={session_meta['max_request_bytes']}). "
            f"For interactive coding, run: ./scripts/opencode-attested --model {endpoint.model_id} --refresh-session"
        )
    if session_meta.get("attached"):
        lines.append(
            "[private-attested] To refresh the 12h session: ./scripts/opencode-attested --refresh-session"
        )
    return "\n".join(lines)


def render_private_attested_config(
    endpoint: EndpointConfig,
    template_text: str | None = None,
    *,
    context_limit: int | None = None,
    output_limit: int = DEFAULT_OUTPUT_LIMIT,
    max_tokens_cap: int | None = None,
    max_request_bytes: int | None = None,
    edit_permission: str = "ask",
    allow_subagents: bool = False,
    lab_python: Path | None = None,
    lab_root: Path | None = None,
    workspace_dir: Path | None = None,
    api_base_url_override: str | None = None,
) -> str:
    if edit_permission not in ("ask", "allow", "deny"):
        raise ValueError(f"Invalid edit_permission: {edit_permission}")
    effective_context_limit = (
        context_limit
        if context_limit is not None
        else default_context_limit_for_endpoint(endpoint)
    )
    effective_output_limit = output_limit
    if max_tokens_cap is not None and max_tokens_cap > 0:
        effective_output_limit = min(effective_output_limit, int(max_tokens_cap))
    if max_request_bytes is not None and max_request_bytes > 0:
        effective_context_limit = min(effective_context_limit, max(1, int(max_request_bytes) // 6))
    if effective_context_limit <= 0 or effective_output_limit <= 0:
        raise ValueError("context_limit and output_limit must be positive integers")

    tmpl = template_text if template_text is not None else TEMPLATE_CONFIG.read_text()
    api_key_placeholder = f"{{env:{SESSION_TOKEN_ENV_VAR}}}"
    effective_base_url = api_base_url_override or endpoint.api_base_url
    effective_python = lab_python or (
        VENV_PYTHON if VENV_PYTHON.exists() else Path(sys.executable)
    )
    effective_root = lab_root or ROOT
    effective_workspace = (workspace_dir or Path.cwd()).resolve()
    trust_label = f"Rung {endpoint.data_control_rung} {endpoint.trust_tier}"
    subagent_enabled_str = "true" if allow_subagents else "false"
    subagent_perm_str = "allow" if allow_subagents else "deny"

    rendered = (
        tmpl.replace("__API_BASE_URL__", _json_escape(effective_base_url))
        .replace("__API_KEY_VALUE__", _json_escape(api_key_placeholder))
        .replace("__SERVED_MODEL_ID__", _json_escape(endpoint.served_model_id))
        .replace("__MODEL_ID__", _json_escape(endpoint.model_id))
        .replace("__TRUST_TIER__", _json_escape(trust_label))
        .replace("__CONTEXT_LIMIT__", str(int(effective_context_limit)))
        .replace("__OUTPUT_LIMIT__", str(int(effective_output_limit)))
        .replace("__EDIT_PERMISSION__", _json_escape(edit_permission))
        .replace("__SUBAGENT_ENABLED__", subagent_enabled_str)
        .replace("__SUBAGENT_PERMISSION__", _json_escape(subagent_perm_str))
        .replace("__LAB_PYTHON__", _json_escape(effective_python))
        .replace("__LAB_ROOT__", _json_escape(effective_root))
        .replace("__WORKSPACE_DIR__", _json_escape(effective_workspace))
    )
    json.loads(rendered)
    return rendered


def build_private_attested_env(
    workspace_dir: Path,
    isolated_home: Path,
    opencode_config_path: Path,
    endpoint: EndpointConfig,
    *,
    preserve_host_home: bool = False,
    base_env: dict[str, str] | None = None,
) -> dict[str, str]:
    if not endpoint.api_key or not endpoint.api_key.startswith("se-session-"):
        raise LocalAssistError(
            "session_token_missing",
            f"Model '{endpoint.model_id}' does not have an active se-session-* token; "
            f"run './scripts/serve-model {endpoint.model_id}' first.",
            details={"model_id": endpoint.model_id},
        )
    env = build_isolated_opencode_env(
        workspace_dir,
        isolated_home,
        opencode_config_path,
        local_assist_base_url=RUNG1_LOCAL_ASSIST_BASE_URL,
        preserve_host_home=preserve_host_home,
        base_env=base_env,
        extra_env={SESSION_TOKEN_ENV_VAR: endpoint.api_key},
    )
    # L2: Never export LOCAL_ASSIST_ALLOW_ATTESTED_TEE or LOCAL_ASSIST_ALLOW_UNCLEARED_TEE
    env.pop("LOCAL_ASSIST_ALLOW_ATTESTED_TEE", None)
    env.pop("LOCAL_ASSIST_ALLOW_UNCLEARED_TEE", None)
    return env


def ensure_model_served(
    endpoint: EndpointConfig,
    *,
    no_serve: bool = False,
    refresh_session: bool = False,
    wait_seconds: float = DEFAULT_WAIT_SECONDS,
    max_chat_requests: int = DEFAULT_MAX_CHAT_REQUESTS,
    max_tokens_cap: int = DEFAULT_MAX_TOKENS_CAP,
    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
    ttl_seconds: int = DEFAULT_TTL_SECONDS,
    stream_timeout_seconds: int = DEFAULT_STREAM_TIMEOUT_SECONDS,
    max_session_usd: float | None = DEFAULT_MAX_SESSION_USD,
    explicit_port: int | None = None,
    explicit_cap_flags: Any = (),
    thinking: bool = False,
    explicit_thinking: bool = False,
    runs_dir: Path | None = None,
    run_cmd: Any = subprocess.run,
) -> tuple[bool, str | None, dict[str, Any] | None]:
    if refresh_session and no_serve:
        return (
            False,
            "Refusing --refresh-session (--restart) with --no-serve: refreshing a session requires starting a server/proxy.",
            None,
        )

    # Validate requested caps against spend ceiling before touching any server or Touch ID
    try:
        cli_est = check_session_spend_ceiling(
            endpoint,
            max_chat_requests=max_chat_requests,
            max_request_bytes=max_request_bytes,
            max_tokens_cap=max_tokens_cap,
            max_session_usd=max_session_usd,
            attached=False,
        )
    except LocalAssistError as exc:
        return False, str(exc), None

    verify_script = str(ROOT / "scripts" / "verify-served-model")
    serve_script = str(ROOT / "scripts" / "serve-model")
    stop_script = str(ROOT / "scripts" / "stop-model")

    pre_refresh_rec = read_pid_record_for_model(endpoint.model_id, runs_dir)
    rec_port_val = (pre_refresh_rec or {}).get("port")
    if explicit_port is not None:
        target_port: int | None = explicit_port
    elif isinstance(rec_port_val, int) and not isinstance(rec_port_val, bool):
        target_port = int(rec_port_val)
    else:
        target_port = endpoint.port
    effective_refresh = bool(refresh_session)
    serve_reqs = max_chat_requests
    serve_tokens = max_tokens_cap
    serve_bytes = max_request_bytes
    serve_ttl = ttl_seconds

    initial_verify_cmd = [verify_script, endpoint.model_id]
    if target_port is not None:
        initial_verify_cmd.extend(["--port", str(target_port)])
    initial = run_cmd(
        initial_verify_cmd,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        check=False,
    )
    if initial.returncode == 0 and not refresh_session:
        active_rec = read_pid_record_for_model(endpoint.model_id, runs_dir)
        try:
            rec_max_reqs, rec_max_bytes, rec_max_tokens, rec_ttl = (
                _extract_attached_session_caps(
                    endpoint,
                    active_rec,
                )
            )
            if rec_max_bytes < MIN_ATTACHED_REQUEST_BYTES:
                raise LocalAssistError(
                    "spend_ceiling_exceeded",
                    f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
                    f"max_request_bytes={rec_max_bytes} is below the {MIN_ATTACHED_REQUEST_BYTES}-byte minimum "
                    f"required for OpenCode tool schemas and conversation state. "
                    f"Run './scripts/stop-model {endpoint.model_id}' and relaunch.",
                    details={
                        "model_id": endpoint.model_id,
                        "attached": True,
                        "max_request_bytes": rec_max_bytes,
                    },
                )
            if (
                rec_max_reqs > max_chat_requests
                or rec_max_tokens > max_tokens_cap
                or rec_max_bytes > max_request_bytes
                or rec_ttl > ttl_seconds
            ):
                raise LocalAssistError(
                    "spend_ceiling_exceeded",
                    f"Refusing to attach to active proxy session for '{endpoint.model_id}': "
                    f"the running session's caps (max_chat_requests={rec_max_reqs}, "
                    f"max_tokens_cap={rec_max_tokens}, max_request_bytes={rec_max_bytes}, "
                    f"ttl_seconds={rec_ttl}) exceed the launcher's ceiling "
                    f"(max_chat_requests={max_chat_requests}, max_tokens_cap={max_tokens_cap}, "
                    f"max_request_bytes={max_request_bytes}, ttl_seconds={ttl_seconds}). "
                    f"Run './scripts/stop-model {endpoint.model_id}' and relaunch.",
                    details={
                        "model_id": endpoint.model_id,
                        "attached": True,
                        "max_chat_requests": rec_max_reqs,
                        "max_tokens_cap": rec_max_tokens,
                        "max_request_bytes": rec_max_bytes,
                        "ttl_seconds": rec_ttl,
                    },
                )
            attached_est = check_session_spend_ceiling(
                endpoint,
                max_chat_requests=rec_max_reqs,
                max_request_bytes=rec_max_bytes,
                max_tokens_cap=rec_max_tokens,
                max_session_usd=max_session_usd,
                attached=True,
            )
        except LocalAssistError as exc:
            return False, str(exc), None

        has_low_caps = (
            rec_max_reqs < MIN_INTERACTIVE_CHAT_REQUESTS
            or rec_max_tokens < MIN_INTERACTIVE_TOKENS_CAP
            or rec_max_bytes < MIN_INTERACTIVE_REQUEST_BYTES
        )
        has_explicit_cap_arg = (
            bool(explicit_cap_flags)
            or max_chat_requests != DEFAULT_MAX_CHAT_REQUESTS
            or max_tokens_cap != DEFAULT_MAX_TOKENS_CAP
            or max_request_bytes != DEFAULT_MAX_REQUEST_BYTES
            or ttl_seconds != DEFAULT_TTL_SECONDS
        )
        cap_auto_upgrade_needed = (not has_explicit_cap_arg) and has_low_caps
        rec_thinking = bool((active_rec or {}).get("thinking_enabled", False))
        thinking_auto_upgrade_needed = bool(explicit_thinking) and (
            rec_thinking != bool(thinking)
        )
        active_port = int((active_rec or {}).get("port") or endpoint.port)

        if (cap_auto_upgrade_needed or thinking_auto_upgrade_needed) and not no_serve:
            target_port = active_port
            effective_refresh = True
            if cap_auto_upgrade_needed:
                serve_reqs = max_chat_requests
                serve_tokens = max_tokens_cap
                serve_bytes = max_request_bytes
                serve_ttl = ttl_seconds
                print(
                    f"[private-attested] Active session for '{endpoint.model_id}' on port {active_port} "
                    f"has eval caps (max_chat_requests={rec_max_reqs}, max_tokens_cap={rec_max_tokens}, "
                    f"max_request_bytes={rec_max_bytes}); refreshing with interactive caps "
                    f"({serve_reqs} reqs, {serve_tokens} tokens, {serve_bytes} bytes)...",
                    file=sys.stderr,
                )
            else:
                serve_reqs = rec_max_reqs
                serve_tokens = rec_max_tokens
                serve_bytes = rec_max_bytes
                serve_ttl = rec_ttl
                print(
                    f"[private-attested] Refreshing session for '{endpoint.model_id}' on port {active_port} "
                    f"to set thinking={bool(thinking)}...",
                    file=sys.stderr,
                )
        else:
            return (
                True,
                None,
                {
                    **attached_est,
                    "attached": True,
                    "ttl_seconds": rec_ttl,
                    "started_at": (active_rec or {}).get("started_at"),
                    "low_caps_warning": bool(has_low_caps),
                    "thinking_enabled": rec_thinking,
                    "allocated_port": active_port,
                },
            )

    initial_err = (initial.stderr or initial.stdout or "").strip()
    if initial.returncode == EXIT_MODEL_MISMATCH:
        check_port = target_port if target_port is not None else endpoint.port
        owned_by_other, owner_mid = is_port_owned_by_different_active_model(
            endpoint.model_id,
            check_port,
            runs_dir=runs_dir,
        )
        if owned_by_other and not no_serve and explicit_port is None:
            try:
                target_port = allocate_side_by_side_port(
                    check_port,
                    uses_upstream_port=True,
                    runs_dir=runs_dir,
                )
            except LocalAssistError as exc:
                return False, str(exc), None
            print(
                f"[private-attested] Port {check_port} is active for '{owner_mid}'; "
                f"allocating side-by-side port {target_port} (upstream {target_port + 1000}) for '{endpoint.model_id}'.",
                file=sys.stderr,
            )
        elif (
            refresh_session
            and not no_serve
            and not owned_by_other
            and pre_refresh_rec is not None
        ):
            pass
        else:
            return (
                False,
                f"Refusing to launch private-attested: another model is already serving at "
                f"{endpoint.api_base_url} ({initial_err}). Stop the active model first "
                "with ./scripts/stop-model <active-model-id>.",
                None,
            )

    if refresh_session and (
        initial.returncode == 0
        or pre_refresh_rec is not None
        or read_pid_record_for_model(endpoint.model_id, runs_dir) is not None
    ):
        stop_res = run_cmd(
            [stop_script, endpoint.model_id],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            check=False,
        )
        if stop_res.returncode != 0:
            stop_err = (stop_res.stderr or stop_res.stdout or "").strip()
            return (
                False,
                f"Failed to stop active session for '{endpoint.model_id}' during --refresh-session: {stop_err}",
                None,
            )

    if no_serve:
        return (
            False,
            f"Model '{endpoint.model_id}' is not currently served at {endpoint.api_base_url} "
            f"and --no-serve was set ({initial_err}).",
            None,
        )

    serve_cmd = [
        serve_script,
        endpoint.model_id,
        "--max-chat-requests",
        str(serve_reqs),
        "--max-tokens-cap",
        str(serve_tokens),
        "--max-request-bytes",
        str(serve_bytes),
        "--ttl-seconds",
        str(serve_ttl),
        "--stream-timeout-seconds",
        str(stream_timeout_seconds),
    ]
    if target_port is not None:
        serve_cmd.extend(["--port", str(target_port)])
    if thinking:
        serve_cmd.append("--thinking")
    if effective_refresh:
        serve_cmd.append("--refresh-session")
    serve_res = run_cmd(
        serve_cmd,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        check=False,
    )
    if serve_res.returncode != 0:
        serve_err = (serve_res.stderr or serve_res.stdout or "").strip()
        return False, f"Failed to start model '{endpoint.model_id}': {serve_err}", None

    wait_verify_cmd = [verify_script, endpoint.model_id, "--wait", str(wait_seconds)]
    if target_port is not None:
        wait_verify_cmd.extend(["--port", str(target_port)])
    wait_res = run_cmd(
        wait_verify_cmd,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        check=False,
    )
    if wait_res.returncode == 0:
        active_rec = read_pid_record_for_model(endpoint.model_id, runs_dir)
        if active_rec is not None:
            try:
                rec_max_reqs, rec_max_bytes, rec_max_tokens, rec_ttl = (
                    _extract_attached_session_caps(
                        endpoint,
                        active_rec,
                    )
                )
            except LocalAssistError as exc:
                return False, str(exc), None
        else:
            rec_max_reqs = serve_reqs
            rec_max_bytes = serve_bytes
            rec_max_tokens = serve_tokens
            rec_ttl = serve_ttl
        try:
            started_est = check_session_spend_ceiling(
                endpoint,
                max_chat_requests=rec_max_reqs,
                max_request_bytes=rec_max_bytes,
                max_tokens_cap=rec_max_tokens,
                max_session_usd=max_session_usd,
                attached=True,
            )
        except LocalAssistError as exc:
            return False, str(exc), None
        resolved_port = int(
            (active_rec or {}).get("port")
            or (target_port if target_port is not None else endpoint.port)
        )
        return (
            True,
            None,
            {
                **started_est,
                "attached": False,
                "ttl_seconds": rec_ttl,
                "thinking_enabled": bool(thinking),
                "allocated_port": resolved_port,
            },
        )

    wait_err = (wait_res.stderr or wait_res.stdout or "").strip()
    if wait_res.returncode == EXIT_MODEL_MISMATCH:
        return (
            False,
            f"Refusing to launch private-attested: model mismatch at {endpoint.api_base_url} "
            f"after startup ({wait_err}).",
            None,
        )
    return (
        False,
        f"Model '{endpoint.model_id}' did not become ready within {wait_seconds}s: {wait_err}",
        None,
    )


def parse_args(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(
        description=(
            "Launch opencode against a Rung 2/3 private-attested enclave proxy "
            "(tinfoil-proxy + se-key-proxy) with isolated state, project-config "
            "lockdown, session spend ceiling, and Rung 1 local_assist MCP."
        ),
        epilog=(
            "Data-control notice: Running opencode-attested sends workspace files read by "
            "the agent, approved bash outputs, conversation history, and local_assist MCP "
            "tool outputs returned to the planner to the attested enclave under the model's "
            "remote_trust.tier (for example enclave_runtime_attested) and usage_policy "
            "(provider_terms_apply). Always place '--' before opencode subcommands or flags "
            "(for example: opencode-attested --model tinfoil-deepseek-v4-1-flash "
            "--allow-uncleared-model -- run 'prompt')."
        ),
    )
    parser.add_argument(
        "--model",
        default=None,
        help=(
            "Rung 2/3 model id from models.yaml. If omitted, selects the single model "
            "with routing.private_attested='cleared' (or refuses when none is cleared)."
        ),
    )
    parser.add_argument(
        "--allow-uncleared-model",
        action="store_true",
        default=False,
        help="Allow launching a Rung 2/3 candidate whose routing.private_attested is not 'cleared'.",
    )
    parser.add_argument(
        "--context-limit",
        type=int,
        default=None,
        help=(
            f"Context window limit in opencode config (default: model.context_window from models.yaml, "
            f"or {DEFAULT_CONTEXT_LIMIT} if unset; clamped when attaching to a tighter proxy session)."
        ),
    )
    parser.add_argument(
        "--max-chat-requests",
        type=int,
        default=None,
        help=f"se-key-proxy chat request cap per session, including title-agent requests (default: {DEFAULT_MAX_CHAT_REQUESTS}).",
    )
    parser.add_argument(
        "--max-tokens-cap",
        type=int,
        default=None,
        help=f"se-key-proxy max_tokens cap per request (default: {DEFAULT_MAX_TOKENS_CAP}).",
    )
    parser.add_argument(
        "--max-request-bytes",
        type=int,
        default=None,
        help=f"se-key-proxy max HTTP request body bytes (default: {DEFAULT_MAX_REQUEST_BYTES}).",
    )
    parser.add_argument(
        "--ttl-seconds",
        type=int,
        default=None,
        help=f"se-key-proxy session TTL in seconds (default: {DEFAULT_TTL_SECONDS}).",
    )
    parser.add_argument(
        "--stream-timeout-seconds",
        type=int,
        default=DEFAULT_STREAM_TIMEOUT_SECONDS,
        help=f"se-key-proxy stream timeout in seconds (default: {DEFAULT_STREAM_TIMEOUT_SECONDS}).",
    )
    parser.add_argument(
        "--max-session-usd",
        type=float,
        default=DEFAULT_MAX_SESSION_USD,
        help="Optional maximum worst-case session spend in USD permitted before launch (when omitted, prints pricing and caps without blocking interactive launch).",
    )
    parser.add_argument(
        "--thinking",
        action="store_true",
        default=False,
        help="Allow model reasoning/thinking chains (<think>) instead of injecting model passthrough thinking=false defaults.",
    )
    add_common_launcher_arguments(
        parser,
        default_output_limit=DEFAULT_OUTPUT_LIMIT,
        default_wait_seconds=DEFAULT_WAIT_SECONDS,
        wait_help=f"Seconds to wait for proxy readiness when starting (default: {DEFAULT_WAIT_SECONDS}).",
        no_serve_help="Do not automatically start the proxy session if it is not already running.",
        print_config_help="Verify/start the proxy, write the isolated opencode.json, print redacted metadata and JSON, and exit.",
        unattended_help="Enforce the default unattended_worker security profile (Seatbelt OS sandbox + default-deny permissions + loopback token relay).",
    )
    args, opencode_args = split_launcher_argv(parser, argv)
    our_argv = (
        argv[1 : argv.index("--", 1)]
        if "--" in argv[1:]
        else argv[1:]
    )
    cap_flag_map = {
        "--max-chat-requests": "max_chat_requests",
        "--max-tokens-cap": "max_tokens_cap",
        "--max-request-bytes": "max_request_bytes",
        "--ttl-seconds": "ttl_seconds",
    }
    explicit_caps: set[str] = set()
    for flag_tok, dest_name in cap_flag_map.items():
        if any(tok == flag_tok or tok.startswith(f"{flag_tok}=") for tok in our_argv):
            explicit_caps.add(dest_name)
    args.explicit_cap_flags = frozenset(explicit_caps)
    args.explicit_thinking = any(tok == "--thinking" for tok in our_argv)
    return args, opencode_args


def main(argv: list[str]) -> int:
    caller_cwd = Path.cwd()
    args, opencode_args = parse_args(argv)

    try:
        active_profile = _resolve_active_security_profile(args)
    except SecurityProfileError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    flag_err = validate_common_worker_flags(args, active_profile)
    if flag_err:
        print(flag_err, file=sys.stderr)
        return 1

    effective_allow_uncleared = (
        active_profile.allow_uncleared_model
        if active_profile is not None
        else args.allow_uncleared_model
    )
    effective_max_session_usd = (
        args.max_session_usd
        if args.max_session_usd is not None
        else (active_profile.spend_max_session_usd if active_profile is not None else None)
    )
    if active_profile is not None and (
        effective_max_session_usd is None
        or isinstance(effective_max_session_usd, bool)
        or not isinstance(effective_max_session_usd, (int, float))
        or not math.isfinite(float(effective_max_session_usd))
        or float(effective_max_session_usd) <= 0
    ):
        print(
            "Unattended worker mode on private-attested requires an explicit spend ceiling (finite positive USD): "
            "pass --max-session-usd <usd> or set spend.max_session_usd in the security profile.",
            file=sys.stderr,
        )
        return 1

    eff_max_reqs = (
        args.max_chat_requests
        if args.max_chat_requests is not None
        else DEFAULT_MAX_CHAT_REQUESTS
    )
    eff_max_tokens = (
        args.max_tokens_cap
        if args.max_tokens_cap is not None
        else DEFAULT_MAX_TOKENS_CAP
    )
    eff_max_bytes = (
        args.max_request_bytes
        if args.max_request_bytes is not None
        else DEFAULT_MAX_REQUEST_BYTES
    )
    eff_ttl = (
        args.ttl_seconds
        if args.ttl_seconds is not None
        else DEFAULT_TTL_SECONDS
    )

    if (
        eff_max_reqs <= 0
        or eff_max_tokens <= 0
        or eff_max_bytes <= 0
        or eff_ttl <= 0
        or args.stream_timeout_seconds <= 0
        or args.output_limit <= 0
        or args.wait < 0
        or (args.context_limit is not None and args.context_limit <= 0)
        or (
            effective_max_session_usd is not None
            and (
                isinstance(effective_max_session_usd, bool)
                or not isinstance(effective_max_session_usd, (int, float))
                or not math.isfinite(float(effective_max_session_usd))
                or float(effective_max_session_usd) <= 0
            )
        )
    ):
        print(
            "All cap/limit flags (--max-chat-requests, --max-tokens-cap, --max-request-bytes, "
            "--ttl-seconds, --stream-timeout-seconds, --output-limit, --context-limit, --max-session-usd) must be finite values > 0 and --wait >= 0.",
            file=sys.stderr,
        )
        return 1

    effective_no_serve = True if active_profile is not None else args.no_serve

    try:
        model_id = args.model or resolve_default_attested_model_id()
        model = load_model(model_id)
        initial_pid_record = read_pid_record_for_model(model_id)
        if args.port is not None and isinstance(initial_pid_record, dict):
            init_active, init_unavail = pid_record_is_live_or_starting(initial_pid_record)
            existing_port = initial_pid_record.get("port")
            if (
                (init_active or init_unavail)
                and isinstance(existing_port, int)
                and existing_port != args.port
                and (effective_no_serve or not bool(getattr(args, "refresh_session", False)))
            ):
                print(
                    f"Refusing to launch '{model_id}' on --port {args.port}: '{model_id}' is already active on port {existing_port}. "
                    f"Omit --port (or pass --port {existing_port}) to attach, or pass --refresh-session to move it to port {args.port}.",
                    file=sys.stderr,
                )
                return 1
        endpoint_pre = resolve_endpoint(
            model,
            pid_record=initial_pid_record,
            require_api_key=False,
            port_override=args.port,
        )
        validate_private_attested_endpoint(
            endpoint_pre,
            allow_uncleared_model=effective_allow_uncleared,
            allow_deprecated_model=bool(getattr(args, "allow_deprecated_model", False)),
        )
    except (RegistryError, LocalAssistError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1

    opencode_bin: str | None = shutil.which("opencode")
    if not args.print_config and not opencode_bin:
        print("opencode binary not found on PATH", file=sys.stderr)
        return 1

    sandbox_exec_bin = Path("/usr/bin/sandbox-exec")
    worker_ok, validated_worker_args, worker_err = validate_worker_binary_and_args(
        args,
        active_profile,
        opencode_bin,
        opencode_args,
        sandbox_exec_bin,
    )
    if not worker_ok:
        print(worker_err or "Worker preflight validation failed", file=sys.stderr)
        return 1

    ok, err_msg, session_meta = ensure_model_served(
        endpoint_pre,
        no_serve=effective_no_serve,
        refresh_session=bool(getattr(args, "refresh_session", False)),
        wait_seconds=args.wait,
        max_chat_requests=eff_max_reqs,
        max_tokens_cap=eff_max_tokens,
        max_request_bytes=eff_max_bytes,
        ttl_seconds=eff_ttl,
        stream_timeout_seconds=args.stream_timeout_seconds,
        max_session_usd=effective_max_session_usd,
        explicit_port=args.port,
        explicit_cap_flags=getattr(args, "explicit_cap_flags", ()),
        thinking=bool(getattr(args, "thinking", False)),
        explicit_thinking=bool(getattr(args, "explicit_thinking", False)),
    )
    if not ok or session_meta is None:
        print(err_msg or "Failed to verify served model", file=sys.stderr)
        if err_msg and "another model is already serving" in err_msg:
            return EXIT_MODEL_MISMATCH
        return 1

    try:
        active_pid_record = read_pid_record_for_model(model_id)
        post_port_override = (
            (session_meta.get("allocated_port") or args.port)
            if active_pid_record is None
            else None
        )
        endpoint = resolve_endpoint(
            model,
            pid_record=active_pid_record,
            require_api_key=True,
            port_override=post_port_override,
        )
        validate_private_attested_endpoint(
            endpoint,
            allow_uncleared_model=effective_allow_uncleared,
            allow_deprecated_model=bool(getattr(args, "allow_deprecated_model", False)),
        )
    except (RegistryError, LocalAssistError) as exc:
        print(str(exc), file=sys.stderr)
        return 1

    print(
        format_session_banner(
            endpoint,
            session_meta,
            max_session_usd=effective_max_session_usd,
        ),
        file=sys.stderr,
    )

    sess_tokens_cap = int(session_meta["max_tokens_cap"])
    sess_bytes_cap = int(session_meta["max_request_bytes"])
    if args.context_limit is not None and sess_bytes_cap > 0 and args.context_limit > max(1, sess_bytes_cap // 6):
        print(
            f"[private-attested] Notice: clamping requested --context-limit {args.context_limit} "
            f"to {max(1, sess_bytes_cap // 6)} tokens to fit session max_request_bytes={sess_bytes_cap}.",
            file=sys.stderr,
        )
    if args.output_limit > sess_tokens_cap > 0:
        print(
            f"[private-attested] Notice: clamping requested --output-limit {args.output_limit} "
            f"to {sess_tokens_cap} tokens to fit session max_tokens_cap={sess_tokens_cap}.",
            file=sys.stderr,
        )

    if active_profile is not None:
        upstream_port_val = (
            int(active_pid_record["upstream_port"])
            if isinstance(active_pid_record, dict)
            and isinstance(active_pid_record.get("upstream_port"), int)
            else 9181
        )

        worker_default_chat_params: dict[str, Any] | None = None
        if isinstance(active_pid_record, dict) and isinstance(
            active_pid_record.get("default_chat_params"), dict
        ):
            worker_default_chat_params = dict(active_pid_record["default_chat_params"])
        elif not bool(getattr(args, "thinking", False)):
            raw_prov = model.get("promptfoo_provider")
            raw_cfg = raw_prov.get("config") if isinstance(raw_prov, dict) else None
            raw_pt = raw_cfg.get("passthrough") if isinstance(raw_cfg, dict) else None
            if isinstance(raw_pt, dict) and raw_pt:
                worker_default_chat_params = dict(raw_pt)

        def _build_att_base_cfg(relay: _WorkerTokenRelay | None) -> dict[str, Any]:
            assert relay is not None
            base_config_text = render_private_attested_config(
                endpoint,
                context_limit=args.context_limit,
                output_limit=args.output_limit,
                max_tokens_cap=sess_tokens_cap,
                max_request_bytes=sess_bytes_cap,
                edit_permission="allow",
                allow_subagents=bool(active_profile.allow_subagents),
                workspace_dir=caller_cwd,
                api_base_url_override=relay.api_base_url,
            )
            base_cfg = json.loads(base_config_text)
            base_cfg["provider"]["private-attested"]["options"]["baseURL"] = relay.api_base_url
            base_cfg["provider"]["private-attested"]["options"]["apiKey"] = relay.relay_token
            return base_cfg

        return execute_worker_profile_session(
            active_profile=active_profile,
            args=args,
            caller_cwd=caller_cwd,
            opencode_bin=opencode_bin,
            sandbox_exec_bin=sandbox_exec_bin,
            validated_worker_args=validated_worker_args,
            build_base_config_fn=_build_att_base_cfg,
            build_print_config_payload_fn=lambda worker_id, cfg_path, sb_path, iso_home, compiled_cfg, relay: {
                "model_id": endpoint.model_id,
                "served_model_id": endpoint.served_model_id,
                "trust_tier": endpoint.trust_tier,
                "data_control_rung": endpoint.data_control_rung,
                "usage_policy": endpoint.usage_policy,
                "api_base_url": endpoint.api_base_url,
                "worker_relay_base_url": relay.api_base_url if relay is not None else "",
                "session_token": "<redacted-se-session-token>",
                "session_caps": session_meta,
                "worker_id": worker_id,
                "opencode_config_path": str(cfg_path),
                "seatbelt_profile_path": str(sb_path),
                "isolated_home": str(iso_home),
                "config": compiled_cfg,
            },
            relay_factory=lambda: _WorkerTokenRelay(
                upstream_base_url=endpoint.api_base_url,
                upstream_session_token=endpoint.api_key,
                max_chat_requests=int(session_meta["max_chat_requests"]),
                max_request_bytes=sess_bytes_cap,
                max_tokens_cap=sess_tokens_cap,
                upstream_timeout_seconds=float(args.stream_timeout_seconds),
                default_chat_params=worker_default_chat_params,
            ),
            upstream_port=upstream_port_val,
            use_token_relay=True,
            allocate_worker_home_fn=allocate_worker_home,
        )

    isolated_home = DEFAULT_ISOLATED_HOME
    for subdir in (".config", ".local/share", ".cache", ".local/state"):
        (isolated_home / subdir).mkdir(parents=True, exist_ok=True)

    edit_permission = "allow" if args.allow_edit else "ask"
    config_text = render_private_attested_config(
        endpoint,
        context_limit=args.context_limit,
        output_limit=args.output_limit,
        max_tokens_cap=sess_tokens_cap,
        max_request_bytes=sess_bytes_cap,
        edit_permission=edit_permission,
        allow_subagents=bool(getattr(args, "allow_subagents", False)),
        workspace_dir=caller_cwd,
    )

    token_sha = hashlib.sha256((endpoint.api_key or "").encode("utf-8")).hexdigest()
    current_sync = {
        "model_id": endpoint.model_id,
        "startup_nonce": (active_pid_record or {}).get("startup_nonce"),
        "token_sha256": token_sha,
    }
    return publish_and_run_opencode(
        opencode_bin=opencode_bin,
        opencode_args=opencode_args,
        caller_cwd=caller_cwd,
        isolated_home=isolated_home,
        endpoint=endpoint,
        config_text=config_text,
        build_env_fn=lambda cfg_path: build_private_attested_env(
            caller_cwd,
            isolated_home,
            cfg_path,
            endpoint,
            preserve_host_home=args.preserve_host_home,
        ),
        current_sync=current_sync,
        print_config=bool(args.print_config),
        build_print_config_payload_fn=lambda cfg_path, parsed_cfg: {
            "model_id": endpoint.model_id,
            "served_model_id": endpoint.served_model_id,
            "trust_tier": endpoint.trust_tier,
            "data_control_rung": endpoint.data_control_rung,
            "usage_policy": endpoint.usage_policy,
            "api_base_url": endpoint.api_base_url,
            "session_token": "<redacted-se-session-token>",
            "session_caps": session_meta,
            "opencode_config_path": str(cfg_path),
            "isolated_home": str(isolated_home),
            "config": parsed_cfg,
        },
    )


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
