#!/usr/bin/env python3
from __future__ import annotations

import contextlib
import fcntl
import json
import os
import signal
import sys
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from local_assist.custody import (
    bind_pinned_runs_dir,
    get_active_bootstrap_state,
    inspect_existing_runs_dir,
    is_custody_tree,
    parse_pinned_runs_stat_env,
    runs_store_open_file,
    runs_store_read_text,
    runs_store_unlink,
    set_cli_runs_dir_override,
    validate_creatable_runs_dir,
)
from local_assist.registry import (
    RegistryError,
    _legacy_unhashed_pid_file,
    _effective_runs_dir,
    get_process_command,
    get_process_lstart,
    legacy_pid_file,
    list_pid_records,
    pid_file_for_model,
    pid_is_alive,
    pid_is_zombie,
    pid_matches_record,
    session_token_file_for_model,
)


try:
    _INITIAL_RUNS = _effective_runs_dir()
except RegistryError:
    _INITIAL_RUNS = ROOT / "runs"
RUNS = _INITIAL_RUNS


@contextlib.contextmanager
def _pid_lock(runs_dir: Path):
    with runs_store_open_file(runs_dir, ".pid.lock", append=False, mode=0o600) as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def _terminate_verified_pid(pid: int, expected_lstart: str | None) -> bool:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    except PermissionError:
        print(f"Permission denied when signaling pid {pid}.", file=sys.stderr)
        return False
    for _ in range(50):
        if not pid_is_alive(pid) or pid_is_zombie(pid):
            return True
        time.sleep(0.1)
    if not pid_is_alive(pid) or pid_is_zombie(pid):
        return True

    if expected_lstart is not None:
        actual_lstart = get_process_lstart(pid)
        if actual_lstart is None:
            if not pid_is_alive(pid) or pid_is_zombie(pid):
                return True
            print(
                f"Refusing to escalate SIGKILL to live pid {pid}: could not verify process start time (lstart) via ps.",
                file=sys.stderr,
            )
            return False
        if actual_lstart != expected_lstart.strip():
            # Original process exited and PID was reused during the SIGTERM wait window
            return True

    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    except PermissionError:
        print(f"Permission denied when escalating SIGKILL to pid {pid}.", file=sys.stderr)
        return False

    for _ in range(20):
        if not pid_is_alive(pid) or pid_is_zombie(pid):
            return True
        time.sleep(0.05)
    if not pid_is_alive(pid) or pid_is_zombie(pid):
        return True
    if expected_lstart is not None:
        post_lstart = get_process_lstart(pid)
        if post_lstart is not None and post_lstart != expected_lstart.strip():
            return True
    print(f"Process pid {pid} remained alive after SIGKILL.", file=sys.stderr)
    return False


def _kill_pid(
    pid: Any,
    expected_lstart: Any,
    label: str,
    stopped_pids: set[int],
    *,
    force_legacy: bool = False,
) -> bool:
    if not isinstance(pid, int) or pid <= 1:
        return True
    if pid in stopped_pids:
        return True
    if not pid_is_alive(pid):
        stopped_pids.add(pid)
        print(f"Server pid {pid} ({label}) was not running.")
        return True

    if not isinstance(expected_lstart, str) or not expected_lstart.strip():
        if not force_legacy:
            cmd_str = get_process_command(pid) or "<unknown>"
            print(
                f"Refusing to signal live pid {pid} ({label}, command: {cmd_str}) without pid_lstart verification; "
                "re-run with --force-legacy to force stop or --discard-legacy to remove the record without signaling.",
                file=sys.stderr,
            )
            return False
        if not _terminate_verified_pid(pid, None):
            return False
        stopped_pids.add(pid)
        print(f"Stopped server pid {pid} ({label}).")
        return True

    clean_expected = expected_lstart.strip()
    actual_lstart = get_process_lstart(pid)
    if actual_lstart is None:
        if not pid_is_alive(pid):
            stopped_pids.add(pid)
            print(f"Server pid {pid} ({label}) was not running.")
            return True
        print(
            f"Refusing to signal live pid {pid} ({label}): could not read process start time (lstart) via ps.",
            file=sys.stderr,
        )
        return False

    if actual_lstart != clean_expected:
        stopped_pids.add(pid)
        print(f"Skipping pid {pid} ({label}): process start time mismatch (PID reused by another process).")
        return True

    if not _terminate_verified_pid(pid, clean_expected):
        return False
    stopped_pids.add(pid)
    print(f"Stopped server pid {pid} ({label}).")
    return True


def _safe_unlink_token_file(candidate: Path, runs_dir: Path) -> None:
    try:
        name = candidate.name
        if not (name.startswith(".se-session-") and name.endswith(".token")):
            return
        if candidate.parent == runs_dir or candidate.resolve().parent == runs_dir.resolve():
            runs_store_unlink(runs_dir, name)
    except OSError:
        pass


def _has_live_bound_pid(pid: Any, expected_lstart: Any) -> bool:
    if not isinstance(pid, int) or pid <= 1:
        return False
    if not isinstance(expected_lstart, str) or not expected_lstart.strip():
        return False
    if not pid_is_alive(pid):
        return False
    actual_lstart = get_process_lstart(pid)
    if actual_lstart is None:
        return pid_is_alive(pid)
    return actual_lstart == expected_lstart.strip()


def _stop_record(
    record: dict,
    stopped_pids: set[int],
    *,
    force_legacy: bool = False,
    discard_legacy: bool = False,
) -> bool:
    pid = record.get("pid")
    upstream_pid = record.get("upstream_pid")
    model_id = record.get("model_id", "unknown")

    if discard_legacy:
        for cand_pid, cand_lstart, cand_label in (
            (pid, record.get("pid_lstart"), model_id),
            (upstream_pid, record.get("upstream_pid_lstart"), f"{model_id}:upstream"),
        ):
            if _has_live_bound_pid(cand_pid, cand_lstart):
                print(
                    f"Refusing --discard-legacy for {model_id}: record contains a live start-time-bound process "
                    f"(pid={cand_pid}, {cand_label}); run './scripts/stop-model {model_id}' to stop verified processes.",
                    file=sys.stderr,
                )
                return False
        token_file = record.get("session_token_file")
        if isinstance(token_file, str) and token_file.strip():
            _safe_unlink_token_file(Path(token_file), RUNS)
        if isinstance(model_id, str) and model_id and model_id != "unknown":
            _safe_unlink_token_file(session_token_file_for_model(model_id, RUNS), RUNS)
        print(f"Discarded legacy PID record for {model_id} without signaling.")
        return True

    ok = True
    if not isinstance(pid, int) and not isinstance(upstream_pid, int):
        if record.get("status") == "starting":
            print(f"Removed provisional starting PID record and session token for {model_id}.")
        else:
            print(f"PID file for {model_id} does not contain a valid pid.")
    else:
        if isinstance(pid, int) and pid > 1:
            if not _kill_pid(
                pid,
                record.get("pid_lstart"),
                model_id,
                stopped_pids,
                force_legacy=force_legacy,
            ):
                ok = False
        if isinstance(upstream_pid, int) and upstream_pid > 1:
            if not _kill_pid(
                upstream_pid,
                record.get("upstream_pid_lstart"),
                f"{model_id}:upstream",
                stopped_pids,
                force_legacy=force_legacy,
            ):
                ok = False

    if ok:
        if isinstance(model_id, str) and model_id and model_id != 'unknown':
            from local_assist.session import remove_stale_control_socket
            try:
                if not remove_stale_control_socket(RUNS, model_id, int(pid or 0)):
                    print('Refusing cleanup of an unverifiable control socket.', file=sys.stderr)
                    return False
            except (OSError, ValueError):
                return False
        token_file = record.get("session_token_file")
        if isinstance(token_file, str) and token_file.strip():
            _safe_unlink_token_file(Path(token_file), RUNS)
        if isinstance(model_id, str) and model_id and model_id != "unknown":
            _safe_unlink_token_file(session_token_file_for_model(model_id, RUNS), RUNS)
    return ok


def main(argv: list[str]) -> int:
    global RUNS

    force_legacy = False
    discard_legacy = False
    raw_runs_dir: str | None = None
    pos_args: list[str] = []
    tokens = list(argv[1:])
    idx = 0
    while idx < len(tokens):
        arg = tokens[idx]
        if arg == "--force-legacy":
            force_legacy = True
            idx += 1
        elif arg == "--discard-legacy":
            discard_legacy = True
            idx += 1
        elif arg == "--runs-dir":
            if idx + 1 >= len(tokens):
                print("--runs-dir requires an absolute directory path.", file=sys.stderr)
                return 1
            raw_runs_dir = tokens[idx + 1]
            idx += 2
        elif arg.startswith("--runs-dir="):
            raw_runs_dir = arg.split("=", 1)[1]
            idx += 1
        else:
            pos_args.append(arg)
            idx += 1

    if len(pos_args) > 1 or (force_legacy and discard_legacy):
        print(
            "usage: scripts/stop-model [--runs-dir <abs-path>] [--force-legacy | --discard-legacy] [model-id | --all]",
            file=sys.stderr,
        )
        return 2

    prev_boot = get_active_bootstrap_state()
    prev_runs = RUNS
    inproc_runs_applied = False
    in_custody = (prev_boot is not None and prev_boot.custody_mode) or is_custody_tree(ROOT)
    expected_stat, pin_err = parse_pinned_runs_stat_env()
    if pin_err is not None and not in_custody:
        print(pin_err, file=sys.stderr)
        return 1

    if raw_runs_dir is not None:
        if in_custody:
            print("Refusing --runs-dir in read-only/custody mode.", file=sys.stderr)
            return 1
        v_runs, runs_err = inspect_existing_runs_dir(
            raw_runs_dir,
            expected_stat=expected_stat,
            label="--runs-dir",
        )
        if runs_err is not None or v_runs is None:
            print(runs_err or "Invalid --runs-dir.", file=sys.stderr)
            return 1
        set_cli_runs_dir_override(v_runs.path, runs_stat=v_runs.stat_id)
        RUNS = v_runs.path
        expected_stat = v_runs.stat_id
        inproc_runs_applied = True
    elif RUNS == _INITIAL_RUNS:
        try:
            RUNS = _effective_runs_dir()
        except RegistryError as exc:
            print(str(exc), file=sys.stderr)
            return 1
        if not in_custody:
            if expected_stat is not None:
                v_eff, eff_err = inspect_existing_runs_dir(
                    RUNS,
                    expected_stat=expected_stat,
                    label="FREE_INFERENCE_RUNS_DIR",
                )
                if eff_err is not None or v_eff is None:
                    print(eff_err or "Invalid session store directory.", file=sys.stderr)
                    RUNS = prev_runs
                    return 1
                RUNS = v_eff.path
            else:
                v_eff, eff_err = validate_creatable_runs_dir(RUNS, label="FREE_INFERENCE_RUNS_DIR")
                if eff_err is not None or v_eff is None:
                    print(eff_err or "Invalid session store directory.", file=sys.stderr)
                    return 1
                RUNS = v_eff.path
                if not v_eff.exists:
                    target = pos_args[0] if pos_args else None
                    if target and target != "--all":
                        print(f"No active server PID file found for {target}.")
                    else:
                        print("No active server PID file found.")
                    RUNS = prev_runs
                    return 0
                expected_stat = v_eff.stat_id

    try:
        pin_ctx: Any = (
            bind_pinned_runs_dir(RUNS, create=False, expected_stat=expected_stat, label="--runs-dir")
            if (not in_custody and (raw_runs_dir is not None or RUNS.is_dir()))
            else contextlib.nullcontext()
        )
        with pin_ctx:
            return _main_stop_inner(pos_args, force_legacy=force_legacy, discard_legacy=discard_legacy)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    finally:
        RUNS = prev_runs
        if inproc_runs_applied:
            set_cli_runs_dir_override(
                prev_boot.cli_runs_dir if prev_boot is not None else None,
                runs_stat=prev_boot.cli_runs_stat if prev_boot is not None else None,
            )


def _main_stop_inner(
    pos_args: list[str],
    *,
    force_legacy: bool,
    discard_legacy: bool,
) -> int:
    target = pos_args[0] if pos_args else None
    default_pid = legacy_pid_file(RUNS)
    stopped_pids: set[int] = set()

    with _pid_lock(RUNS):
        if target == "--all":
            records = list_pid_records(RUNS)
            if not records:
                print("No active server PID file found.")
                return 0
            all_ok = True
            for path, record in records:
                if _stop_record(
                    record,
                    stopped_pids,
                    force_legacy=force_legacy,
                    discard_legacy=discard_legacy,
                ):
                    runs_store_unlink(RUNS, path.name)
                else:
                    all_ok = False
            return 0 if all_ok else 1

        if target is not None:
            matched = False
            all_ok = True
            candidates = [
                pid_file_for_model(target, RUNS),
                _legacy_unhashed_pid_file(target, RUNS),
                default_pid,
            ]
            seen_names: set[str] = set()
            for path in candidates:
                if path.name in seen_names:
                    continue
                raw_txt = runs_store_read_text(RUNS, path.name)
                if raw_txt is None:
                    continue
                seen_names.add(path.name)
                try:
                    record = json.loads(raw_txt)
                except (OSError, json.JSONDecodeError):
                    continue
                if not isinstance(record, dict) or record.get("model_id") != target:
                    continue
                matched = True
                if _stop_record(
                    record,
                    stopped_pids,
                    force_legacy=force_legacy,
                    discard_legacy=discard_legacy,
                ):
                    runs_store_unlink(RUNS, path.name)
                else:
                    all_ok = False

            for path, record in list_pid_records(RUNS):
                if path.name in seen_names:
                    continue
                if record.get("model_id") == target:
                    matched = True
                    if _stop_record(
                        record,
                        stopped_pids,
                        force_legacy=force_legacy,
                        discard_legacy=discard_legacy,
                    ):
                        runs_store_unlink(RUNS, path.name)
                    else:
                        all_ok = False

            if not matched:
                print(f"No active server PID file found for {target}.")
                return 0
            return 0 if all_ok else 1

        raw_default = runs_store_read_text(RUNS, default_pid.name)
        if raw_default is not None:
            try:
                record = json.loads(raw_default)
            except (OSError, json.JSONDecodeError):
                record = None
            if isinstance(record, dict):
                if not _stop_record(
                    record,
                    stopped_pids,
                    force_legacy=force_legacy,
                    discard_legacy=discard_legacy,
                ):
                    return 1
                runs_store_unlink(RUNS, default_pid.name)
                model_id = record.get("model_id")
                if isinstance(model_id, str) and model_id:
                    for extra in (
                        pid_file_for_model(model_id, RUNS),
                        _legacy_unhashed_pid_file(model_id, RUNS),
                    ):
                        raw_extra = runs_store_read_text(RUNS, extra.name)
                        if raw_extra is not None:
                            try:
                                extra_rec = json.loads(raw_extra)
                                if isinstance(extra_rec, dict) and extra_rec.get("model_id") == model_id:
                                    runs_store_unlink(RUNS, extra.name)
                            except (OSError, json.JSONDecodeError):
                                pass
                return 0

        records = list_pid_records(RUNS)
        if not records:
            print("No active server PID file found.")
            return 0

        path, record = records[0]
        if _stop_record(
            record,
            stopped_pids,
            force_legacy=force_legacy,
            discard_legacy=discard_legacy,
        ):
            runs_store_unlink(RUNS, path.name)
            return 0
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
