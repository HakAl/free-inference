#!/usr/bin/env python3
import os
import sys

sys.dont_write_bytecode = True
os.environ['PYTHONDONTWRITEBYTECODE'] = '1'

from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VENV_PYTHON = ROOT / '.venv/bin/python'
_HAS_SITE_FLAG = any(
    tok == '--launcher-site-packages' or tok.startswith('--launcher-site-packages=')
    for tok in sys.argv[1:]
)
_IS_RO_EXPORT = not (ROOT / '.git').exists() and not os.access(ROOT, os.W_OK)
_WAS_VENV_REEXEC = os.environ.pop('_LOCAL_ASSIST_VENV_REEXEC', None) == '1'
if (
    __name__ == '__main__'
    and not sys.flags.isolated
    and not _HAS_SITE_FLAG
    and not _IS_RO_EXPORT
    and os.environ.get('LOCAL_ASSIST_WORKER_SANDBOX') != '1'
    and not _WAS_VENV_REEXEC
    and VENV_PYTHON.exists()
    and os.access(VENV_PYTHON, os.X_OK)
    and (ROOT / '.venv/pyvenv.cfg').is_file()
    and Path(sys.prefix).resolve() != (ROOT / '.venv').resolve()
):
    os.environ['_LOCAL_ASSIST_VENV_REEXEC'] = '1'
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), '-B', __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT))
if __name__ == '__main__':
    from local_assist.custody import bootstrap_entrypoint

    bootstrap_entrypoint(ROOT, sys.argv)

from local_assist.session import main

if __name__ == '__main__':
    raise SystemExit(main())
