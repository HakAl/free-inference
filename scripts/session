#!/usr/bin/env python3
from pathlib import Path
import os
import sys

ROOT = Path(__file__).resolve().parents[1]
VENV_PYTHON = ROOT / '.venv/bin/python'
if (__name__ == '__main__' and not sys.flags.isolated
        and os.environ.get('LOCAL_ASSIST_WORKER_SANDBOX') != '1'
        and os.environ.get('_LOCAL_ASSIST_VENV_REEXEC') != '1'
        and VENV_PYTHON.exists() and (ROOT / '.venv/pyvenv.cfg').is_file()
        and Path(sys.executable) != VENV_PYTHON):
    os.environ['_LOCAL_ASSIST_VENV_REEXEC'] = '1'
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])
sys.path.insert(0, str(ROOT))
from local_assist.session import main

if __name__ == '__main__':
    raise SystemExit(main())
