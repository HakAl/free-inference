#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

SUITE="${1:-v1}"
shift || true

if [ "$#" -gt 0 ]; then
  MODELS=("$@")
else
  MODELS=(
    "qwen3-30b-a3b-2507-mlx-4bit"
    "qwen3-coder-30b-a3b-mlx-4bit"
    "gemma-4-26b-a4b-it-optiq-mlx-4bit"
    "qwen3-1.7b-mlx-4bit"
  )
fi

STATUS=0

for model in "${MODELS[@]}"; do
  echo "==> Starting $model"
  scripts/stop-model "$model" || true
  scripts/serve-model "$model"

  echo "==> Waiting for $model server readiness"
  if ! scripts/verify-served-model "$model" --wait 60; then
    echo "Server did not become ready for $model" >&2
    scripts/stop-model "$model" || true
    exit 1
  fi

  echo "==> Running $SUITE for $model"
  if ! scripts/eval "$SUITE" "$model"; then
    echo "Suite $SUITE reported failures for $model" >&2
    STATUS=1
  fi
  scripts/stop-model "$model" || true
done

echo "Done."
exit "$STATUS"
