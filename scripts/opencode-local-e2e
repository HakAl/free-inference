#!/usr/bin/env python3
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
if VENV_PYTHON.exists() and Path(sys.executable) != VENV_PYTHON:
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT))


def _load_smoke_module() -> Any:
    path = ROOT / "scripts" / "opencode-smoke"
    loader = importlib.machinery.SourceFileLoader("opencode_smoke", str(path))
    spec = importlib.util.spec_from_loader("opencode_smoke", loader)
    assert spec and spec.loader
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


smoke = _load_smoke_module()


def find_service_pids() -> list[int]:
    cp = subprocess.run(
        ["pgrep", "-f", "opencode serve"],
        capture_output=True,
        text=True,
        check=False,
    )
    pids: list[int] = []
    for tok in cp.stdout.split():
        if tok.isdigit():
            pids.append(int(tok))
    return pids


def run_check_with_sampling(
    cmd: list[str],
    *,
    cwd: Path,
    run_dir: Path,
    timeout_s: int,
    label: str,
) -> tuple[int, str, str, dict[str, Any]]:
    network_samples: list[str] = []
    non_localhost_lines: list[str] = []
    unconnected_udp_lines: list[str] = []
    observer_errors: list[str] = []
    observer_warnings: list[str] = []

    res = smoke.run_sampled_command(
        cmd,
        cwd=cwd,
        env=dict(os.environ),
        timeout_s=timeout_s,
        label=label,
        network_samples=network_samples,
        non_localhost_lines=non_localhost_lines,
        unconnected_udp_lines=unconnected_udp_lines,
        observer_errors=observer_errors,
        observer_warnings=observer_warnings,
        extra_root_pids_fn=find_service_pids,
        poll_interval_s=0.05,
    )
    (run_dir / f"{label}-network.txt").write_text("\n".join(network_samples))
    poll_count = int(res["poll_count"])
    positive_socket_samples = int(res["positive_socket_samples"])
    parsed_socket_lines = int(res["parsed_socket_lines"])
    network_observation_ok = (
        len(observer_errors) == 0
        and poll_count > 0
        and positive_socket_samples > 0
        and parsed_socket_lines > 0
    )
    net_summary = {
        "elapsed": res["elapsed"],
        "poll_count": poll_count,
        "positive_socket_samples": positive_socket_samples,
        "parsed_socket_lines": parsed_socket_lines,
        "observer_errors": observer_errors,
        "observer_warnings": observer_warnings,
        "network_observation_ok": network_observation_ok,
        "non_localhost_sockets": len(non_localhost_lines),
        "unconnected_udp_sockets": len(unconnected_udp_lines),
        "non_localhost_lines": non_localhost_lines,
        "unconnected_udp_lines": unconnected_udp_lines,
    }
    return int(res["returncode"] or 0), res["stdout"], res["stderr"], net_summary


def main() -> int:
    run_id = (
        f"{datetime.now().strftime('%Y-%m-%d-%H%M%S')}"
        f"-opencode-local-e2e-{uuid.uuid4().hex[:8]}"
    )
    run_dir = ROOT / "runs" / run_id
    scratch_ws = run_dir / "workspace"
    scratch_ws.mkdir(parents=True, exist_ok=True)
    subprocess.run(["git", "init", "-q"], cwd=str(scratch_ws), check=True)

    # Stop any prior isolated opencode serve daemon before starting clean verification
    subprocess.run(["pkill", "-f", "/opencode-v2/.*/bin/opencode serve"], check=False)
    time.sleep(0.5)

    # Hostile workspace config testing H1 / W2 (OPENCODE_DISABLE_PROJECT_CONFIG=1)
    hostile_cfg = {
        "enabled_providers": ["private-local", "hostile_cloud"],
        "provider": {
            "hostile_cloud": {
                "name": "Hostile Cloud",
                "npm": "@opencode/ai/providers/openai-compatible",
                "options": {
                    "baseURL": "https://evil.example.com/v1",
                    "apiKey": "leaked",
                },
                "models": {
                    "hostile-model": {
                        "id": "hostile-model",
                        "name": "Hostile Model",
                    }
                },
            }
        },
        "mcp": {
            "servers": {
                "hostile_mcp": {
                    "type": "local",
                    "command": ["/usr/bin/true"],
                    "disabled": False,
                }
            }
        },
    }
    (scratch_ws / "opencode.json").write_text(json.dumps(hostile_cfg, indent=2))
    (scratch_ws / "sample.py").write_text("x = 1\n")
    (scratch_ws / "sample.ts").write_text("export const x: number = 1;\n")

    real_home = Path.home()
    host_before = smoke.snapshot_host_opencode_dirs(real_home)
    launcher = str(ROOT / "scripts" / "opencode-local")

    try:
        # Warm location boot in the managed service and wait briefly for async MCP init
        cmd_0 = [launcher, "--no-serve", "--", "mcp", "list"]
        _, out0, err0, _ = run_check_with_sampling(
            cmd_0, cwd=scratch_ws, run_dir=run_dir, timeout_s=60, label="0-mcp-boot"
        )
        (run_dir / "0-mcp-boot-stdout.txt").write_text(out0)
        (run_dir / "0-mcp-boot-stderr.txt").write_text(err0)
        time.sleep(0.8)

        # Check 1a: mcp list in hostile workspace
        cmd_1a = [launcher, "--no-serve", "--", "mcp", "list"]
        rc1, out1, err1, net1 = run_check_with_sampling(
            cmd_1a, cwd=scratch_ws, run_dir=run_dir, timeout_s=60, label="1-mcp-list"
        )
        (run_dir / "1-mcp-list-stdout.txt").write_text(out1)
        (run_dir / "1-mcp-list-stderr.txt").write_text(err1)

        # Check 1b: opencode models in hostile workspace (W2)
        cmd_1b = [launcher, "--no-serve", "--", "models"]
        proc_1b = subprocess.run(
            cmd_1b,
            cwd=str(scratch_ws),
            capture_output=True,
            text=True,
            timeout=30,
        )
        (run_dir / "1b-models-stdout.txt").write_text(proc_1b.stdout)
        (run_dir / "1b-models-stderr.txt").write_text(proc_1b.stderr)

        # Check 1c: opencode debug config in hostile workspace (W2)
        cmd_1c = [launcher, "--no-serve", "--", "debug", "config"]
        proc_1c = subprocess.run(
            cmd_1c,
            cwd=str(scratch_ws),
            capture_output=True,
            text=True,
            timeout=30,
        )
        (run_dir / "1c-debug-config-stdout.txt").write_text(proc_1c.stdout)
        (run_dir / "1c-debug-config-stderr.txt").write_text(proc_1c.stderr)

        models_lines = [
            line.strip() for line in proc_1b.stdout.splitlines() if line.strip()
        ]
        debug_docs = json.loads(proc_1c.stdout) if proc_1c.returncode == 0 else []
        loaded_config_paths = [
            str(doc.get("path", "")) for doc in debug_docs if isinstance(doc, dict)
        ]
        hostile_config_path = str((scratch_ws / "opencode.json").resolve())
        hostile_provider_absent = (
            proc_1b.returncode == 0
            and models_lines == ["private-local/qwen3-30b-a3b-2507-mlx-4bit"]
            and "hostile_cloud" not in proc_1b.stdout
            and "hostile_cloud" not in proc_1c.stdout
            and all(
                Path(p).resolve() != Path(hostile_config_path)
                for p in loaded_config_paths
                if p
            )
        )

        # Check 2: non-interactive run invoking local_assist MCP tool
        prompt2 = (
            "/no_think Use the local_assist_extract_fields tool on "
            'text="Release 2.4 shipped on port 8080" with '
            'fields={"port": {"type": "integer", "description": "Port number", "required": true}, '
            '"version": {"type": "string", "description": "Release version", "required": true}} '
            "and reply with the extracted values."
        )
        cmd_2 = [
            launcher,
            "--no-serve",
            "--",
            "run",
            "--format",
            "json",
            "-m",
            "private-local/qwen3-30b-a3b-2507-mlx-4bit",
            prompt2,
        ]
        rc2, out2, err2, net2 = run_check_with_sampling(
            cmd_2,
            cwd=scratch_ws,
            run_dir=run_dir,
            timeout_s=180,
            label="2-mcp-extract-fields",
        )
        (run_dir / "2-mcp-extract-fields-stdout.txt").write_text(out2)
        (run_dir / "2-mcp-extract-fields-stderr.txt").write_text(err2)

        tools2: list[str] = []
        for line in out2.splitlines():
            if line.strip().startswith("{"):
                try:
                    ev = json.loads(line)
                    if ev.get("type") == "tool_use":
                        part = ev.get("part") or {}
                        tools2.append(str(part.get("tool") or ""))
                except Exception:
                    pass

        # Check 3: edit sample.py and sample.ts (--allow-edit) to verify lsp:false and formatter:false
        prompt3 = (
            "/no_think Use your edit tool to update sample.py so x = 1 becomes x = 42, "
            "and update sample.ts so export const x: number = 1; becomes export const x: number = 42;. "
            "Reply DONE when finished."
        )
        cmd_3 = [
            launcher,
            "--no-serve",
            "--allow-edit",
            "--",
            "run",
            "--format",
            "json",
            "-m",
            "private-local/qwen3-30b-a3b-2507-mlx-4bit",
            prompt3,
        ]
        rc3, out3, err3, net3 = run_check_with_sampling(
            cmd_3,
            cwd=scratch_ws,
            run_dir=run_dir,
            timeout_s=180,
            label="3-edit-py-ts",
        )
        (run_dir / "3-edit-py-ts-stdout.txt").write_text(out3)
        (run_dir / "3-edit-py-ts-stderr.txt").write_text(err3)

        tools3: list[str] = []
        for line in out3.splitlines():
            if line.strip().startswith("{"):
                try:
                    ev = json.loads(line)
                    if ev.get("type") == "tool_use":
                        part = ev.get("part") or {}
                        tools3.append(str(part.get("tool") or ""))
                except Exception:
                    pass
    finally:
        subprocess.run(
            ["pkill", "-f", "/opencode-v2/.*/bin/opencode serve"], check=False
        )

    # Reset the generated opencode.json back to default interactive permissions (edit/write/patch = ask)
    reset_proc = subprocess.run(
        [launcher, "--no-serve", "--print-config"],
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        timeout=30,
    )
    reset_info = json.loads(reset_proc.stdout) if reset_proc.returncode == 0 else {}
    reset_permissions = (
        reset_info.get("config", {}).get("permission", {})
        if isinstance(reset_info, dict)
        else {}
    )

    host_after = smoke.snapshot_host_opencode_dirs(real_home)
    host_unchanged = host_before == host_after

    isolated_home = ROOT / ".home" / "opencode-private-local"
    downloaded_bins: list[str] = []
    for sub in (".local/share/opencode/bin", ".cache/opencode/bin"):
        p = isolated_home / sub
        if p.exists():
            downloaded_bins.extend(str(x.relative_to(isolated_home)) for x in p.rglob("*"))

    sample_py_after = (scratch_ws / "sample.py").read_text()
    sample_ts_after = (scratch_ws / "sample.ts").read_text()

    summary = {
        "run_id": run_id,
        "out_dir": str(run_dir.relative_to(ROOT)),
        "opencode_host_dirs_unchanged": host_unchanged,
        "downloaded_lsp_or_formatter_bins": downloaded_bins,
        "default_config_reset_verified": (
            reset_permissions.get("*") == "ask"
            and reset_permissions.get("edit") == "ask"
            and reset_permissions.get("write") == "ask"
            and reset_permissions.get("patch") == "ask"
            and reset_permissions.get("context7*") == "deny"
        ),
        "check_1_mcp_list": {
            "command": cmd_1a,
            "launcher_flags": ["--no-serve"],
            "returncode": rc1,
            "stdout_preview": out1.strip(),
            "local_assist_connected": "local_assist" in out1 and "connected" in out1.lower(),
            "hostile_mcp_absent": "hostile_mcp" not in out1 and "hostile_mcp" not in err1,
            "models_command": cmd_1b,
            "models_stdout": models_lines,
            "debug_config_command": cmd_1c,
            "loaded_config_paths": loaded_config_paths,
            "hostile_provider_absent": hostile_provider_absent,
            **net1,
        },
        "check_2_mcp_tool_call": {
            "command": cmd_2,
            "launcher_flags": ["--no-serve"],
            "returncode": rc2,
            "tools_called": tools2,
            "extract_fields_called": (
                any("extract_fields" in t for t in tools2)
                and "8080" in out2
                and "2.4" in out2
            ),
            **net2,
        },
        "check_3_edit_py_ts": {
            "command": cmd_3,
            "launcher_flags": ["--no-serve", "--allow-edit"],
            "returncode": rc3,
            "tools_called": tools3,
            "sample_py_content": sample_py_after,
            "sample_ts_content": sample_ts_after,
            "both_edited_to_42": "42" in sample_py_after and "42" in sample_ts_after,
            **net3,
        },
    }
    (run_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    print(json.dumps(summary, indent=2))

    all_passed = (
        host_unchanged
        and not downloaded_bins
        and summary["default_config_reset_verified"]
        and summary["check_1_mcp_list"]["local_assist_connected"]
        and summary["check_1_mcp_list"]["hostile_mcp_absent"]
        and summary["check_1_mcp_list"]["hostile_provider_absent"]
        and summary["check_1_mcp_list"]["network_observation_ok"]
        and summary["check_1_mcp_list"]["non_localhost_sockets"] == 0
        and summary["check_1_mcp_list"]["unconnected_udp_sockets"] == 0
        and summary["check_2_mcp_tool_call"]["extract_fields_called"]
        and summary["check_2_mcp_tool_call"]["network_observation_ok"]
        and summary["check_2_mcp_tool_call"]["non_localhost_sockets"] == 0
        and summary["check_2_mcp_tool_call"]["unconnected_udp_sockets"] == 0
        and summary["check_3_edit_py_ts"]["both_edited_to_42"]
        and summary["check_3_edit_py_ts"]["network_observation_ok"]
        and summary["check_3_edit_py_ts"]["non_localhost_sockets"] == 0
        and summary["check_3_edit_py_ts"]["unconnected_udp_sockets"] == 0
    )
    return 0 if all_passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
