#!/usr/bin/env python3
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path
from types import ModuleType
from typing import Any
from unittest.mock import patch
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
RUNS = ROOT / "runs"
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
if __name__ == "__main__" and VENV_PYTHON.exists() and Path(sys.executable) != VENV_PYTHON:
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT))

from local_assist.registry import pid_file_for_model, session_token_file_for_model
from local_assist.se_key import verify_se_key_proxy_binary


SELFTEST_SERVICE = "free-inference.selftest"
SYNTHETIC_REAL_KEY = "sk-selftest-synthetic-key-7741"
MODEL_ID = "se-key-smoke-mock"
SERVED_REPO = "mock/se-key-smoke-model"


def _load_script_module(name: str, rel_path: str) -> ModuleType:
    script_path = ROOT / rel_path
    loader = importlib.machinery.SourceFileLoader(name, str(script_path))
    spec = importlib.util.spec_from_loader(name, loader)
    assert spec is not None and spec.loader is not None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _free_port_pair() -> int:
    for candidate in range(18080, 18900, 2):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s1, socket.socket(
            socket.AF_INET, socket.SOCK_STREAM
        ) as s2:
            if (
                s1.connect_ex(("127.0.0.1", candidate)) != 0
                and s2.connect_ex(("127.0.0.1", candidate + 1000)) != 0
            ):
                return candidate
    raise RuntimeError("Could not find free port pair for se-key-smoke")


def _confirm_prompt(question: str) -> bool:
    try:
        with open("/dev/tty", "r", encoding="utf-8") as tty_in, open(
            "/dev/tty", "w", encoding="utf-8"
        ) as tty_out:
            tty_out.write(question)
            tty_out.flush()
            ans = tty_in.readline().strip().lower()
            return ans in ("y", "yes")
    except OSError:
        ans = input(question).strip().lower()
        return ans in ("y", "yes")


def _run_mock_upstream(host: str, port: int, log_file: Path) -> int:
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format: str, *args: Any) -> None:
            return

        def _record(self, method: str) -> None:
            auth = self.headers.get("Authorization") or ""
            entry = {
                "method": method,
                "path": self.path,
                "auth_matched_real_key": auth == f"Bearer {SYNTHETIC_REAL_KEY}",
                "accept_encoding": self.headers.get("Accept-Encoding"),
            }
            with log_file.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps(entry, sort_keys=True) + "\n")

        def do_GET(self) -> None:
            self._record("GET")
            body = json.dumps({"object": "list", "data": [{"id": SERVED_REPO}]}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self) -> None:
            cl = int(self.headers.get("Content-Length") or "0")
            if cl > 0:
                _ = self.rfile.read(cl)
            self._record("POST")
            body = json.dumps(
                {
                    "id": "chatcmpl-smoke",
                    "object": "chat.completion",
                    "model": SERVED_REPO,
                    "choices": [
                        {
                            "index": 0,
                            "message": {"role": "assistant", "content": "OK"},
                            "finish_reason": "stop",
                        }
                    ],
                    "usage": {"prompt_tokens": 5, "completion_tokens": 1, "total_tokens": 6},
                }
            ).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    srv = http.server.HTTPServer((host, port), Handler)
    srv.serve_forever()
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Operator-attended live Keychain + Touch ID verification via serve-model and stop-model."
    )
    parser.add_argument(
        "--operator-approved",
        action="store_true",
        default=False,
        help="Confirm explicit operator approval to write/delete temporary Keychain entry free-inference.selftest and prompt Touch ID.",
    )
    parser.add_argument(
        "--cancel-only",
        action="store_true",
        default=False,
        help="Run only Step 3 (Cancel Touch ID prompt) to verify fail-closed rollback without repeating Steps 1 and 2.",
    )
    parser.add_argument("--host", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--port", type=int, default=None, help=argparse.SUPPRESS)
    parser.add_argument("--mock-upstream-log", default=None, help=argparse.SUPPRESS)
    args = parser.parse_args(argv[1:])

    if args.host and args.port and args.mock_upstream_log:
        return _run_mock_upstream(
            args.host,
            args.port,
            Path(args.mock_upstream_log),
        )

    if not args.operator_approved:
        print(
            "Refusing to run se-key-smoke without --operator-approved (touches login Keychain and prompts Touch ID).",
            file=sys.stderr,
        )
        return 2

    se_bin = verify_se_key_proxy_binary()
    serve_mod = _load_script_module("serve_model_se_smoke", "scripts/serve-model")
    stop_mod = _load_script_module("stop_model_se_smoke", "scripts/stop-model")

    stamp = time.strftime("%Y-%m-%d-%H%M%S")
    out_dir = RUNS / f"{stamp}-se-key-smoke"
    out_dir.mkdir(parents=True, exist_ok=True)
    serve_mod.RUNS = out_dir
    stop_mod.RUNS = out_dir

    listen_port = _free_port_pair()
    upstream_port = listen_port + 1000
    upstream_log = out_dir / "upstream_requests.jsonl"

    model_entry: dict[str, Any] = {
        "id": MODEL_ID,
        "repo": SERVED_REPO,
        "runtime": "proxy",
        "serve_command": (
            f"{sys.executable} {Path(__file__).resolve()} "
            f"--host {{host}} --port {{port}} "
            f"--mock-upstream-log {upstream_log}"
        ),
        "promptfoo_provider": {
            "apiBaseUrl": f"http://127.0.0.1:{listen_port}/v1",
            "apiKeyKeychainService": SELFTEST_SERVICE,
        },
        "remote_trust": {
            "tier": "enclave_runtime_attested",
            "attestation_method": "tinfoil-proxy-sigstore",
        },
    }

    summary: dict[str, Any] = {
        "created_at": stamp,
        "service": SELFTEST_SERVICE,
        "model_id": MODEL_ID,
        "listen_port": listen_port,
        "upstream_port": upstream_port,
    }

    tok_file = session_token_file_for_model(MODEL_ID, out_dir)
    pid_file = pid_file_for_model(MODEL_ID, out_dir)
    default_pid_file = out_dir / ".serve.pid"

    try:
        # 1. Seal synthetic key into free-inference.selftest via --secret-fd
        r_fd, w_fd = os.pipe()
        os.write(w_fd, (SYNTHETIC_REAL_KEY + "\n").encode("utf-8"))
        os.close(w_fd)
        seal_cp = subprocess.run(
            [str(se_bin), "seal", "--service", SELFTEST_SERVICE, "--secret-fd", str(r_fd)],
            pass_fds=(r_fd,),
            capture_output=True,
            text=True,
            check=False,
        )
        os.close(r_fd)
        if seal_cp.returncode != 0:
            raise RuntimeError(f"seal failed: {seal_cp.stderr}")
        summary["seal_metadata"] = json.loads(seal_cp.stdout)

        status_cp = subprocess.run(
            [str(se_bin), "status", "--service", SELFTEST_SERVICE],
            capture_output=True,
            text=True,
            check=True,
        )
        summary["status_before"] = json.loads(status_cp.stdout)

        if not args.cancel_only:
            # 2. Prompt #1: Unlock via serve-model (Touch ID tap 1)
            print(
                "\n[Step 1/3] Launching serve-model. Please APPROVE Touch ID prompt #1 to unlock free-inference.selftest...",
                file=sys.stderr,
            )
            with patch.object(serve_mod, "load_model", return_value=model_entry):
                rc1 = serve_mod.main(
                    [
                        "scripts/serve-model",
                        MODEL_ID,
                        "--max-chat-requests",
                        "5",
                        "--ttl-seconds",
                        "60",
                    ]
                )
            summary["unlock_1_serve_rc"] = rc1
            summary["operator_confirmed_touch_id_prompt_1"] = _confirm_prompt(
                "Did a macOS Touch ID prompt appear for unlock #1? [y/N]: "
            )

            if rc1 == 0 and tok_file.exists():
                session_tok_1 = tok_file.read_text(encoding="utf-8").strip()
                req = Request(
                    f"http://127.0.0.1:{listen_port}/v1/models",
                    headers={"Authorization": f"Bearer {session_tok_1}"},
                    method="GET",
                )
                with urlopen(req, timeout=5) as resp:
                    models_resp = json.loads(resp.read().decode("utf-8"))
                summary["unlock_1_models_ok"] = models_resp["data"][0]["id"] == SERVED_REPO
            else:
                summary["unlock_1_models_ok"] = False

            stop_rc1 = stop_mod.main(["scripts/stop-model", MODEL_ID])
            summary["unlock_1_stop_rc"] = stop_rc1
            summary["unlock_1_token_file_cleaned"] = (
                not tok_file.exists() and not pid_file.exists() and not default_pid_file.exists()
            )

            # 3. Prompt #2: Back-to-back unlock via serve-model (Touch ID tap 2 - proving reuseDuration = 0)
            print(
                "\n[Step 2/3] Launching serve-model again. Please APPROVE Touch ID prompt #2 (confirming fresh gesture required)...",
                file=sys.stderr,
            )
            with patch.object(serve_mod, "load_model", return_value=model_entry):
                rc2 = serve_mod.main(
                    [
                        "scripts/serve-model",
                        MODEL_ID,
                        "--max-chat-requests",
                        "5",
                        "--ttl-seconds",
                        "60",
                    ]
                )
            summary["unlock_2_serve_rc"] = rc2
            summary["operator_confirmed_touch_id_prompt_2"] = _confirm_prompt(
                "Did a second fresh macOS Touch ID prompt appear for unlock #2? [y/N]: "
            )
            stop_rc2 = stop_mod.main(["scripts/stop-model", MODEL_ID])
            summary["unlock_2_stop_rc"] = stop_rc2
            summary["unlock_2_token_file_cleaned"] = (
                not tok_file.exists() and not pid_file.exists() and not default_pid_file.exists()
            )

        # 4. Prompt #3: Cancel Touch ID during serve-model (proving fail-closed and inner upstream rollback)
        cancel_model_entry = dict(model_entry)
        cancel_model_entry["repo"] = "CLICK-CANCEL-DO-NOT-TOUCH-ID"
        print(
            "\n[Step 3/3] Launching serve-model. On the macOS popup (model=CLICK-CANCEL-DO-NOT-TOUCH-ID), click CANCEL (do NOT touch sensor)...",
            file=sys.stderr,
        )
        with patch.object(serve_mod, "load_model", return_value=cancel_model_entry):
            rc3 = serve_mod.main(
                [
                    "scripts/serve-model",
                    MODEL_ID,
                    "--max-chat-requests",
                    "5",
                    "--ttl-seconds",
                    "60",
                ]
            )
        summary["cancel_3_serve_rc"] = rc3
        summary["operator_confirmed_cancel_prompt_3"] = _confirm_prompt(
            "Did the macOS Touch ID prompt appear and did you click Cancel? [y/N]: "
        )
        summary["cancel_3_rollback_clean"] = (
            rc3 != 0
            and not tok_file.exists()
            and not pid_file.exists()
            and not default_pid_file.exists()
            and not serve_mod._port_is_bound("127.0.0.1", listen_port)
            and not serve_mod._port_is_bound("127.0.0.1", upstream_port)
        )

        if not args.cancel_only:
            observed: list[dict[str, Any]] = []
            if upstream_log.exists():
                for line in upstream_log.read_text(encoding="utf-8").splitlines():
                    if line.strip():
                        observed.append(json.loads(line))
            summary["upstream_requests_count"] = len(observed)
            summary["upstream_received_real_bearer"] = bool(
                observed
                and all(item.get("auth_matched_real_key") is True for item in observed)
                and all(item.get("accept_encoding") == "identity" for item in observed)
            )
    finally:
        try:
            stop_mod.main(["scripts/stop-model", MODEL_ID])
        except Exception:
            pass
        del_cp = subprocess.run(
            [str(se_bin), "delete", "--service", SELFTEST_SERVICE],
            capture_output=True,
            text=True,
            check=False,
        )
        summary["keychain_entry_removed"] = (
            del_cp.returncode == 0 and json.loads(del_cp.stdout).get("deleted") is True
        )

    # Check zero leaks of se-session- or SYNTHETIC_REAL_KEY in out_dir
    leaks: list[str] = []
    for p in out_dir.rglob("*"):
        if p.is_file():
            txt = p.read_text(encoding="utf-8", errors="ignore")
            if "se-session-" in txt or SYNTHETIC_REAL_KEY in txt:
                leaks.append(str(p))
    summary["se_session_leaks_in_runs"] = leaks
    summary["cancel_only"] = bool(args.cancel_only)
    if args.cancel_only:
        summary["all_passed"] = bool(
            summary.get("operator_confirmed_cancel_prompt_3") is True
            and summary.get("cancel_3_rollback_clean") is True
            and summary.get("keychain_entry_removed") is True
            and not leaks
        )
    else:
        summary["all_passed"] = bool(
            summary.get("unlock_1_serve_rc") == 0
            and summary.get("operator_confirmed_touch_id_prompt_1") is True
            and summary.get("unlock_1_models_ok") is True
            and summary.get("unlock_1_token_file_cleaned") is True
            and summary.get("unlock_2_serve_rc") == 0
            and summary.get("operator_confirmed_touch_id_prompt_2") is True
            and summary.get("unlock_2_token_file_cleaned") is True
            and summary.get("operator_confirmed_cancel_prompt_3") is True
            and summary.get("cancel_3_rollback_clean") is True
            and summary.get("upstream_received_real_bearer") is True
            and summary.get("keychain_entry_removed") is True
            and not leaks
        )

    summary_path = out_dir / "summary.json"
    summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")
    print(json.dumps(summary, indent=2, sort_keys=True))
    return 0 if summary["all_passed"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
