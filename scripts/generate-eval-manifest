VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
if __name__ == "__main__" and VENV_PYTHON.exists() and Path(sys.executable) != VENV_PYTHON:
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT))

from local_assist.registry import (
    EndpointConfig,
    RegistryError,
    _load_yaml,
    load_model,
    load_models,
    resolve_endpoint,
)

RUNS_DIR = ROOT / "runs"
EVALS_DOCS_DIR = ROOT / "docs" / "evals"
PRIVATE_PATH_RE = re.compile(r"(/Users/[^\s\"']+|/home/[^\s\"']+)")

SUITE_REL_PATHS: dict[str, str] = {
    "sanity": "promptfooconfig.yaml",
    "v1": "evals/suites/v1.yaml",
    "tools": "evals/suites/tools.yaml",
}

