    parse_session_token_raw,
)

DEFAULT_HOME = ROOT / ".home" / "opencode-private-attested"
DEFAULT_EVIDENCE_PATH = ROOT / ".home" / "dogfood" / "credential-exposure" / "evidence.json"
DEFAULT_INCIDENT_ID = "SESSION-CREDENTIAL-001"

GENERIC_TOKEN_RE = re.compile(r"\b(?:se-session|oc-relay|worker-relay)-[A-Za-z0-9_-]{12,}")
SE_SESSION_TOKEN_RE = re.compile(r"\bse-session-[A-Za-z0-9_-]{12,}")
GENERIC_B64_PREFIXES = (
    "c2Utc2Vzc2lvbi0",
    "b2MtcmVsYXkt",
    "d29ya2VyLXJlbGF5LQ",
)
HEX40_RE = re.compile(r"^[0-9a-fA-F]{40}$")
HEX64_RE = re.compile(r"^[0-9a-fA-F]{64}$")
ATTESTED_TIERS = frozenset({"enclave_weights_attested", "enclave_runtime_attested"})
REQUIRED_PROTECTED_SOURCES: tuple[str, ...] = (
    "SECURITY.md",
    "tools/se_key_proxy/main.swift",
)
SQLITE_MAGIC_HEADER = b"SQLite format 3\x00"


def _dual_realpath_variants(path: Path) -> list[str]:
    out: list[str] = []
    for raw in (str(path.expanduser().absolute()), str(path.expanduser().resolve())):
        norm = raw.rstrip("/") or "/"
        if norm not in out:
            out.append(norm)
        if norm.startswith("/private/var/"):
            alt = norm[len("/private") :]
            if alt not in out:
                out.append(alt)
        elif norm.startswith("/var/"):
            alt = f"/private{norm}"
            if alt not in out:
                out.append(alt)
        elif norm.startswith("/private/tmp/"):
            alt = norm[len("/private") :]
            if alt not in out:
                out.append(alt)
        elif norm.startswith("/tmp/"):
            alt = f"/private{norm}"
            if alt not in out:
                out.append(alt)
    return out


def _normalize_repo_source_path(raw_key: str) -> str | None:
    if not isinstance(raw_key, str):
        return None
    if raw_key != raw_key.strip() or not raw_key:
        return None
    if "\\" in raw_key or raw_key.startswith("/") or raw_key.endswith("/"):
        return None
    rel = raw_key[len("lab/") :] if raw_key.startswith("lab/") else raw_key
    if not rel or rel.startswith("/"):
        return None
    parts = rel.split("/")
    if any(p in ("", ".", "..") for p in parts):
        return None
    return "/".join(parts)


def _verify_git_blob_sha256(
    commit_hex: str, norm_rel: str, expected_sha256: str
) -> tuple[bool, bool] | None:
    """Verify tracked blob existence and SHA-256 in commit_hex.

    Returns (exists_as_blob, sha256_matches) or None when git execution fails.
    """
    if not norm_rel or ".." in Path(norm_rel).parts:
        return (False, False)
    try:
        proc = subprocess.run(
            ["git", "-C", str(ROOT), "cat-file", "blob", f"{commit_hex}:{norm_rel}"],
            capture_output=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return (False, False)
    actual = hashlib.sha256(proc.stdout).hexdigest().lower()
    return (True, actual == expected_sha256.lower())


def _verify_events_in_sqlite_db(
    db_path: Path, session_id: str, events: list[dict[str, Any]]
) -> bool:
    if db_path.is_symlink() or not db_path.is_file():
        return False
    try:
        st = db_path.stat()
        if st.st_size < len(SQLITE_MAGIC_HEADER):
            return False
        with db_path.open("rb") as fh:
            if fh.read(len(SQLITE_MAGIC_HEADER)) != SQLITE_MAGIC_HEADER:
                return False
    except OSError:
        return False
    uri = f"file:{quote(str(db_path.resolve()))}?mode=ro"
    conn: sqlite3.Connection | None = None
    try:
        try:
            conn = sqlite3.connect(uri, uri=True, timeout=2.0)
        except sqlite3.OperationalError:
            conn = sqlite3.connect(f"{uri}&immutable=1", uri=True, timeout=2.0)
        cur = conn.cursor()
        tables = {
            str(r[0])
            for r in cur.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            ).fetchall()
            if isinstance(r[0], str)
        }
        if "session_message" not in tables:
            return False
        for ev in events:
            msg_id = ev.get("message_id")
            seq = ev.get("session_sequence")
            snap_rowid = ev.get("snapshot_rowid")
            if snap_rowid is not None:
                row = cur.execute(
                    "SELECT 1 FROM session_message WHERE rowid = ? AND id = ? AND session_id = ? AND seq = ?",
                    (int(snap_rowid), str(msg_id), session_id, int(seq)),
                ).fetchone()
            else:
                row = cur.execute(
                    "SELECT 1 FROM session_message WHERE id = ? AND session_id = ? AND seq = ?",
                    (str(msg_id), session_id, int(seq)),
                ).fetchone()
            if row is None:
                return False
        return True
    except (OSError, sqlite3.Error, ValueError, TypeError):
        return False
    finally:
        if conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass


def _compute_events_metadata_digest(events: list[dict[str, Any]]) -> str:
    canonical = [
        {
            "event_label": str(ev.get("event_label") or ""),
            "message_id": str(ev.get("message_id") or ""),
            "session_sequence": int(ev["session_sequence"]),
            "snapshot_rowid": (
                int(ev["snapshot_rowid"]) if ev.get("snapshot_rowid") is not None else None
            ),
            "tool_name": str(ev.get("tool_name") or ""),
        }
        for ev in events
    ]
    raw = json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(raw).hexdigest().lower()


def _containment_receipt_path(evidence_path: Path, incident_id: str) -> Path:
    clean_id = incident_id.strip()
    slug = re.sub(r"[^A-Za-z0-9_.-]+", "_", clean_id).strip("._-")[:48] or "incident"
    id_hash12 = hashlib.sha256(clean_id.encode("utf-8")).hexdigest()[:12]
    ev_parent = evidence_path.expanduser().resolve().parent
    return ev_parent / f".containment-state-{slug}-{id_hash12}.json"


def _read_verified_containment_receipt(
    *,
    evidence_path: Path,
    evidence_sha256: str,
    home_resolved: Path,
    expected_incident_id: str,
    session_id: str | None = None,
    events: list[dict[str, Any]] | None = None,
) -> dict[str, Any] | None:
    try:
        receipt_path = _containment_receipt_path(evidence_path, expected_incident_id)
        if receipt_path.is_symlink() or not receipt_path.is_file():
            return None
        rec_resolved = receipt_path.resolve()
        if rec_resolved == home_resolved or rec_resolved.is_relative_to(home_resolved):
            return None
        rec = json.loads(receipt_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(rec, dict):
        return None
    if rec.get("schema_version") != 1:
        return None
    if not isinstance(rec.get("db_events_verified_pre_cleanup"), bool):
        return None
    if rec.get("state") not in ("in_progress", "completed"):
        return None
    if str(rec.get("incident_id") or "") != expected_incident_id.strip():
        return None
    if str(rec.get("evidence_sha256") or "").lower() != evidence_sha256.lower():
        return None
    if session_id is not None and events is not None:
        if str(rec.get("session_id") or "") != session_id:
            return None
        if rec.get("verified_event_count") != len(events) or isinstance(
            rec.get("verified_event_count"), bool
        ):
            return None
        if str(rec.get("events_digest") or "").lower() != _compute_events_metadata_digest(events):
            return None
    else:
        if rec.get("session_id") is not None:
            return None
    raw_models = rec.get("revoked_target_models", [])
    if not isinstance(raw_models, list) or not all(
        isinstance(m, str) and bool(m.strip()) for m in raw_models
    ):
        return None
    raw_home = rec.get("target_home")
    if not isinstance(raw_home, str) or not raw_home.strip():
        return None
    try:
        if Path(raw_home).expanduser().resolve() != home_resolved:
            return None
    except OSError:
        return None
    return rec


def _write_containment_receipt(
    *,
    evidence_path: Path,
    evidence_sha256: str,
    home_resolved: Path,
    incident_id: str,
    state: str,
    session_id: str | None = None,
    events: list[dict[str, Any]] | None = None,
    db_events_verified_pre_cleanup: bool = False,
    revoked_target_models: Sequence[str] = (),
) -> bool:
    if state not in ("in_progress", "completed"):
        return False
    try:
        receipt_path = _containment_receipt_path(evidence_path, incident_id)
        receipt_parent = receipt_path.parent.resolve()
        if receipt_parent == home_resolved or receipt_parent.is_relative_to(home_resolved):
            return False
        if receipt_path.is_symlink():
            return False
    except OSError:
        return False

    prior_rec = _read_verified_containment_receipt(
        evidence_path=evidence_path,
        evidence_sha256=evidence_sha256,
        home_resolved=home_resolved,
        expected_incident_id=incident_id,
        session_id=session_id,
        events=events,
    )
    prior_models = (
        [str(m).strip() for m in prior_rec.get("revoked_target_models", []) if str(m).strip()]
        if prior_rec is not None
        else []
    )
    merged_models = sorted(
        {
            *prior_models,
            *(str(m).strip() for m in revoked_target_models if isinstance(m, str) and m.strip()),
        }
    )
    merged_db_verified = bool(db_events_verified_pre_cleanup) or bool(
        prior_rec is not None and prior_rec.get("db_events_verified_pre_cleanup") is True
    )

    payload: dict[str, Any] = {
        "schema_version": 1,
        "incident_id": incident_id.strip(),
        "evidence_sha256": evidence_sha256.lower(),
        "target_home": str(home_resolved),
        "session_id": session_id if (session_id is not None and events is not None) else None,
        "verified_event_count": len(events) if (session_id is not None and events is not None) else 0,
        "events_digest": (
            _compute_events_metadata_digest(events)
            if (session_id is not None and events is not None)
            else None
        ),
        "db_events_verified_pre_cleanup": merged_db_verified,
        "revoked_target_models": merged_models,
        "state": state,
        "updated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    encoded = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    tmp_path = receipt_path.parent / f"{receipt_path.name}.tmp.{os.getpid()}.{time.time_ns()}"
    fd: int | None = None
    try:
        fd = os.open(str(tmp_path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.write(fd, encoded)
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.chmod(tmp_path, 0o400)
        os.replace(tmp_path, receipt_path)
        return True
    except OSError:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            if os.path.lexists(tmp_path):
                tmp_path.unlink()
        except OSError:
            pass
        return False


def _has_verified_containment_receipt(
    *,
    evidence_path: Path,
    evidence_sha256: str,
    home_resolved: Path,
    expected_incident_id: str,
    session_id: str,
    events: list[dict[str, Any]],
) -> bool:
    rec = _read_verified_containment_receipt(
        evidence_path=evidence_path,
        evidence_sha256=evidence_sha256,
        home_resolved=home_resolved,
        expected_incident_id=expected_incident_id,
        session_id=session_id,
        events=events,
    )
    return bool(rec is not None and rec.get("db_events_verified_pre_cleanup") is True)


def _validate_evidence_snapshot(
    evidence_path: Path,
    *,
    home_dir: Path,
    expected_incident_id: str = DEFAULT_INCIDENT_ID,
    require_db_event_binding: bool = True,
) -> tuple[bool, bool, dict[str, Any] | None, int, str]:
    """Validate operator-supplied incident evidence JSON outside agent-writable roots.

    Returns (schema_ok, integrity_ok, evidence_obj, dirty_unverified_sources, evidence_sha256).
    """
    try:
        if evidence_path.is_symlink() or not evidence_path.is_file():
            return False, False, None, 0, ""
        evidence_bytes = evidence_path.read_bytes()
        evidence_sha256 = hashlib.sha256(evidence_bytes).hexdigest().lower()
        obj = json.loads(evidence_bytes.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return False, False, None, 0, ""
    if not isinstance(obj, dict):
        return False, False, None, 0, ""

    if "credential_values_or_hashes_included" in obj:
        if obj.get("credential_values_or_hashes_included") is not False:
            return False, False, None, 0, ""

    if "worktree_dirty_before_diagnosis" in obj:
        if not isinstance(obj.get("worktree_dirty_before_diagnosis"), bool):
            return False, False, None, 0, ""

    if "source_artifacts" in obj:
        sa = obj.get("source_artifacts")
        if not isinstance(sa, dict) or not all(
            isinstance(k, str) and bool(k.strip()) and isinstance(v, str) and bool(v.strip())
            for k, v in sa.items()
        ):
            return False, False, None, 0, ""

    is_provenance_format = False
    is_bundle_format = False

    tracking_id = obj.get("tracking_id")
    session_id = obj.get("session_id")
    events = obj.get("events")
    src_sha = obj.get("source_sha256")
    if (
        isinstance(tracking_id, str)
        and bool(tracking_id.strip())
        and isinstance(session_id, str)
        and bool(session_id.strip())
        and isinstance(events, list)
        and len(events) > 0
        and isinstance(src_sha, dict)
        and len(src_sha) > 0
    ):
        events_ok = True
        for ev in events:
            if not isinstance(ev, dict):
                events_ok = False
                break
            mid = ev.get("message_id")
            seq = ev.get("session_sequence")
            tname = ev.get("tool_name")
            elabel = ev.get("event_label")
            srow = ev.get("snapshot_rowid")
            if (
                not isinstance(mid, str)
                or not mid.strip()
                or isinstance(seq, bool)
                or not isinstance(seq, int)
                or not isinstance(tname, str)
                or not tname.strip()
                or not isinstance(elabel, str)
                or not elabel.strip()
                or (srow is not None and (isinstance(srow, bool) or not isinstance(srow, int)))
            ):
                events_ok = False
                break
        digests_ok = all(
            isinstance(k, str)
            and bool(k.strip())
            and isinstance(v, str)
            and bool(HEX64_RE.match(v))
            for k, v in src_sha.items()
        )
        if not events_ok or not digests_ok:
            return False, False, None, 0, ""
        if "current_artifact_comparisons" in obj and not isinstance(
            obj.get("current_artifact_comparisons"), dict
        ):
            return False, False, None, 0, ""
        if "target_home" in obj and (
            not isinstance(obj.get("target_home"), str) or not str(obj["target_home"]).strip()
        ):
            return False, False, None, 0, ""
        if "artifacts" in obj:
            arts = obj.get("artifacts")
            if (
                not isinstance(arts, dict)
                or not arts
                or not all(
                    isinstance(k, str)
                    and bool(k.strip())
                    and isinstance(v, str)
                    and bool(HEX64_RE.match(v))
                    for k, v in arts.items()
                )
            ):
                return False, False, None, 0, ""
        is_provenance_format = True
    else:
        incident_id = obj.get("incident_id")
        target_home = obj.get("target_home")
        artifacts = obj.get("artifacts")
        if (
            isinstance(incident_id, str)
            and bool(incident_id.strip())
            and isinstance(target_home, str)
            and bool(target_home.strip())
            and isinstance(artifacts, dict)
            and len(artifacts) > 0
            and all(
                isinstance(k, str)
                and bool(k.strip())
                and isinstance(v, str)
                and bool(HEX64_RE.match(v))
                for k, v in artifacts.items()
            )
        ):
            is_bundle_format = True
        else:
            return False, False, None, 0, ""

    recorded_id = str(obj.get("tracking_id") or obj.get("incident_id") or "").strip()
    if recorded_id != expected_incident_id.strip():
        return True, False, obj, 0, evidence_sha256

    try:
        home_resolved = home_dir.expanduser().resolve()
        ev_resolved = evidence_path.expanduser().resolve()
    except OSError:
        return True, False, obj, 0, evidence_sha256

    if ev_resolved == home_resolved or ev_resolved.is_relative_to(home_resolved):
        return True, False, obj, 0, evidence_sha256

    if isinstance(obj.get("target_home"), str) and obj["target_home"].strip():
        try:
            target_resolved = Path(obj["target_home"]).expanduser().resolve()
        except OSError:
            return True, False, obj, 0, evidence_sha256
        if target_resolved != home_resolved:
            return True, False, obj, 0, evidence_sha256
    else:
        if (
            ev_resolved.name != "evidence.json"
            or ev_resolved.parent.name != "credential-exposure"
            or ev_resolved.parent.parent.name != "dogfood"
            or home_resolved.name != "opencode-private-attested"
            or ev_resolved.parent.parent.parent != home_resolved.parent
        ):
            return True, False, obj, 0, evidence_sha256

    verified_artifacts: dict[Path, str] = {}
    artifacts_map = obj.get("artifacts")
    if isinstance(artifacts_map, dict):
        for raw_art_path, expected_hex in artifacts_map.items():
            cand = Path(raw_art_path).expanduser()
            if not cand.is_absolute():
                cand = evidence_path.parent / cand
            try:
                if cand.is_symlink() or not cand.is_file():
                    return True, False, obj, 0, evidence_sha256
                st = cand.stat()
                if st.st_size <= 0:
                    return True, False, obj, 0, evidence_sha256
                cand_resolved = cand.resolve()
                if cand_resolved == home_resolved or cand_resolved.is_relative_to(home_resolved):
                    return True, False, obj, 0, evidence_sha256
                actual_hex = hashlib.sha256(cand.read_bytes()).hexdigest().lower()
            except OSError:
                return True, False, obj, 0, evidence_sha256
            if actual_hex != str(expected_hex).lower():
                return True, False, obj, 0, evidence_sha256
            verified_artifacts[cand_resolved] = actual_hex

    dirty_unverified_sources = 0
    if is_provenance_format:
        lab_head = obj.get("lab_head")
        dirty_before = obj.get("worktree_dirty_before_diagnosis", False)
        assert isinstance(dirty_before, bool)
        if not (isinstance(lab_head, str) and bool(HEX40_RE.match(lab_head))):
            return True, False, obj, 0, evidence_sha256

        assert isinstance(src_sha, dict)
        canonical_src_sha: dict[str, str] = {}
        for raw_src_key, exp_hex in src_sha.items():
            norm_rel = _normalize_repo_source_path(raw_src_key)
            if norm_rel is None or norm_rel in canonical_src_sha:
                return True, False, obj, 0, evidence_sha256
            canonical_src_sha[norm_rel] = str(exp_hex).lower()

        for req_src in REQUIRED_PROTECTED_SOURCES:
            if req_src not in canonical_src_sha:
                return True, False, obj, 0, evidence_sha256

        canonical_source_artifacts: dict[str, Path] = {}
        raw_sa = obj.get("source_artifacts")
        if isinstance(raw_sa, dict):
            for raw_k, raw_p in raw_sa.items():
                norm_k = _normalize_repo_source_path(raw_k)
                if norm_k is None or norm_k in canonical_source_artifacts:
                    return True, False, obj, 0, evidence_sha256
                cand_sa = Path(raw_p).expanduser()
                if not cand_sa.is_absolute():
                    cand_sa = evidence_path.parent / cand_sa
                try:
                    cand_sa_res = cand_sa.resolve()
                except OSError:
                    return True, False, obj, 0, evidence_sha256
                if cand_sa_res not in verified_artifacts:
                    return True, False, obj, 0, evidence_sha256
                canonical_source_artifacts[norm_k] = cand_sa_res

        verified_clean = 0
        for norm_rel, exp_hex in canonical_src_sha.items():
            blob_res = _verify_git_blob_sha256(lab_head, norm_rel, exp_hex)
            if blob_res is None:
                return True, False, obj, 0, evidence_sha256
            exists_in_commit, digest_matches = blob_res
            if not exists_in_commit:
                return True, False, obj, 0, evidence_sha256

            sa_path = canonical_source_artifacts.get(norm_rel)
            artifact_verified = bool(
                sa_path is not None and verified_artifacts.get(sa_path) == exp_hex
            )

            if norm_rel in REQUIRED_PROTECTED_SOURCES:
                if not (digest_matches or artifact_verified):
                    return True, False, obj, 0, evidence_sha256
                verified_clean += 1
            elif digest_matches or artifact_verified:
                verified_clean += 1
            elif not dirty_before:
                return True, False, obj, 0, evidence_sha256
            else:
                dirty_unverified_sources += 1

        if verified_clean == 0:
            return True, False, obj, 0, evidence_sha256

        if require_db_event_binding:
            assert isinstance(session_id, str) and isinstance(events, list)
            verified_in_external_db = any(
                _verify_events_in_sqlite_db(art_path, session_id, events)
                for art_path in verified_artifacts
            )
            verified_by_receipt = _has_verified_containment_receipt(
                evidence_path=evidence_path,
                evidence_sha256=evidence_sha256,
                home_resolved=home_resolved,
                expected_incident_id=expected_incident_id,
                session_id=session_id,
                events=events,
            )
            if not (verified_in_external_db or verified_by_receipt):
                db_path = home_dir / ".local" / "share" / "opencode" / "opencode.db"
                if not _verify_events_in_sqlite_db(db_path, session_id, events):
                    return True, False, obj, dirty_unverified_sources, evidence_sha256

    assert is_provenance_format or is_bundle_format
    return True, True, obj, dirty_unverified_sources, evidence_sha256


def _secret_variants_in_memory(secret: str) -> list[str]:
    cleaned = secret.strip()
    if len(cleaned) < 8:
        return []
    raw_bytes = cleaned.encode("utf-8")
    b64_std = base64.b64encode(raw_bytes).decode("ascii")
    b64_nopad = b64_std.rstrip("=")
    b64_url = base64.urlsafe_b64encode(raw_bytes).decode("ascii").rstrip("=")
    pct = quote(cleaned, safe="")
    basic_oc = base64.b64encode(f"opencode:{cleaned}".encode("utf-8")).decode("ascii").rstrip("=")
    basic_anon = base64.b64encode(f":{cleaned}".encode("utf-8")).decode("ascii").rstrip("=")
    out: list[str] = []
    for cand in (cleaned, pct, b64_std, b64_nopad, b64_url, basic_oc, basic_anon):
        if len(cand) >= 8 and cand not in out:
            out.append(cand)
    return out


def _lstat_strict(path: Path) -> tuple[os.stat_result | None, bool]:
    """Return (lstat_result_or_None, metadata_ok).

    Confirmed absence (ENOENT) returns (None, True).
    Any other OSError (EACCES, EPERM, ENOTDIR, EIO, etc.) returns (None, False).
    """
    try:
        return os.lstat(path), True
    except FileNotFoundError:
        return None, True
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            return None, True
        return None, False


def _scandir_matching_files(
    dir_path: Path, name_pred: Callable[[str], bool]
) -> tuple[list[Path], bool]:
    """Strictly enumerate matching entries in dir_path without swallowing PermissionError."""
    st, meta_ok = _lstat_strict(dir_path)
    if not meta_ok:
        return [], False
    if st is None:
        return [], True
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        return [], False

    matches: list[Path] = []
    try:
        with os.scandir(dir_path) as it:
            for entry in it:
                if name_pred(entry.name):
                    matches.append(dir_path / entry.name)
    except OSError:
        return sorted(matches), False
    return sorted(matches), True


def _walk_matching_files_strict(
    root_dir: Path, name_pred: Callable[[str], bool]
) -> tuple[list[Path], bool]:
    """Strictly walk root_dir recursively without swallowing directory listing errors."""
    st, meta_ok = _lstat_strict(root_dir)
    if not meta_ok:
        return [], False
    if st is None:
        return [], True
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        return [], False

    matches: list[Path] = []
    scan_ok = True
    stack: list[Path] = [root_dir]
    while stack:
        cur_dir = stack.pop()
        try:
            with os.scandir(cur_dir) as it:
                entries = sorted(it, key=lambda e: e.name)
        except OSError:
            scan_ok = False
            continue

        subdirs: list[Path] = []
        for entry in entries:
            entry_path = cur_dir / entry.name
            est, emeta_ok = _lstat_strict(entry_path)
            if not emeta_ok or est is None:
                scan_ok = False
                continue
            if stat.S_ISLNK(est.st_mode):
                scan_ok = False
                if name_pred(entry.name):
                    matches.append(entry_path)
                continue
            if stat.S_ISDIR(est.st_mode):
                subdirs.append(entry_path)
                if name_pred(entry.name):
                    matches.append(entry_path)
            elif name_pred(entry.name):
                matches.append(entry_path)

        for sd in reversed(subdirs):
            stack.append(sd)

    return sorted(matches), scan_ok


def _find_legacy_service_files(home_dir: Path) -> tuple[list[Path], bool]:
    found: list[Path] = []
    scan_ok = True
    home_st, home_meta_ok = _lstat_strict(home_dir)
    if not home_meta_ok:
        return [], False
    if home_st is None:
        return [], True
    if stat.S_ISLNK(home_st.st_mode) or not stat.S_ISDIR(home_st.st_mode):
        return [], False

    for sub in (
        home_dir / ".local" / "state" / "opencode",
        home_dir / ".local" / "share" / "opencode",
        home_dir / ".config" / "opencode",
    ):
        sub_matches, sub_ok = _scandir_matching_files(
            sub,
            lambda name: name != "service-identity.json"
            and (
                name == "service.json"
                or (name.startswith("service-") and name.endswith(".json"))
            ),
        )
        if not sub_ok:
            scan_ok = False
        for p in sub_matches:
            if p not in found:
                found.append(p)
    return found, scan_ok


def _collect_in_memory_needles(
    home_dir: Path, runs_dir: Path, service_files: list[Path]
) -> tuple[list[str], bool]:
    del home_dir
    needles: list[str] = []
    scan_ok = True
    tok_files, runs_tok_ok = _scandir_matching_files(
        runs_dir,
        lambda name: name.startswith(".se-session-") and name.endswith(".token"),
    )
    if not runs_tok_ok:
        scan_ok = False
    for tok_file in tok_files:
        tst, tmeta_ok = _lstat_strict(tok_file)
        if not tmeta_ok or tst is None or stat.S_ISLNK(tst.st_mode) or not stat.S_ISREG(tst.st_mode):
            scan_ok = False
            continue
        try:
            tok_val = parse_session_token_raw(tok_file.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            scan_ok = False
            continue
        if tok_val is None:
            scan_ok = False
            continue
        for v in _secret_variants_in_memory(tok_val):
            if v not in needles:
                needles.append(v)

    for svc_file in service_files:
        sst, smeta_ok = _lstat_strict(svc_file)
        if not smeta_ok or sst is None or stat.S_ISLNK(sst.st_mode) or not stat.S_ISREG(sst.st_mode):
            scan_ok = False
            continue
        try:
            svc_raw = svc_file.read_text(encoding="utf-8", errors="replace")
        except OSError:
            scan_ok = False
            continue
        try:
            svc_obj = json.loads(svc_raw)
        except json.JSONDecodeError:
            continue
        if isinstance(svc_obj, dict):
            pw = svc_obj.get("password")
            if isinstance(pw, str):
                for v in _secret_variants_in_memory(pw):
                    if v not in needles:
                        needles.append(v)
    return needles, scan_ok


def _text_matches_credential(
    text: str, needles: list[str], *, include_generic: bool = True
) -> bool:
    if not text:
        return False
    if include_generic:
        if GENERIC_TOKEN_RE.search(text):
            return True
        for pref in GENERIC_B64_PREFIXES:
            if pref in text:
                return True
    for needle in needles:
        if needle in text:
            return True
    return False


def _scan_db_matching_records(
    db_path: Path, needles: list[str], *, include_generic: bool = True
) -> tuple[int, bool]:
    db_st, db_meta_ok = _lstat_strict(db_path)
    if not db_meta_ok:
        return 0, False
    if db_st is None:
        return 0, True
    if stat.S_ISLNK(db_st.st_mode) or not stat.S_ISREG(db_st.st_mode):
        return 0, False
    try:
        if db_st.st_size > 0:
            if db_st.st_size < len(SQLITE_MAGIC_HEADER):
                return 0, False
            with db_path.open("rb") as fh:
                if fh.read(len(SQLITE_MAGIC_HEADER)) != SQLITE_MAGIC_HEADER:
                    return 0, False
    except OSError:
        return 0, False

    uri = f"file:{quote(str(db_path.resolve()))}?mode=ro"
    conn: sqlite3.Connection | None = None
    matched_rows = 0
    try:
        try:
            conn = sqlite3.connect(uri, uri=True, timeout=2.0)
        except sqlite3.OperationalError:
            conn = sqlite3.connect(f"{uri}&immutable=1", uri=True, timeout=2.0)
        cur = conn.cursor()
        tables = [
            str(r[0])
            for r in cur.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            ).fetchall()
            if isinstance(r[0], str)
        ]
        for tbl in tables:
            safe_tbl = '"' + tbl.replace('"', '""') + '"'
            rows_iter = cur.execute(f"SELECT * FROM {safe_tbl}")
            for row in rows_iter:
                row_hit = False
                for col in row:
                    if isinstance(col, str):
                        if _text_matches_credential(col, needles, include_generic=include_generic):
                            row_hit = True
                            break
                    elif isinstance(col, (bytes, bytearray, memoryview)):
                        decoded = bytes(col).decode("utf-8", errors="replace")
                        if _text_matches_credential(
                            decoded, needles, include_generic=include_generic
                        ):
                            row_hit = True
                            break
                if row_hit:
                    matched_rows += 1
        return matched_rows, True
    except (OSError, sqlite3.Error):
        return matched_rows, False
    finally:
        if conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass


def _scan_log_matching_lines(
    log_dir: Path, needles: list[str], *, include_generic: bool = True
) -> tuple[int, bool]:
    log_files, scan_ok = _scandir_matching_files(
        log_dir, lambda name: name.startswith("opencode.log")
    )
    matched_lines = 0
    for log_file in log_files:
        lst, lmeta_ok = _lstat_strict(log_file)
        if not lmeta_ok or lst is None or stat.S_ISLNK(lst.st_mode) or not stat.S_ISREG(lst.st_mode):
            scan_ok = False
            continue
        try:
            with log_file.open("r", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if _text_matches_credential(line, needles, include_generic=include_generic):
                        matched_lines += 1
        except OSError:
            scan_ok = False
    return matched_lines, scan_ok


def _scan_shell_spool_matching_lines(
    shell_dir: Path, needles: list[str], *, include_generic: bool = True
) -> tuple[int, bool]:
    spool_files, scan_ok = _walk_matching_files_strict(
        shell_dir, lambda name: name.endswith(".out")
    )
    matched_lines = 0
    for spool_file in spool_files:
        sst, smeta_ok = _lstat_strict(spool_file)
        if not smeta_ok or sst is None or stat.S_ISLNK(sst.st_mode) or not stat.S_ISREG(sst.st_mode):
            scan_ok = False
            continue
        try:
            with spool_file.open("r", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if _text_matches_credential(line, needles, include_generic=include_generic):
                        matched_lines += 1
        except OSError:
            scan_ok = False
    return matched_lines, scan_ok


def _scan_config_sinks(
    home_dir: Path,
    service_files: list[Path],
    needles: list[str],
    *,
    include_generic: bool = True,
) -> tuple[int, int, bool]:
    """Return (config_matching_files, legacy_config_files_present, scan_ok)."""
    scan_ok = True
    legacy_cfg_candidates: list[Path] = [
        home_dir / "opencode.json",
        home_dir / ".last-service-sync.json",
        home_dir / ".active-opencode-clients.json",
    ]
    cfg_dir_files, cfg_dir_ok = _scandir_matching_files(
        home_dir / ".configs",
        lambda name: name.startswith("opencode-") and name.endswith(".json"),
    )
    if not cfg_dir_ok:
        scan_ok = False
    legacy_cfg_candidates.extend(cfg_dir_files)

    legacy_present = 0
    for lc in legacy_cfg_candidates:
        lc_st, lc_meta_ok = _lstat_strict(lc)
        if not lc_meta_ok:
            scan_ok = False
        elif lc_st is not None:
            legacy_present += 1

    all_candidates: list[Path] = []
    for p in [*legacy_cfg_candidates, *service_files]:
        if p not in all_candidates:
            all_candidates.append(p)

    matching_files = 0
    for cf in all_candidates:
        cf_st, cf_meta_ok = _lstat_strict(cf)
        if not cf_meta_ok:
            scan_ok = False
            continue
        if cf_st is None:
            continue
        if stat.S_ISLNK(cf_st.st_mode) or not stat.S_ISREG(cf_st.st_mode):
            scan_ok = False
            continue
        try:
            txt = cf.read_text(encoding="utf-8", errors="replace")
        except OSError:
            scan_ok = False
            continue
        if _text_matches_credential(txt, needles, include_generic=include_generic):
            matching_files += 1
    return matching_files, legacy_present, scan_ok


def _home_contains_specific_needles(
    home_dir: Path, service_files: list[Path], specific_needles: list[str]
) -> tuple[bool, bool]:
    if not specific_needles:
        return False, True
    share_opencode = home_dir / ".local" / "share" / "opencode"
    db_cnt, db_ok = _scan_db_matching_records(
        share_opencode / "opencode.db", specific_needles, include_generic=False
    )
    log_cnt, log_ok = _scan_log_matching_lines(
        share_opencode / "log", specific_needles, include_generic=False
    )
    spool_cnt, spool_ok = _scan_shell_spool_matching_lines(
        share_opencode / "shell", specific_needles, include_generic=False
    )
    cfg_cnt, _, cfg_ok = _scan_config_sinks(
        home_dir, service_files, specific_needles, include_generic=False
    )
    matched = (db_cnt + log_cnt + spool_cnt + cfg_cnt) > 0
    all_ok = db_ok and log_ok and spool_ok and cfg_ok
    return matched, all_ok


def _extract_persisted_session_tokens_in_memory(
    home_dir: Path,
    *,
    max_file_bytes: int = 256 * 1024 * 1024,
    max_single_unit_chars: int = 8 * 1024 * 1024,
) -> tuple[list[str], bool]:
    """Extract se-session-* tokens persisted in home_dir without scraping untrusted ports."""
    tokens: list[str] = []
    extract_ok = True

    def _scan_str(s: str) -> None:
        nonlocal extract_ok
        if len(s) > max_single_unit_chars:
            extract_ok = False
            return
        queue = [(s, 0)]
        seen = set()
        budget = max(16 * 1024 * 1024, max_single_unit_chars * 2)
        while queue:
            text, depth = queue.pop()
            if text in seen:
                continue
            seen.add(text)
            budget -= len(text)
            if budget < 0:
                extract_ok = False
                return
            for match in SE_SESSION_TOKEN_RE.finditer(text):
                if match.group(0) not in tokens:
                    tokens.append(match.group(0))
            # JSON persistence escapes literal backslashes. Explore one bounded
            # unescape layer as well as Unicode substitution, rather than
            # leaving a backslash interleaved between decoded token characters.
            decoded = [text.replace('\\\\', '\\'), unquote(text), re.sub(r'\\u([0-9a-fA-F]{4})',
                lambda m: chr(int(m[1], 16)), text)]
            for match in re.finditer(r'[A-Za-z0-9+/_-]{16,}={0,2}', text):
                candidate = match.group(0).replace('-', '+').replace('_', '/')
                try:
                    decoded.append(base64.b64decode(candidate + '='*((-len(candidate))%4),
                        validate=True).decode('utf-8'))
                except (ValueError, UnicodeDecodeError):
                    pass
            for value in decoded:
                if value and value != text and value not in seen:
                    if depth >= 6:
                        extract_ok = False
                        return
                    queue.append((value, depth+1))

    def _scan_file_streaming(fpath: Path) -> None:
        nonlocal extract_ok
        fst_pre, fmeta_ok = _lstat_strict(fpath)
        if not fmeta_ok or fst_pre is None or stat.S_ISLNK(fst_pre.st_mode) or not stat.S_ISREG(fst_pre.st_mode):
            extract_ok = False
            return
        open_flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
        try:
            fd = os.open(str(fpath), open_flags)
        except OSError:
            extract_ok = False
            return
        try:
            fst = os.fstat(fd)
            if not stat.S_ISREG(fst.st_mode) or fst.st_size > max_file_bytes:
                extract_ok = False
                return
            if getattr(os, "O_NONBLOCK", 0):
                cur_flags = fcntl.fcntl(fd, fcntl.F_GETFL)
                fcntl.fcntl(fd, fcntl.F_SETFL, cur_flags & ~os.O_NONBLOCK)
            decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
            total_bytes_read = 0
            pending = ""
            while extract_ok:
                chunk = os.read(fd, 65536)
                eof = len(chunk) == 0
                if not eof:
                    total_bytes_read += len(chunk)
                    if total_bytes_read > max_file_bytes:
                        extract_ok = False
                        return
                decoded_piece = decoder.decode(chunk, final=eof)
                if decoded_piece:
                    pending += decoded_piece
                if "\n" in pending:
                    parts = pending.split("\n")
                    pending = parts.pop()
                    for ln in parts:
                        if len(ln) > max_single_unit_chars:
                            extract_ok = False
                            return
                        _scan_str(ln)
                        if not extract_ok:
                            return
                if len(pending) > max_single_unit_chars:
                    extract_ok = False
                    return
                if eof:
                    break
            if extract_ok and pending:
                if len(pending) > max_single_unit_chars:
                    extract_ok = False
                    return
                _scan_str(pending)
        except OSError:
            extract_ok = False
            return
        finally:
            try:
                os.close(fd)
            except OSError:
                extract_ok = False

    share_opencode = home_dir / ".local" / "share" / "opencode"
    db_path = share_opencode / "opencode.db"
    db_st, db_meta_ok = _lstat_strict(db_path)
    if not db_meta_ok:
        extract_ok = False
    elif db_st is not None:
        if stat.S_ISLNK(db_st.st_mode) or not stat.S_ISREG(db_st.st_mode):
            extract_ok = False
        else:
            db_valid = True
            try:
                if db_st.st_size > 0:
                    if db_st.st_size < len(SQLITE_MAGIC_HEADER):
                        db_valid = False
                    else:
                        with db_path.open("rb") as fh:
                            if fh.read(len(SQLITE_MAGIC_HEADER)) != SQLITE_MAGIC_HEADER:
                                db_valid = False
            except OSError:
                db_valid = False

            if not db_valid:
                extract_ok = False
            else:
                uri = f"file:{quote(str(db_path.resolve()))}?mode=ro"
                conn: sqlite3.Connection | None = None
                try:
                    try:
                        conn = sqlite3.connect(uri, uri=True, timeout=2.0)
                    except sqlite3.OperationalError:
                        conn = sqlite3.connect(f"{uri}&immutable=1", uri=True, timeout=2.0)
                    cur = conn.cursor()
                    tables = [
                        str(r[0])
                        for r in cur.execute(
                            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
                        ).fetchall()
                        if isinstance(r[0], str)
                    ]
                    for tbl in tables:
                        safe_tbl = '"' + tbl.replace('"', '""') + '"'
                        for row in cur.execute(f"SELECT * FROM {safe_tbl}"):
                            for col in row:
                                if isinstance(col, str):
                                    _scan_str(col)
                                elif isinstance(col, (bytes, bytearray, memoryview)):
                                    _scan_str(bytes(col).decode("utf-8", errors="replace"))
                except (OSError, sqlite3.Error):
                    extract_ok = False
                finally:
                    if conn is not None:
                        try:
                            conn.close()
                        except sqlite3.Error:
                            pass

    log_files, log_list_ok = _scandir_matching_files(
        share_opencode / "log", lambda name: name.startswith("opencode.log")
    )
    if not log_list_ok:
        extract_ok = False
    for lf in log_files:
        _scan_file_streaming(lf)

    spool_files, spool_list_ok = _walk_matching_files_strict(
        share_opencode / "shell", lambda name: name.endswith(".out")
    )
    if not spool_list_ok:
        extract_ok = False
    for sf in spool_files:
        _scan_file_streaming(sf)

    svc_files, svc_ok = _find_legacy_service_files(home_dir)
    if not svc_ok:
        extract_ok = False
    cfg_dir_files, cfg_dir_ok = _scandir_matching_files(
        home_dir / ".configs",
        lambda name: name.startswith("opencode-") and name.endswith(".json"),
    )
    if not cfg_dir_ok:
        extract_ok = False
    cfg_candidates: list[Path] = [
        home_dir / "opencode.json",
        home_dir / ".last-service-sync.json",
        home_dir / ".active-opencode-clients.json",
        *svc_files,
        *cfg_dir_files,
    ]

    seen_cfgs: list[Path] = []
    for cf in cfg_candidates:
        if cf not in seen_cfgs:
            seen_cfgs.append(cf)
    for cf in seen_cfgs:
        cf_st, cf_meta_ok = _lstat_strict(cf)
        if not cf_meta_ok:
            extract_ok = False
            continue
        if cf_st is None:
            continue
        if stat.S_ISLNK(cf_st.st_mode) or not stat.S_ISREG(cf_st.st_mode):
            extract_ok = False
            continue
        try:
            _scan_str(cf.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            extract_ok = False

    return tokens, extract_ok


def _resolve_token_file_in_runs(runs_dir: Path, raw_tok_path: str) -> Path | None:
    p = Path(raw_tok_path).expanduser()
    if not p.is_absolute():
        p = runs_dir / p
    try:
        if p.is_symlink() or not p.is_file():
            return None
        return p
    except OSError:
        return None


def _pid_identity_from_record_fields(pid_val: Any, lstart_val: Any, *, starting: bool = False) -> tuple[int, str | None, str]:
    pid_int = int(pid_val) if isinstance(pid_val, int) and not isinstance(pid_val, bool) else 0
    lstart_clean = (
        lstart_val.strip()
        if isinstance(lstart_val, str) and lstart_val.strip() and lstart_val.strip() != "unavailable"
        else None
    )
    if pid_int > 1:
        if not pid_is_alive(pid_int) or pid_is_zombie(pid_int):
            state = "dead"
        elif lstart_clean is not None:
            state = classify_pid_identity(pid_int, lstart_clean)
        else:
            state = "unavailable"
    elif starting:
        state = "unavailable"
    else:
        state = "dead"
    assert state in PID_IDENTITY_STATES
    return pid_int, lstart_clean, state


def _classify_active_models(
    *,
    runs_dir: Path,
    home_dir: Path,
    service_files: list[Path],
    evidence_obj: dict[str, Any] | None,
    target_model_id: str | None = None,
    prior_exposed_tokens: list[str] | None = None,
) -> dict[str, list[dict[str, Any]]]:
    affected: list[dict[str, Any]] = []
    unrelated_proxies: list[dict[str, Any]] = []
    unrelated_local: list[dict[str, Any]] = []
    ambiguous: list[dict[str, Any]] = []
    rotated_candidates: list[dict[str, Any]] = []

    runs_st, runs_meta_ok = _lstat_strict(runs_dir)
    if not runs_meta_ok:
        return {
            "affected_proxies": affected,
            "unrelated_proxies": unrelated_proxies,
            "unrelated_local": unrelated_local,
            "ambiguous_proxies": ambiguous,
            "runs_inspection_ok": False,
        }
    if runs_st is None:
        return {
            "affected_proxies": affected,
            "unrelated_proxies": unrelated_proxies,
            "unrelated_local": unrelated_local,
            "ambiguous_proxies": ambiguous,
            "runs_inspection_ok": True,
        }
    if stat.S_ISLNK(runs_st.st_mode) or not stat.S_ISDIR(runs_st.st_mode):
        return {
            "affected_proxies": affected,
            "unrelated_proxies": unrelated_proxies,
            "unrelated_local": unrelated_local,
            "ambiguous_proxies": ambiguous,
            "runs_inspection_ok": False,
        }

    persisted_tokens, tok_extract_ok = _extract_persisted_session_tokens_in_memory(home_dir)
    effective_exposed_tokens = list(
        dict.fromkeys([*persisted_tokens, *(prior_exposed_tokens or [])])
    )
    db_st_c, db_ok_c = _lstat_strict(home_dir / ".local" / "share" / "opencode" / "opencode.db")
    oc_st_c, oc_ok_c = _lstat_strict(home_dir / "opencode.json")
    home_has_uncontained_state = (
        bool(service_files)
        or not db_ok_c
        or db_st_c is not None
        or not oc_ok_c
        or oc_st_c is not None
    )
    expected_started_at = ""
    expected_model_id = ""
    expected_pid = 0
    expected_lstart = ""
    if isinstance(evidence_obj, dict):
        cac = evidence_obj.get("current_artifact_comparisons")
        if isinstance(cac, dict):
            if isinstance(cac.get("proxy_record_started_at"), str):
                expected_started_at = cac["proxy_record_started_at"].strip()
            if isinstance(cac.get("proxy_record_model_id"), str):
                expected_model_id = cac["proxy_record_model_id"].strip()
            elif isinstance(cac.get("model_id"), str):
                expected_model_id = cac["model_id"].strip()
            raw_ep = cac.get("proxy_record_pid")
            if isinstance(raw_ep, int) and not isinstance(raw_ep, bool):
                expected_pid = raw_ep
            if isinstance(cac.get("proxy_record_pid_lstart"), str):
                expected_lstart = cac["proxy_record_pid_lstart"].strip()
        if not expected_started_at and isinstance(evidence_obj.get("target_proxy_started_at"), str):
            expected_started_at = str(evidence_obj["target_proxy_started_at"]).strip()
        if not expected_model_id and isinstance(evidence_obj.get("target_model_id"), str):
            expected_model_id = str(evidence_obj["target_model_id"]).strip()
        if expected_pid <= 0:
            raw_tp = evidence_obj.get("target_proxy_pid")
            if isinstance(raw_tp, int) and not isinstance(raw_tp, bool):
                expected_pid = raw_tp
        if not expected_lstart and isinstance(evidence_obj.get("target_proxy_pid_lstart"), str):
            expected_lstart = str(evidence_obj["target_proxy_pid_lstart"]).strip()

    seen_identities: set[tuple[str, int, int]] = set()
    pid_files, runs_inspection_ok = _scandir_matching_files(
        runs_dir, lambda name: name.startswith(".serve") and name.endswith(".pid")
    )

    for pid_file in pid_files:
        pst, pmeta_ok = _lstat_strict(pid_file)
        if not pmeta_ok or pst is None or stat.S_ISLNK(pst.st_mode) or not stat.S_ISREG(pst.st_mode):
            runs_inspection_ok = False
            continue
        try:
            rec = json.loads(pid_file.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            runs_inspection_ok = False
            continue
        if not isinstance(rec, dict):
            runs_inspection_ok = False
            continue

        mid = str(rec.get("model_id") or "").strip()
        port_raw = rec.get("port")
        port = int(port_raw) if isinstance(port_raw, int) and not isinstance(port_raw, bool) else 0
        tier = str(rec.get("trust_tier") or "").strip()
        raw_tok_file = rec.get("session_token_file")
        is_proxy = bool(isinstance(raw_tok_file, str) and raw_tok_file.strip()) or (
            tier in ATTESTED_TIERS
        )
        if tier == "local" and not (isinstance(raw_tok_file, str) and raw_tok_file.strip()):
            is_proxy = False

        is_starting = rec.get("status") == "starting"
        pid_int, lstart_clean, identity_state = _pid_identity_from_record_fields(
            rec.get("pid"), rec.get("pid_lstart"), starting=is_starting
        )
        up_pid_int, up_lstart_clean, upstream_identity_state = _pid_identity_from_record_fields(
            rec.get("upstream_pid"), rec.get("upstream_pid_lstart"), starting=False
        )

        dedup_key = (mid or pid_file.name, pid_int, port)
        if dedup_key in seen_identities:
            continue

        if identity_state in ("dead", "reused") and upstream_identity_state in ("dead", "reused"):
            continue

        seen_identities.add(dedup_key)
        tok_path: Path | None = None
        tok_val = ""
        token_generation = 1
        token_valid = True
        if isinstance(raw_tok_file, str) and raw_tok_file.strip():
            tok_path = _resolve_token_file_in_runs(runs_dir, raw_tok_file.strip())
            if tok_path is not None:
                try:
                    raw_credential = tok_path.read_text(encoding="utf-8").strip()
                    parsed_token = parse_session_token_raw(raw_credential)
                    token_valid = parsed_token is not None
                    tok_val = parsed_token or ''
                    if token_valid and raw_credential.startswith('{'):
                        token_generation = json.loads(raw_credential)['generation']
                except OSError:
                    tok_val = ""
                    token_valid = False

        entry: dict[str, Any] = {
            "model_id": mid,
            "pid": pid_int,
            "pid_lstart": lstart_clean,
            "identity_state": identity_state,
            "upstream_pid": up_pid_int,
            "upstream_pid_lstart": up_lstart_clean,
            "upstream_identity_state": upstream_identity_state,
            "port": port,
            "started_at": str(rec.get("started_at") or "").strip(),
            "pid_file": pid_file,
            "token_file": tok_path,
            "token_value": tok_val,
            "token_generation": token_generation,
        }

        if not is_proxy:
            unrelated_local.append(entry)
            continue

        matched_by_token = False
        needle_scan_ok = tok_extract_ok and token_valid
        if tok_val:
            matched_by_token, scan_ok = _home_contains_specific_needles(
                home_dir, service_files, _secret_variants_in_memory(tok_val)
            )
            if not scan_ok:
                needle_scan_ok = False

        matched_by_target = bool(target_model_id and mid == target_model_id)
        matched_by_verified_evidence_proc = bool(
            expected_model_id
            and mid == expected_model_id
            and expected_pid > 1
            and pid_int == expected_pid
            and expected_lstart
            and lstart_clean is not None
            and lstart_clean == expected_lstart
        )
        matched_by_started_at = bool(
            expected_started_at and entry["started_at"] == expected_started_at
        )

        primary_ok = identity_state in ("matched", "dead", "reused") and (
            identity_state == "matched" or upstream_identity_state == "matched"
        )
        upstream_ok = upstream_identity_state != "unavailable"

        if matched_by_token or matched_by_target or matched_by_verified_evidence_proc:
            if not primary_ok or not upstream_ok or not mid:
                ambiguous.append(entry)
            else:
                affected.append(entry)
        elif not needle_scan_ok:
            ambiguous.append(entry)
        elif token_generation > 1 and effective_exposed_tokens:
            # A current envelope does not attribute older leaked generations.
            # Preserve evidence and require --target-model rather than replaying
            # exposed credentials to a listener whose ownership is not proven.
            rotated_candidates.append(entry)
        elif matched_by_started_at:
            if (
                identity_state == "matched"
                and upstream_ok
                and tok_val
                and effective_exposed_tokens
                and tok_val not in effective_exposed_tokens
                and not matched_by_token
                and (not expected_model_id or mid != expected_model_id)
            ) or (
                identity_state == "matched"
                and upstream_ok
                and not home_has_uncontained_state
                and not matched_by_token
            ):
                unrelated_proxies.append(entry)
            else:
                ambiguous.append(entry)
        elif effective_exposed_tokens and (
            identity_state != "matched"
            or not upstream_ok
            or not tok_val
            or tok_val in effective_exposed_tokens
        ):
            ambiguous.append(entry)
        else:
            unrelated_proxies.append(entry)

    # Attribution is a two-pass decision: earlier records may have an unrelated
    # rotated session before a later record attributes the leaked current token.
    attributed = {entry['token_value'] for entry in affected
                  if entry.get('token_value') in effective_exposed_tokens}
    for entry in rotated_candidates:
        if any(token not in attributed for token in effective_exposed_tokens):
            ambiguous.append(entry)
        else:
            unrelated_proxies.append(entry)

    if target_model_id:
        target_hits = [e for e in affected if e.get("model_id") == target_model_id]
        if len(target_hits) > 1:
            affected = [e for e in affected if e.get("model_id") != target_model_id]
            ambiguous.extend(target_hits)

    return {
        "affected_proxies": affected,
        "unrelated_proxies": unrelated_proxies,
        "unrelated_local": unrelated_local,
        "ambiguous_proxies": ambiguous,
        "runs_inspection_ok": bool(runs_inspection_ok),
    }


def _probe_tcp_listener_closed(port: int) -> str:
    """Unauthenticated loopback TCP check: returns 'closed', 'open', or 'unknown'."""
    if not isinstance(port, int) or isinstance(port, bool) or port <= 0 or port > 65535:
        return "unknown"
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(1.5)
        try:
            sock.connect(("127.0.0.1", port))
            return "open"
        except ConnectionRefusedError:
            return "closed"
        except OSError as exc:
            if exc.errno == errno.ECONNREFUSED:
                return "closed"
            return "unknown"


def _probe_port_token_revocation(port: int, token: str | None) -> str:
    """Probe a verified runs_dir proxy port and return 'accepted', 'revoked', or 'unknown'.

    Callers MUST confirm either TCP closure via _probe_tcp_listener_closed or positive ownership
    of port by a verified runs_dir se-key-proxy record before supplying a bearer token.
    """
    tcp_state = _probe_tcp_listener_closed(port)
    if tcp_state == "closed":
        return "revoked"
    if tcp_state == "unknown":
        return "unknown"
    if not token:
        return "accepted"

    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=2.0)
    try:
        conn.request(
            "GET",
            "/v1/models",
            headers={"Authorization": f"Bearer {token}", "Connection": "close"},
        )
        resp = conn.getresponse()
        _ = resp.read(1024)
        if resp.status in (401, 403):
            return "revoked"
        if 200 <= resp.status < 300:
            return "accepted"
        return "unknown"
    except ConnectionRefusedError:
        return "revoked"
    except (TimeoutError, socket.timeout, http.client.HTTPException):
        return "unknown"
    except OSError as exc:
        if exc.errno == errno.ECONNREFUSED:
            return "revoked"
        return "unknown"
    finally:
        try:
            conn.close()
        except Exception:
            pass


def _list_current_uid_ps_commands() -> tuple[list[tuple[int, str]], bool]:
    """Return ([(pid, command_line), ...], ps_ok) for live processes owned by current UID."""
    try:
        proc = subprocess.run(
            ["/bin/ps", "-U", str(os.getuid()), "-o", "pid=,command="],
            env={**os.environ, "LC_ALL": "C", "TZ": "UTC"},
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return [], False

    if proc.returncode != 0:
        return [], False

    rows: list[tuple[int, str]] = []
    for raw_line in (proc.stdout or "").splitlines():
        stripped = raw_line.strip()
        if not stripped:
            continue
        parts = stripped.split(None, 1)
        if len(parts) < 2 or not parts[0].isdigit():
            continue
        rows.append((int(parts[0]), parts[1]))
    return rows, True


def _find_unaccounted_se_key_proxy_pids(
    runs_dir: Path, accounted_pids: set[int]
) -> tuple[list[int], bool]:
    """Return (unaccounted_pids, ps_ok) for live se-key-proxy processes owned by current UID.

    Every live current-UID production se-key-proxy outside accounted_pids remains unaccounted
    regardless of its --session-token-file directory (ISO-W2): token-file location is an
    attribution hint, not proof that its active session token differs from persisted values.
    """
    del runs_dir
    ps_rows, ps_ok = _list_current_uid_ps_commands()
    if not ps_ok:
        return [], False

    unaccounted: list[int] = []
    my_pid = os.getpid()

    for pid, cmd in ps_rows:
        if pid <= 1 or pid == my_pid or pid in accounted_pids:
            continue
        if "se-key-proxy" not in cmd or "se-key-proxy-test" in cmd:
            continue
        padded = f" {cmd} "
        if " proxy " not in padded and "--session-token-file" not in cmd:
            continue
        unaccounted.append(pid)

    return unaccounted, True


def _path_variant_in_ps_command(cmd_str: str, variants: list[str]) -> bool:
    for var in variants:
        if re.search(rf"(?:^|[\s=:\"']){re.escape(var)}(?:$|[\s/:\"'])", cmd_str):
            return True
    return False


_OPENCODE_SERVICE_EXE_RE = re.compile(
    r"^opencode(?:-(?:darwin|linux)-(?:arm64|x64)(?:-(?:baseline|musl))?)?$"
)
_PS_ENV_ASSIGN_TOKEN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
_PS_UPPER_ENV_TOKEN_RE = re.compile(r"^[A-Z_][A-Z0-9_]*=")


def _parse_loopback_service_url_port(raw_url: Any) -> tuple[bool, int | None]:
    if not isinstance(raw_url, str) or not raw_url.strip():
        return False, None
    s = raw_url.strip()
    if any(ch.isspace() or ord(ch) < 32 for ch in s):
        return False, None
    try:
        parsed = urlparse(s)
        port = parsed.port
    except ValueError:
        return False, None
    if parsed.scheme.lower() not in ("http", "https"):
        return False, None
    if (parsed.hostname or "").lower() not in ("127.0.0.1", "localhost", "::1"):
        return False, None
    if parsed.username is not None or parsed.password is not None:
        return False, None
    if parsed.path not in ("", "/") or parsed.params != "" or parsed.query != "" or parsed.fragment != "":
        return False, None
    if not isinstance(port, int) or isinstance(port, bool) or not (1 <= port <= 65535):
        return False, None
    return True, int(port)


def _parse_legacy_service_record(
    svc_file: Path, home_dir: Path
) -> tuple[bool, int | None, int | None, str | None, bool]:
    """Validate a legacy service.json record and distinguish scope-root launcher sidecars (R1).

    Returns (record_ok, svc_pid, svc_port, expected_lstart, launcher_bound).
    Any unreadable, symlinked, malformed, writable-root, or conflicting identity record returns
    record_ok=False. Inline `service.json["pid_lstart"]` and nested `.local`/`.config` sidecars
    have no trusted launcher producer: they are checked strictly for format and non-conflict and
    may constrain `expected_lstart` against PID reuse, never setting `launcher_bound=True` and
    never synthesizing `svc_pid` or `svc_port` absent from `service.json` (safe against both
    base HEAD 2dc07f3 and `_try_bind_service_identity_sidecar`). Note that `launcher_bound`
    records provenance/completeness only and carries zero authority to bypass independent service
    attribution in `_classify_legacy_service_pid`.
    """
    st, meta_ok = _lstat_strict(svc_file)
    if not meta_ok or st is None or stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        return False, None, None, None, False
    try:
        svc_obj = json.loads(svc_file.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return False, None, None, None, False
    if not isinstance(svc_obj, dict):
        return False, None, None, None, False

    svc_pid: int | None = None
    if "pid" in svc_obj:
        raw_pid = svc_obj.get("pid")
        if isinstance(raw_pid, int) and not isinstance(raw_pid, bool) and raw_pid > 1:
            svc_pid = int(raw_pid)
        else:
            return False, None, None, None, False

    if "hostname" in svc_obj:
        raw_h = svc_obj.get("hostname")
        if not isinstance(raw_h, str) or raw_h.strip().lower() not in ("127.0.0.1", "localhost", "::1"):
            return False, None, None, None, False

    svc_port: int | None = None
    if "port" in svc_obj:
        raw_port = svc_obj.get("port")
        if isinstance(raw_port, int) and not isinstance(raw_port, bool) and 1 <= raw_port <= 65535:
            svc_port = int(raw_port)
        else:
            return False, None, None, None, False

    if "url" in svc_obj:
        url_ok, url_port = _parse_loopback_service_url_port(svc_obj.get("url"))
        if not url_ok or url_port is None:
            return False, None, None, None, False
        if svc_port is not None and svc_port != url_port:
            return False, None, None, None, False
        svc_port = url_port

    untrusted_lstarts: set[str] = set()
    if "pid_lstart" in svc_obj:
        raw_ls = svc_obj.get("pid_lstart")
        if (
            svc_pid is None
            or not isinstance(raw_ls, str)
            or not raw_ls.strip()
            or raw_ls.strip() == "unavailable"
        ):
            return False, None, None, None, False
        untrusted_lstarts.add(" ".join(raw_ls.split()))

    root_sidecars = (
        home_dir / "service-identity.json",
        home_dir / ".service-identity.json",
    )
    nested_sidecars: list[Path] = []
    for cand in (
        svc_file.parent / "service-identity.json",
        svc_file.parent / ".service-identity.json",
    ):
        if cand not in root_sidecars and cand not in nested_sidecars:
            nested_sidecars.append(cand)

    for sc_path in nested_sidecars:
        sc_st, sc_ok = _lstat_strict(sc_path)
        if not sc_ok:
            return False, None, None, None, False
        if sc_st is None:
            continue
        if stat.S_ISLNK(sc_st.st_mode) or not stat.S_ISREG(sc_st.st_mode):
            return False, None, None, None, False
        try:
            sc_obj = json.loads(sc_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            return False, None, None, None, False
        if not isinstance(sc_obj, dict):
            return False, None, None, None, False
        sc_pid = sc_obj.get("pid")
        sc_ls = sc_obj.get("pid_lstart")
        sc_port = sc_obj.get("service_port")
        if (
            not isinstance(sc_pid, int)
            or isinstance(sc_pid, bool)
            or sc_pid <= 1
            or not isinstance(sc_ls, str)
            or not sc_ls.strip()
            or sc_ls.strip() == "unavailable"
        ):
            return False, None, None, None, False
        if sc_port is not None and (
            not isinstance(sc_port, int) or isinstance(sc_port, bool) or not (1 <= sc_port <= 65535)
        ):
            return False, None, None, None, False
        if svc_pid is None or int(sc_pid) != svc_pid:
            return False, None, None, None, False
        if sc_port is not None and (svc_port is None or int(sc_port) != svc_port):
            return False, None, None, None, False
        untrusted_lstarts.add(" ".join(sc_ls.split()))

    launcher_lstarts: set[str] = set()
    for sc_path in root_sidecars:
        sc_st, sc_ok = _lstat_strict(sc_path)
        if not sc_ok:
            return False, None, None, None, False
        if sc_st is None:
            continue
        if (
            stat.S_ISLNK(sc_st.st_mode)
            or not stat.S_ISREG(sc_st.st_mode)
            or sc_st.st_uid != os.getuid()
            or (sc_st.st_mode & 0o222) != 0
        ):
            return False, None, None, None, False
        try:
            sc_obj = json.loads(sc_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            return False, None, None, None, False
        if not isinstance(sc_obj, dict):
            return False, None, None, None, False
        sc_ver = sc_obj.get("schema_version")
        sc_id = sc_obj.get("id")
        sc_pid = sc_obj.get("pid")
        sc_ls = sc_obj.get("pid_lstart")
        sc_port = sc_obj.get("service_port")
        if (
            isinstance(sc_ver, bool)
            or sc_ver != 1
            or not isinstance(sc_id, str)
            or not sc_id.strip()
            or not isinstance(sc_pid, int)
            or isinstance(sc_pid, bool)
            or sc_pid <= 1
            or not isinstance(sc_ls, str)
            or not sc_ls.strip()
            or sc_ls.strip() == "unavailable"
        ):
            return False, None, None, None, False
        if sc_port is not None and (
            not isinstance(sc_port, int) or isinstance(sc_port, bool) or not (1 <= sc_port <= 65535)
        ):
            return False, None, None, None, False
        if svc_pid is not None and int(sc_pid) != svc_pid:
            return False, None, None, None, False
        if svc_pid is None:
            svc_pid = int(sc_pid)
        if sc_port is not None:
            if svc_port is not None and int(sc_port) != svc_port:
                return False, None, None, None, False
            svc_port = int(sc_port)
        launcher_lstarts.add(" ".join(sc_ls.split()))

    all_lstarts = launcher_lstarts | untrusted_lstarts
    if len(all_lstarts) > 1:
        return False, None, None, None, False
    launcher_bound = len(launcher_lstarts) == 1
    expected_lstart = next(iter(all_lstarts)) if all_lstarts else None
    return True, svc_pid, svc_port, expected_lstart, launcher_bound


def _unwrap_ps_eww_service_command(cmd_str: str) -> tuple[list[str], str, str]:
    """Split `ps eww` command+env into (unwrapped_argv_tokens, argv_str, env_str)."""
    spans = [(m.group(0), m.start(), m.end()) for m in re.finditer(r"\S+", cmd_str)]
    if not spans:
        return [], "", ""

    idx = 0
    if os.path.basename(spans[idx][0]) == "env":
        idx += 1
        while idx < len(spans):
            tok = spans[idx][0]
            if tok == "--":
                idx += 1
                break
            if tok in ("-u", "-P", "-S", "-C"):
                idx += 2
                continue
            if tok.startswith("-"):
                idx += 1
                continue
            if _PS_ENV_ASSIGN_TOKEN_RE.match(tok):
                idx += 1
                continue
            break

    if idx < len(spans) and os.path.basename(spans[idx][0]) == "sandbox-exec":
        idx += 1
        while idx < len(spans):
            tok = spans[idx][0]
            if tok == "--":
                idx += 1
                break
            if tok in ("-f", "-p", "-n", "-D"):
                idx += 2
                continue
            if tok.startswith(("-f", "-p", "-n", "-D")) and len(tok) > 2:
                idx += 1
                continue
            if tok.startswith("-"):
                idx += 1
                continue
            break

    if idx >= len(spans):
        return [], "", cmd_str

    env_idx: int | None = None
    for k in range(idx + 1, len(spans)):
        if _PS_UPPER_ENV_TOKEN_RE.match(spans[k][0]):
            env_idx = k
            break

    argv_tokens = [spans[k][0] for k in range(idx, env_idx if env_idx is not None else len(spans))]
    argv_end = spans[env_idx][1] if env_idx is not None else len(cmd_str)
    argv_str = cmd_str[spans[idx][1] : argv_end].strip()
    env_str = cmd_str[spans[env_idx][1] :].strip() if env_idx is not None else ""
    return argv_tokens, argv_str, env_str


_OPENCODE_LOG_LEVELS = frozenset(
    {"all", "trace", "debug", "info", "warn", "warning", "error", "fatal", "none"}
)


def _parse_opencode_service_argv(argv_tokens: list[str]) -> tuple[bool, int | None, bool]:
    """Parse OpenCode background service launch argv strictly (R1).

    Returns (is_service, explicit_port, bad_port).
    Requires an OpenCode executable followed only by allowed global flags, the
    `serve` command in its actual command position (or standalone `--service` /
    `--service=true` / `--service=1`), and closed `opencode serve` flags with
    zero positional arguments, zero `--` end-of-options markers, and zero
    client subcommands (`run`, `service`, `web`, `attach`, etc.).
    """
    if len(argv_tokens) < 2:
        return (False, None, False)
    exe_base = os.path.basename(argv_tokens[0].strip("\"'")).lower()
    if not _OPENCODE_SERVICE_EXE_RE.match(exe_base):
        return (False, None, False)

    idx = 1
    n = len(argv_tokens)
    while idx < n:
        tok = argv_tokens[idx]
        if tok == "--print-logs":
            idx += 1
            continue
        if tok.startswith("--log-level="):
            lvl = tok.split("=", 1)[1].strip("\"'").lower()
            if lvl not in _OPENCODE_LOG_LEVELS:
                return (False, None, False)
            idx += 1
            continue
        if tok == "--log-level":
            if idx + 1 >= n:
                return (False, None, False)
            lvl = argv_tokens[idx + 1].strip("\"'").lower()
            if lvl not in _OPENCODE_LOG_LEVELS:
                return (False, None, False)
            idx += 2
            continue
        break

    if idx >= n:
        return (False, None, False)

    cmd_tok = argv_tokens[idx]
    if cmd_tok == "serve" or cmd_tok in ("--service", "--service=true", "--service=1"):
        idx += 1
    else:
        return (False, None, False)

    explicit_port: int | None = None
    while idx < n:
        tok = argv_tokens[idx]
        if tok in ("--service", "--service=true", "--service=1"):
            idx += 1
            continue
        if tok in ("--stdio", "--stdio=true", "--stdio=1", "--stdio=false", "--stdio=0"):
            idx += 1
            continue
        if tok == "--print-logs":
            idx += 1
            continue
        if tok.startswith("--log-level="):
            lvl = tok.split("=", 1)[1].strip("\"'").lower()
            if lvl not in _OPENCODE_LOG_LEVELS:
                return (False, None, False)
            idx += 1
            continue
        if tok == "--log-level":
            if idx + 1 >= n:
                return (False, None, False)
            lvl = argv_tokens[idx + 1].strip("\"'").lower()
            if lvl not in _OPENCODE_LOG_LEVELS:
                return (False, None, False)
            idx += 2
            continue
        if tok.startswith("--hostname="):
            val = tok.split("=", 1)[1].strip("\"'")
            if not val or val.startswith("-"):
                return (False, None, False)
            idx += 1
            continue
        if tok == "--hostname":
            if idx + 1 >= n:
                return (False, None, False)
            val = argv_tokens[idx + 1].strip("\"'")
            if not val or val.startswith("-"):
                return (False, None, False)
            idx += 2
            continue
        if tok.startswith("--cors="):
            val = tok.split("=", 1)[1].strip("\"'")
            if not val or val.startswith("-"):
                return (False, None, False)
            idx += 1
            continue
        if tok == "--cors":
            if idx + 1 >= n:
                return (False, None, False)
            val = argv_tokens[idx + 1].strip("\"'")
            if not val or val.startswith("-"):
                return (False, None, False)
            idx += 2
            continue
        if tok.startswith("--port=") or tok == "--port":
            if tok == "--port":
                if idx + 1 >= n:
                    return (False, None, True)
                raw_p = argv_tokens[idx + 1].strip("\"'")
                step = 2
            else:
                raw_p = tok.split("=", 1)[1].strip("\"'")
                step = 1
            if not (raw_p.isascii() and raw_p.isdigit()):
                return (False, None, True)
            parsed_p = int(raw_p)
            if not (1 <= parsed_p <= 65535):
                return (False, None, True)
            if explicit_port is not None and explicit_port != parsed_p:
                return (False, None, True)
            explicit_port = parsed_p
            idx += step
            continue
        return (False, None, False)

    return (True, explicit_port, False)


def _is_opencode_service_argv_tokens(argv_tokens: list[str]) -> bool:
    is_svc, _, bad_port = _parse_opencode_service_argv(argv_tokens)
    return is_svc and not bad_port


def _classify_legacy_service_pid(
    pid: int,
    port: int | None,
    home_dir: Path,
    *,
    expected_lstart: str | None = None,
    launcher_bound: bool = False,
    lsof_bin: Path | None = None,
) -> tuple[str, str | None]:
    """Classify a legacy service.json PID using a coherent lstart sandwich and full attribution (F1, ISO-P1, R1).

    Returns (state, verified_lstart) where state is in PID_IDENTITY_STATES.
    `launcher_bound` indicates a validated 0400 scope-root sidecar (requiring `expected_lstart`);
    it never bypasses independent OpenCode service argv, legacy-home env, or port/listener checks.
    """
    if pid <= 1 or pid == os.getpid() or not pid_is_alive(pid) or pid_is_zombie(pid):
        return ("dead", None)

    clean_expected = (
        " ".join(expected_lstart.split())
        if isinstance(expected_lstart, str) and expected_lstart.strip()
        else None
    )
    if launcher_bound and clean_expected is None:
        return ("unavailable", None)
    if clean_expected is not None:
        st_pre = classify_pid_identity(pid, clean_expected)
        if st_pre != "matched":
            return (st_pre, None)
        lstart_anchor = clean_expected
    else:
        lstart_before = get_process_lstart(pid)
        if not lstart_before or not lstart_before.strip():
            return (
                ("unavailable", None)
                if (pid_is_alive(pid) and not pid_is_zombie(pid))
                else ("dead", None)
            )
        lstart_anchor = " ".join(lstart_before.split())

    try:
        ps_proc = subprocess.run(
            ["/bin/ps", "eww", "-p", str(pid), "-o", "uid=,command="],
            env={**os.environ, "LC_ALL": "C", "TZ": "UTC"},
            capture_output=True,
            text=True,
            timeout=4,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return (
            ("unavailable", None)
            if (pid_is_alive(pid) and not pid_is_zombie(pid))
            else ("dead", None)
        )

    ps_out = (ps_proc.stdout or "").strip()
    if ps_proc.returncode != 0 or not ps_out:
        return (
            ("unavailable", None)
            if (pid_is_alive(pid) and not pid_is_zombie(pid))
            else ("dead", None)
        )

    ps_parts = ps_out.split(None, 1)
    if len(ps_parts) < 2 or not ps_parts[0].isdigit():
        return ("unavailable", None)
    proc_uid = int(ps_parts[0])
    cmd_str = ps_parts[1]

    def _finish(matched_owner: bool) -> tuple[str, str | None]:
        after = classify_pid_identity(pid, lstart_anchor)
        if after == "dead":
            return ("dead", None)
        if after == "unavailable":
            return ("unavailable", None)
        if after == "reused" or not matched_owner:
            return ("reused", None)
        return ("matched", lstart_anchor)

    if proc_uid != os.getuid():
        return _finish(False)

    argv_tokens, argv_str, env_str = _unwrap_ps_eww_service_command(cmd_str)
    home_variants = _dual_realpath_variants(home_dir)
    if any(f"{hv}/.invocations" in cmd_str for hv in home_variants):
        return _finish(False)

    valid_port = isinstance(port, int) and not isinstance(port, bool) and 1 <= port <= 65535
    m_port = re.search(r"(?:^|\s)--port(?:=|\s+)(\d+)\b", argv_str)
    if m_port is not None and valid_port and int(m_port.group(1)) != int(port):
        return _finish(False)

    # Every live legacy service candidate (whether bound by a scope-root sidecar, constrained by
    # untrusted inline/nested metadata, or historical) MUST satisfy independent OpenCode serve argv
    # grammar, legacy-home env, non-invocation XDG_STATE_HOME, and --port or TCP LISTEN proof (R1).
    if not valid_port:
        return (
            ("unavailable", None)
            if (pid_is_alive(pid) and not pid_is_zombie(pid))
            else ("dead", None)
        )

    is_service_cmd, explicit_service_port, bad_service_port = _parse_opencode_service_argv(
        argv_tokens
    )
    if not is_service_cmd or bad_service_port:
        return _finish(False)
    if explicit_service_port is not None and int(explicit_service_port) != int(port):
        return _finish(False)

    norm_homes = {hv.rstrip("/") or "/" for hv in home_variants}
    allowed_states = {f"{hv.rstrip('/')}/.local/state" for hv in home_variants}
    matched_home_env = False

    m_oc_home = re.search(r"(?:^|\s)OPENCODE_TEST_HOME=([^\s]+)", env_str)
    m_home = re.search(r"(?:^|\s)HOME=([^\s]+)", env_str)
    if m_oc_home is not None:
        oc_val = m_oc_home.group(1).strip("\"'").rstrip("/") or "/"
        if oc_val not in norm_homes:
            return _finish(False)
        matched_home_env = True
    elif m_home is not None:
        home_val = m_home.group(1).strip("\"'").rstrip("/") or "/"
        if home_val not in norm_homes:
            return _finish(False)
        matched_home_env = True

    m_xdg_state = re.search(r"(?:^|\s)XDG_STATE_HOME=([^\s]+)", env_str)
    if m_xdg_state is not None:
        xdg_val = m_xdg_state.group(1).strip("\"'").rstrip("/")
        if xdg_val not in allowed_states:
            return _finish(False)
        matched_home_env = True

    if not matched_home_env or not _path_variant_in_ps_command(env_str, home_variants):
        return _finish(False)

    if explicit_service_port is not None and int(explicit_service_port) == int(port):
        return _finish(True)

    eff_lsof = lsof_bin if lsof_bin is not None else _resolve_default_lsof_bin()
    if not eff_lsof.is_file():
        return ("unavailable", None)

    try:
        lsof_probe = subprocess.run(
            [str(eff_lsof), "-n", "-P", "-p", str(pid), "-Fn"],
            capture_output=True,
            text=True,
            timeout=4,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ("unavailable", None)

    if lsof_probe.returncode != 0 or not (lsof_probe.stdout or "").strip():
        return (
            ("unavailable", None)
            if (pid_is_alive(pid) and not pid_is_zombie(pid))
            else ("dead", None)
        )

    try:
        lsof_port = subprocess.run(
            [
                str(eff_lsof),
                "-Pan",
                "-p",
                str(pid),
                f"-iTCP:{int(port)}",
                "-sTCP:LISTEN",
                "-Fn",
            ],
            capture_output=True,
            text=True,
            timeout=4,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ("unavailable", None)

    if lsof_port.returncode not in (0, 1) or (
        lsof_port.returncode == 1 and (lsof_port.stderr or "").strip()
    ):
        return (
            ("unavailable", None)
            if (pid_is_alive(pid) and not pid_is_zombie(pid))
            else ("dead", None)
        )

    port_suffix = f":{int(port)}"
    if lsof_port.returncode == 0 and any(
        ln.startswith("n") and ln.endswith(port_suffix)
        for ln in (lsof_port.stdout or "").splitlines()
    ):
        return _finish(True)

    return _finish(False)


def _resolve_default_lsof_bin() -> Path:
    env_override = os.environ.get("FREE_INFERENCE_LSOF_BIN", "").strip()
    if env_override:
        return Path(env_override)
    for cand in ("/usr/sbin/lsof", "/usr/bin/lsof"):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return Path(cand)
    return Path("/usr/sbin/lsof")


def _inspect_opencode_holders(
    home_dir: Path,
    service_files: list[Path],
    *,
    lsof_bin: Path | None = None,
) -> tuple[bool, set[int]]:
    holders: set[int] = set()
    svc_classify_ok = True
    for svc_file in service_files:
        rec_ok, svc_pid, svc_port, expected_lstart, launcher_bound = _parse_legacy_service_record(
            svc_file, home_dir
        )
        if not rec_ok:
            svc_classify_ok = False
            continue
        if svc_pid is not None and svc_pid > 1:
            svc_state, _ = _classify_legacy_service_pid(
                svc_pid,
                svc_port,
                home_dir,
                expected_lstart=expected_lstart,
                launcher_bound=launcher_bound,
                lsof_bin=lsof_bin,
            )
            if svc_state == "matched":
                holders.add(svc_pid)
            elif svc_state == "unavailable":
                svc_classify_ok = False

    eff_lsof = lsof_bin if lsof_bin is not None else _resolve_default_lsof_bin()
    if not eff_lsof.is_file():
        return False, holders

    guarded_prefixes: list[str] = []
    for sub in (
        home_dir / ".local" / "share" / "opencode",
        home_dir / ".local" / "state" / "opencode",
        home_dir / ".config" / "opencode",
        home_dir / ".configs",
    ):
        for var in _dual_realpath_variants(sub):
            if var not in guarded_prefixes:
                guarded_prefixes.append(var)

    proc: subprocess.CompletedProcess[str] | None = None
    for attempt in range(3):
        try:
            proc = subprocess.run(
                [str(eff_lsof), "-n", "-P", "-u", str(os.getuid()), "-Fn"],
                capture_output=True,
                text=True,
                timeout=8,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            proc = None
        if proc is not None and proc.returncode == 0 and (proc.stdout or "").strip():
            break
        if attempt < 2:
            time.sleep(0.1)

    if proc is None or proc.returncode != 0 or not (proc.stdout or "").strip():
        return False, holders

    my_pid = os.getpid()
    cur_pid: int | None = None
    for raw_line in proc.stdout.splitlines():
        if not raw_line:
            continue
        tag = raw_line[0]
        val = raw_line[1:]
        if tag == "p":
            cur_pid = int(val) if val.isdigit() else None
        elif tag == "n" and cur_pid is not None and cur_pid > 1 and cur_pid != my_pid:
            for pref in guarded_prefixes:
                if val == pref or val.startswith(pref + "/"):
                    holders.add(cur_pid)
                    break

    return svc_classify_ok, holders


def inspect_containment_state(
    *,
    home_dir: Path,
    runs_dir: Path,
    evidence_path: Path,
    incident_id: str = DEFAULT_INCIDENT_ID,
    target_model_id: str | None = None,
    extra_needles: list[str] | None = None,
    prior_exposed_tokens: list[str] | None = None,
    lsof_bin: Path | None = None,
    require_db_event_binding: bool = True,
) -> dict[str, Any]:
    schema_ok, integrity_ok, evidence_obj, dirty_unverified, _ = _validate_evidence_snapshot(
        evidence_path,
        home_dir=home_dir,
        expected_incident_id=incident_id,
        require_db_event_binding=require_db_event_binding,
    )
    service_files, svc_scan_ok = _find_legacy_service_files(home_dir)
    needles, needle_scan_ok = _collect_in_memory_needles(home_dir, runs_dir, service_files)
    if extra_needles:
        for n in extra_needles:
            if n not in needles:
                needles.append(n)

    classified = _classify_active_models(
        runs_dir=runs_dir,
        home_dir=home_dir,
        service_files=service_files,
        evidence_obj=evidence_obj,
        target_model_id=target_model_id,
        prior_exposed_tokens=prior_exposed_tokens,
    )
    affected_proxies = classified["affected_proxies"]
    unrelated_proxies = classified["unrelated_proxies"]
    unrelated_local = classified["unrelated_local"]
    ambiguous_proxies = classified["ambiguous_proxies"]
    runs_inspection_ok = bool(classified["runs_inspection_ok"])

    holder_ok, holders = _inspect_opencode_holders(
        home_dir, service_files, lsof_bin=lsof_bin
    )

    share_opencode = home_dir / ".local" / "share" / "opencode"
    db_path = share_opencode / "opencode.db"
    db_st, db_meta_ok = _lstat_strict(db_path)
    db_present = db_st is not None
    wal_or_journal = False
    wal_meta_ok = True
    for name in ("opencode.db-wal", "opencode.db-journal", "opencode.db-shm"):
        wst, w_ok = _lstat_strict(share_opencode / name)
        if not w_ok:
            wal_meta_ok = False
        elif wst is not None:
            wal_or_journal = True
    db_matches, db_scan_ok = _scan_db_matching_records(db_path, needles)
    log_matches, log_scan_ok = _scan_log_matching_lines(share_opencode / "log", needles)
    spool_matches, spool_scan_ok = _scan_shell_spool_matching_lines(
        share_opencode / "shell", needles
    )
    cfg_matches, legacy_cfg_count, cfg_scan_ok = _scan_config_sinks(
        home_dir, service_files, needles
    )
    _, tok_extract_ok = _extract_persisted_session_tokens_in_memory(home_dir)
    sink_inspection_ok = (
        svc_scan_ok
        and needle_scan_ok
        and runs_inspection_ok
        and db_meta_ok
        and wal_meta_ok
        and db_scan_ok
        and log_scan_ok
        and spool_scan_ok
        and cfg_scan_ok
        and tok_extract_ok
    )

    return {
        "evidence_schema_valid": bool(schema_ok),
        "evidence_integrity_valid": bool(integrity_ok),
        "evidence_snapshot_valid": bool(schema_ok and integrity_ok),
        "dirty_unverified_sources": int(dirty_unverified),
        "affected_proxy_sessions": len(affected_proxies),
        "ambiguous_proxy_sessions": len(ambiguous_proxies),
        "unrelated_active_models": len(unrelated_proxies) + len(unrelated_local),
        "active_proxy_sessions": len(affected_proxies) + len(unrelated_proxies),
        "legacy_service_files_present": len(service_files) > 0,
        "legacy_config_files_present": int(legacy_cfg_count),
        "config_matching_files": int(cfg_matches),
        "holder_inspection_ok": bool(holder_ok),
        "active_opencode_holders": len(holders),
        "sink_inspection_ok": bool(sink_inspection_ok),
        "db_present": bool(db_present),
        "db_matching_records": int(db_matches),
        "wal_or_journal_present": bool(wal_or_journal),
        "log_matching_lines": int(log_matches),
        "shell_spool_matching_lines": int(spool_matches),
    }


def _terminate_pid_with_lstart(
    pid: int, expected_lstart: str, *, grace_seconds: float = 2.0
) -> bool:
    if pid <= 1 or not expected_lstart or not expected_lstart.strip():
        return False
    clean_expected = expected_lstart.strip()
    pre_state = classify_pid_identity(pid, clean_expected)
    if pre_state in ("dead", "reused"):
        return True
    if pre_state != "matched":
        return False

    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    except OSError:
        return classify_pid_identity(pid, clean_expected) in ("dead", "reused")

    deadline = time.monotonic() + grace_seconds
    while time.monotonic() < deadline:
        st = classify_pid_identity(pid, clean_expected)
        if st in ("dead", "reused"):
            return True
        if st == "unavailable":
            return False
        time.sleep(0.04)

    kill_check = classify_pid_identity(pid, clean_expected)
    if kill_check in ("dead", "reused"):
        return True
    if kill_check != "matched":
        return False

    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    except OSError:
        return classify_pid_identity(pid, clean_expected) in ("dead", "reused")

    kill_deadline = time.monotonic() + 1.0
    while time.monotonic() < kill_deadline:
        st_post = classify_pid_identity(pid, clean_expected)
        if st_post in ("dead", "reused"):
            return True
        if st_post == "unavailable":
            return False
        time.sleep(0.04)
    return classify_pid_identity(pid, clean_expected) in ("dead", "reused")


def _unlink_target(path: Path) -> tuple[bool, bool]:
    """Unlink path and return (removed, failed)."""
    st, meta_ok = _lstat_strict(path)
    if not meta_ok:
        return False, True
    if st is None:
        return False, False

    try:
        if not stat.S_ISLNK(st.st_mode):
            try:
                os.chmod(path, 0o600)
            except OSError:
                pass
        path.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        return False, True

    post_st, post_meta_ok = _lstat_strict(path)
    if not post_meta_ok or post_st is not None:
        return False, True
    return True, False


def _stop_single_affected_proxy(
    sess: dict[str, Any],
    *,
    runs_dir: Path,
    stop_model_fn: Callable[[dict[str, Any]], bool] | None = None,
) -> bool:
    if stop_model_fn is not None:
        return bool(stop_model_fn(sess))

    try:
        is_default_runs = runs_dir.resolve() == (ROOT / "runs").resolve()
    except OSError:
        is_default_runs = False

    mid = str(sess.get("model_id") or "").strip()
    pid = int(sess.get("pid") or 0)
    lstart = sess.get("pid_lstart")
    up_pid = int(sess.get("upstream_pid") or 0)
    up_lstart = sess.get("upstream_pid_lstart")
    if not mid:
        return False
    if pid <= 1 and up_pid <= 1:
        return False

    if is_default_runs:
        if pid > 1:
            if not isinstance(lstart, str) or classify_pid_identity(pid, lstart) not in (
                "matched",
                "dead",
                "reused",
            ):
                return False
        stop_script = str(ROOT / "scripts" / "stop-model")
        res = subprocess.run(
            [stop_script, mid],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
        return res.returncode == 0

    if pid > 1:
        if not isinstance(lstart, str) or not _terminate_pid_with_lstart(pid, lstart):
            return False
    if up_pid > 1 and up_pid != pid:
        if not isinstance(up_lstart, str) or not _terminate_pid_with_lstart(up_pid, up_lstart):
            return False

    unlink_ok = True
    pid_file = sess.get("pid_file")
    tok_file = sess.get("token_file")
    if isinstance(pid_file, Path):
        _, failed = _unlink_target(pid_file)
        if failed:
            unlink_ok = False
    if isinstance(tok_file, Path):
        _, failed = _unlink_target(tok_file)
        if failed:
            unlink_ok = False
    derived_tok = session_token_file_for_model(mid, runs_dir)
    if derived_tok != tok_file:
        try:
            if not derived_tok.is_symlink() and derived_tok.resolve().parent == runs_dir.resolve():
                _, failed = _unlink_target(derived_tok)
                if failed:
                    unlink_ok = False
        except OSError:
            unlink_ok = False
    return unlink_ok


def apply_containment(
    *,
    home_dir: Path,
    runs_dir: Path,
    evidence_path: Path,
    incident_id: str = DEFAULT_INCIDENT_ID,
    target_model_id: str | None = None,
    lsof_bin: Path | None = None,
    stop_model_fn: Callable[[dict[str, Any]], bool] | None = None,
) -> tuple[int, dict[str, Any] | None, str | None]:
    schema_ok, integrity_ok, evidence_obj, _, evidence_sha256 = _validate_evidence_snapshot(
        evidence_path,
        home_dir=home_dir,
        expected_incident_id=incident_id,
        require_db_event_binding=True,
    )
    if not schema_ok or not integrity_ok or evidence_obj is None:
        reason = "schema validation" if not schema_ok else "cryptographic integrity / target binding"
        return (
            1,
            None,
            f"Refusing --apply: evidence snapshot '{evidence_path}' failed {reason}.",
        )

    service_files, svc_scan_ok = _find_legacy_service_files(home_dir)
    persisted_tokens, tok_extract_ok = _extract_persisted_session_tokens_in_memory(home_dir)
    pre_needles, needle_scan_ok = _collect_in_memory_needles(home_dir, runs_dir, service_files)
    if not svc_scan_ok or not tok_extract_ok or not needle_scan_ok:
        return (
            1,
            None,
            f"Refusing --apply: sink or runs inspection under '{home_dir}' / '{runs_dir}' failed (unreadable or corrupt state).",
        )
    for ptok in persisted_tokens:
        for v in _secret_variants_in_memory(ptok):
            if v not in pre_needles:
                pre_needles.append(v)

    classified = _classify_active_models(
        runs_dir=runs_dir,
        home_dir=home_dir,
        service_files=service_files,
        evidence_obj=evidence_obj,
        target_model_id=target_model_id,
    )
    if not classified.get("runs_inspection_ok", False):
        return (
            1,
            None,
            f"Refusing --apply: runs directory inspection under '{runs_dir}' failed (unreadable or corrupt PID record).",
        )
    ambiguous_proxies = classified["ambiguous_proxies"]
    affected_proxies = classified["affected_proxies"]
    unrelated_proxies = classified["unrelated_proxies"]

    try:
        home_resolved = home_dir.expanduser().resolve()
    except OSError:
        return (
            1,
            None,
            f"Refusing --apply: could not resolve target home '{home_dir}'.",
        )
    is_provenance = (
        isinstance(evidence_obj.get("tracking_id"), str)
        and isinstance(evidence_obj.get("session_id"), str)
        and isinstance(evidence_obj.get("events"), list)
        and isinstance(evidence_obj.get("source_sha256"), dict)
    )
    receipt_session_id = str(evidence_obj["session_id"]) if is_provenance else None
    receipt_events = list(evidence_obj["events"]) if is_provenance else None
    prior_verified_receipt = _read_verified_containment_receipt(
        evidence_path=evidence_path,
        evidence_sha256=evidence_sha256,
        home_resolved=home_resolved,
        expected_incident_id=incident_id,
        session_id=receipt_session_id,
        events=receipt_events,
    )
    prior_revoked_models = (
        {
            str(m).strip()
            for m in prior_verified_receipt.get("revoked_target_models", [])
            if isinstance(m, str) and m.strip()
        }
        if prior_verified_receipt is not None
        else set()
    )

    if ambiguous_proxies:
        return (
            1,
            None,
            f"Refusing --apply: {len(ambiguous_proxies)} candidate proxy session(s) have ambiguous or unverified PID/lstart identity.",
        )
    if target_model_id and not affected_proxies and target_model_id not in prior_revoked_models:
        return (
            1,
            None,
            f"Refusing --apply: explicit --target-model '{target_model_id}' did not match an active verified proxy session.",
        )

    # Step 1: Stop ONLY affected proxy sessions and verify revocation without untrusted port replay (F6, F11, F12).
    verified_proxy_ports = {
        int(e.get("port") or 0)
        for e in unrelated_proxies
        if e.get("identity_state") == "matched" and int(e.get("port") or 0) > 0
    }
    proxy_stopped = 0
    accounted_stopped_tokens: set[str] = set()
    newly_revoked_models: set[str] = set()
    for sess in affected_proxies:
        stopped_ok = _stop_single_affected_proxy(
            sess, runs_dir=runs_dir, stop_model_fn=stop_model_fn
        )
        if not stopped_ok:
            return (
                1,
                None,
                f"Refusing to delete forensic state: failed to stop affected proxy session '{sess.get('model_id')}'.",
            )
        pid = int(sess.get("pid") or 0)
        lstart = str(sess.get("pid_lstart") or "")
        pid_state = (
            classify_pid_identity(pid, lstart)
            if (pid > 1 and lstart)
            else ("unavailable" if pid > 1 else "dead")
        )
        up_pid = int(sess.get("upstream_pid") or 0)
        up_lstart = str(sess.get("upstream_pid_lstart") or "")
        up_state = (
            classify_pid_identity(up_pid, up_lstart)
            if (up_pid > 1 and up_lstart)
            else ("unavailable" if up_pid > 1 else "dead")
        )
        still_same_proc = pid_state not in ("dead", "reused") or (
            stop_model_fn is None and up_state not in ("dead", "reused")
        )

        port = int(sess.get("port") or 0)
        tok_val = str(sess.get("token_value") or "").strip() or None
        tcp_state = _probe_tcp_listener_closed(port)
        if tcp_state == "closed":
            probe_state = "revoked"
        elif tcp_state == "unknown":
            probe_state = "unknown"
        elif pid_state == "matched" or port in verified_proxy_ports:
            probe_state = _probe_port_token_revocation(port, tok_val)
        else:
            # Listener is open on port, but no verified se-key-proxy owns it: do not send bearer token.
            probe_state = "unknown"

        if still_same_proc or probe_state != "revoked":
            detail = (
                "credential is still accepted or listener remains active"
                if (still_same_proc or probe_state == "accepted")
                else f"revocation probe returned '{probe_state}' on localhost:{port} (probe={probe_state})"
            )
            return (
                1,
                None,
                f"Refusing to delete forensic state: affected proxy session '{sess.get('model_id')}' {detail}.",
            )
        if tok_val:
            accounted_stopped_tokens.add(tok_val)
        sess_mid = str(sess.get("model_id") or "").strip()
        if sess_mid:
            newly_revoked_models.add(sess_mid)
        proxy_stopped += 1

    unaccounted_tokens = [t for t in persisted_tokens if t not in accounted_stopped_tokens]
    if unaccounted_tokens:
        for up in unrelated_proxies:
            up_tok = str(up.get("token_value") or "").strip()
            if (
                up.get("identity_state") != "matched"
                or not up_tok
                or up_tok in unaccounted_tokens
            ):
                return (
                    1,
                    None,
                    "Refusing to delete forensic state: persisted session credential could not be disambiguated from active proxy sessions.",
                )
        accounted_live_pids = {
            int(up["pid"])
            for up in unrelated_proxies
            if up.get("identity_state") == "matched" and int(up.get("pid") or 0) > 1
        }
        unaccounted_pids, ps_ok = _find_unaccounted_se_key_proxy_pids(
            runs_dir, accounted_live_pids
        )
        if not ps_ok or unaccounted_pids:
            return (
                1,
                None,
                "Refusing to delete forensic state: persisted session credential could not be verified as revoked (unaccounted live se-key-proxy process or failed process inspection).",
            )
    session_revocation_verified = True

    all_revoked_models = sorted(prior_revoked_models | newly_revoked_models)
    if newly_revoked_models and target_model_id:
        # Record verified explicit-target proxy revocation immediately after Step 1 (R3) with
        # db_events_verified_pre_cleanup=False (preserving True only if already set on a prior Step 2.5 run)
        # so an identical --target-model retry can resume after a Step 2/Step 3 abort without weakening F7.
        _write_containment_receipt(
            evidence_path=evidence_path,
            evidence_sha256=evidence_sha256,
            home_resolved=home_resolved,
            incident_id=incident_id,
            session_id=receipt_session_id,
            events=receipt_events,
            db_events_verified_pre_cleanup=False,
            revoked_target_models=all_revoked_models,
            state="in_progress",
        )

    # Step 2: Stop positively owned legacy OpenCode service PIDs with start-time recheck (F1, ISO-P1, ISO-P2, R1).
    services_stopped = 0
    for svc_file in service_files:
        rec_ok, svc_pid, svc_port, expected_lstart, launcher_bound = _parse_legacy_service_record(
            svc_file, home_dir
        )
        if not rec_ok:
            return (
                1,
                None,
                f"Refusing to delete SQLite/log state under '{home_dir}': unreadable, malformed, or conflicting legacy service record '{svc_file}'.",
            )

        if svc_pid is not None and svc_pid > 1 and pid_is_alive(svc_pid) and not pid_is_zombie(svc_pid):
            svc_state, svc_lstart = _classify_legacy_service_pid(
                svc_pid,
                svc_port,
                home_dir,
                expected_lstart=expected_lstart,
                launcher_bound=launcher_bound,
                lsof_bin=lsof_bin,
            )
            if svc_state == "unavailable":
                return (
                    1,
                    None,
                    f"Refusing to delete SQLite/log state under '{home_dir}': could not verify identity of legacy OpenCode service PID {svc_pid}.",
                )
            if svc_state == "matched":
                assert svc_lstart is not None
                if not _terminate_pid_with_lstart(svc_pid, svc_lstart):
                    return (
                        1,
                        None,
                        f"Refusing to delete SQLite/log state under '{home_dir}': failed to terminate legacy OpenCode service PID {svc_pid}.",
                    )
                services_stopped += 1

    holder_ok, remaining_holders = _inspect_opencode_holders(
        home_dir, service_files, lsof_bin=lsof_bin
    )
    if not holder_ok:
        return (
            1,
            None,
            f"Refusing to delete SQLite/log state under '{home_dir}': open-file holder inspection failed or lsof is unavailable.",
        )
    if remaining_holders:
        return (
            1,
            None,
            f"Refusing to delete SQLite/log state under '{home_dir}': {len(remaining_holders)} active process(es) still hold open files.",
        )

    # Step 2.5 (F7, R3): Persist value-free pre-cleanup receipt before unlinking opencode.db.
    if is_provenance or all_revoked_models:
        wrote_receipt = _write_containment_receipt(
            evidence_path=evidence_path,
            evidence_sha256=evidence_sha256,
            home_resolved=home_resolved,
            incident_id=incident_id,
            session_id=receipt_session_id,
            events=receipt_events,
            db_events_verified_pre_cleanup=bool(is_provenance),
            revoked_target_models=all_revoked_models,
            state="in_progress",
        )
        if not wrote_receipt and (is_provenance or bool(all_revoked_models)):
            return (
                1,
                None,
                f"Refusing to delete SQLite/log state under '{home_dir}': failed to persist pre-cleanup binding receipt next to '{evidence_path}'.",
            )

    # Step 3 (F5): Remove legacy service/config/log/spool records first, then SQLite DB + WAL/SHM/journal,
    # tracking every unlink failure explicitly.
    files_removed = 0
    unlink_failures = 0

    def _remove_one(target: Path) -> None:
        nonlocal files_removed, unlink_failures
        removed, failed = _unlink_target(target)
        if removed:
            files_removed += 1
        if failed:
            unlink_failures += 1

    for svc_file in service_files:
        _remove_one(svc_file)

    for sc_dir in (
        home_dir,
        home_dir / ".local" / "state" / "opencode",
        home_dir / ".local" / "share" / "opencode",
        home_dir / ".config" / "opencode",
    ):
        for sc_name in ("service-identity.json", ".service-identity.json"):
            _remove_one(sc_dir / sc_name)

    configs_dir = home_dir / ".configs"
    cfg_targets, cfg_list_ok = _scandir_matching_files(
        configs_dir,
        lambda name: name.startswith("opencode-") and name.endswith(".json"),
    )
    if not cfg_list_ok:
        unlink_failures += 1
    for cfg_file in cfg_targets:
        _remove_one(cfg_file)

    for legacy_top in (
        home_dir / "opencode.json",
        home_dir / ".last-service-sync.json",
        home_dir / ".active-opencode-clients.json",
    ):
        _remove_one(legacy_top)

    share_opencode = home_dir / ".local" / "share" / "opencode"
    log_targets, log_list_ok = _scandir_matching_files(
        share_opencode / "log", lambda name: name.startswith("opencode.log")
    )
    if not log_list_ok:
        unlink_failures += 1
    for log_file in log_targets:
        _remove_one(log_file)

    spool_targets, spool_list_ok = _walk_matching_files_strict(
        share_opencode / "shell", lambda name: name.endswith(".out")
    )
    if not spool_list_ok:
        unlink_failures += 1
    for spool_file in spool_targets:
        _remove_one(spool_file)

    for db_artifact in (
        share_opencode / "opencode.db",
        share_opencode / "opencode.db-wal",
        share_opencode / "opencode.db-shm",
        share_opencode / "opencode.db-journal",
    ):
        _remove_one(db_artifact)

    post = inspect_containment_state(
        home_dir=home_dir,
        runs_dir=runs_dir,
        evidence_path=evidence_path,
        incident_id=incident_id,
        target_model_id=target_model_id,
        extra_needles=pre_needles,
        prior_exposed_tokens=unaccounted_tokens,
        lsof_bin=lsof_bin,
    )
    clean = (
        unlink_failures == 0
        and post["evidence_schema_valid"] is True
        and post["evidence_integrity_valid"] is True
        and post["affected_proxy_sessions"] == 0
        and post["ambiguous_proxy_sessions"] == 0
        and session_revocation_verified is True
        and post["holder_inspection_ok"] is True
        and post["active_opencode_holders"] == 0
        and post["sink_inspection_ok"] is True
        and post["legacy_service_files_present"] is False
        and post["legacy_config_files_present"] == 0
        and post["config_matching_files"] == 0
        and post["db_present"] is False
        and post["db_matching_records"] == 0
        and post["wal_or_journal_present"] is False
        and post["log_matching_lines"] == 0
        and post["shell_spool_matching_lines"] == 0
    )
    if clean and (is_provenance or all_revoked_models):
        if not _write_containment_receipt(
            evidence_path=evidence_path,
            evidence_sha256=evidence_sha256,
            home_resolved=home_resolved,
            incident_id=incident_id,
            session_id=receipt_session_id,
            events=receipt_events,
            db_events_verified_pre_cleanup=bool(is_provenance),
            revoked_target_models=all_revoked_models,
            state="completed",
        ):
            if is_provenance:
                clean = False

    report = {
        "mode": "apply",
        **post,
        "session_revocation_verified": bool(session_revocation_verified),
        "proxy_sessions_stopped": int(proxy_stopped),
        "legacy_services_stopped": int(services_stopped),
        "files_removed": int(files_removed),
        "unlink_failures": int(unlink_failures),
        "containment_clean": bool(clean),
    }
    return (0 if clean else 1), report, None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Read-only checker and operator-approved containment cleanup for OpenCode "
            "session credential isolation (SESSION-CREDENTIAL-001). Emits booleans and counts only."
        )
    )
    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        "--check",
        action="store_true",
        default=False,
        help="Strictly read-only containment inspection (default).",
    )
    mode_group.add_argument(
        "--apply",
        action="store_true",
        default=False,
        help="Execute containment cleanup (requires --operator-approved and a valid evidence snapshot).",
    )
    parser.add_argument(
        "--operator-approved",
        action="store_true",
        default=False,
        help="Confirm explicit operator approval for --apply.",
    )
    parser.add_argument(
        "--home",
        type=Path,
        default=DEFAULT_HOME,
        help=f"OpenCode isolated home to inspect/clean (default: {DEFAULT_HOME}).",
    )
    parser.add_argument(
        "--runs-dir",
        type=Path,
        default=None,
        help="Runs directory containing .serve*.pid and .se-session-*.token files.",
    )
    parser.add_argument(
        "--evidence-path",
        type=Path,
        default=DEFAULT_EVIDENCE_PATH,
        help=f"Operator-supplied sanitized incident evidence JSON path (default: {DEFAULT_EVIDENCE_PATH}).",
    )
    parser.add_argument(
        "--incident-id",
        default=DEFAULT_INCIDENT_ID,
        help=f"Expected incident/tracking ID bound to --evidence-path (default: {DEFAULT_INCIDENT_ID}).",
    )
    parser.add_argument(
        "--target-model",
        default=None,
        help="Optional explicit affected proxy model_id to invalidate during --apply.",
    )

    args = parser.parse_args(argv[1:] if argv is not None else sys.argv[1:])
    home_dir = args.home.expanduser()
    runs_dir = args.runs_dir.expanduser() if args.runs_dir is not None else _effective_runs_dir()
    evidence_path = args.evidence_path.expanduser()

    if args.apply:
        if not args.operator_approved:
            print(
                "Refusing --apply without --operator-approved. Run with '--check' first, "
                "then pass '--apply --operator-approved' after operator approval.",
                file=sys.stderr,
            )
            return 1
        rc, report, err_msg = apply_containment(
            home_dir=home_dir,
            runs_dir=runs_dir,
            evidence_path=evidence_path,
            incident_id=str(args.incident_id),
            target_model_id=args.target_model,
        )
        if err_msg:
            print(err_msg, file=sys.stderr)
            return rc
        print(json.dumps(report, indent=2, sort_keys=True))
        return rc

    report = {
        "mode": "check",
        **inspect_containment_state(
            home_dir=home_dir,
            runs_dir=runs_dir,
            evidence_path=evidence_path,
            incident_id=str(args.incident_id),
            target_model_id=args.target_model,
        ),
    }
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
